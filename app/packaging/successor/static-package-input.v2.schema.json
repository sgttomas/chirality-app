{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:static-package-input.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "candidate",
    "build_selection",
    "s1_package",
    "legacy_package",
    "terms",
    "installer"
  ],
  "properties": {
    "format": {
      "const": "static-package-input/2"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "build_identity",
        "codex_pin",
        "package_record_id"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "build_identity": {
          "type": "string",
          "minLength": 1
        },
        "codex_pin": {
          "type": "string",
          "minLength": 1
        },
        "package_record_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "build_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "s1_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "legacy_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "installer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
