{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:app-v4:del-01-04:aac:offer:0.3",
  "title": "App act control offer (PROPOSED, DEL-01-04/AAC-v0.2 §5.1; schema 0.3 at RV21)",
  "description": "PROPOSED by DEL-01-04/AAC-v0.2 (R17-1, R17-6); the act control is PROPOSED until SCA-V4-003 carries SC2-01-04-1 as amended (SC3-01-04-1). One offer presents one act kind (EXEC CAP-2). For A4, A6, A7 it presents one subject whose content identity is fixed when the offer is composed. For A15 it is composed from exactly one of DEL-02-02's descriptors (R21-3): an `a15_descriptor` (WR RB-4; one reviewed draft, wording 'register workflow revision') or an `a15_multi_descriptor` (WR §4.7 ME-3; DECISION-L L-4: several library entries registered in place in one act, wording 'register workflow revisions'); the entries are listed inside the one descriptor, each with its own bound bytes (K-8), and the person's confirmation is accepted only while every entry still has those bytes and the descriptor is current. Each entry names its subject by the reviewed content (WR ID-3 string, 'draft:' or 'entry:', and content identity) and the prior revision (RS workflowTuple or null), the persisted form R18-1 C-01 gives RS; 'derived-from' stays WD's parent-workflow relation and is not carried. The offer is composed on the capture side from authoritative sources, never from agent text (R17-5, PROPOSED). Wording follows ACT §9 and WR (plural for L-4). Decline only where ACT §2.3 defines an act-declined event. Schema 0.3 (RV21; R21-3): one descriptor per act, 'entry:' accepted, the plural wording; 0.2 had one descriptor per entry. AAC-v0.3 rows (pass 4, R23-18; run APP-V4-DESIGN-PASS-4-20261003, owner O-A): A16 'decide' on one decision package, with its alternatives and their consequences shown; additive, taken in place in schema 0.3 as the RV21 changes were.",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "offerId",
    "actKind",
    "wording",
    "scope",
    "purpose",
    "actorRequirement",
    "declineAvailable",
    "answers",
    "composedAt",
    "offerDigest"
  ],
  "additionalProperties": false,
  "$defs": {
    "contentIdentity": {
      "type": "object",
      "required": [
        "method",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workflowTuple": {
      "description": "RS $defs/workflowTuple (RS-v0.9; WD §6.1 identity tuple in RS's spelling), copied here so the schema stands alone; C-01 makes RS's the persisted form.",
      "type": "object",
      "required": [
        "kind",
        "origin",
        "sourceRoot",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "workflow"
        },
        "origin": {
          "enum": [
            "project",
            "user",
            "bundled",
            "host"
          ]
        },
        "sourceRoot": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "revisionMethod": {
          "type": "string",
          "minLength": 1
        },
        "derivedFrom": {
          "$ref": "#/$defs/workflowTuple"
        }
      }
    },
    "reviewedDraft": {
      "type": "object",
      "required": [
        "draft",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "draft": {
          "type": "string",
          "pattern": "^(draft|entry):(project|user):[^@]+@.+$",
          "description": "WR ID-3 string (C-01): 'draft:<location>:<name>@<content identity>' for a reviewed draft (WR `a15_descriptor`), or 'entry:<location>:<name>@<content identity>' for a library entry reviewed in place (WR `a15_multi_descriptor`, §4.7; L-4); RS-v0.9's pattern (R21-3)."
        },
        "content": {
          "$ref": "#/$defs/contentIdentity"
        }
      }
    },
    "priorRevision": {
      "anyOf": [
        {
          "$ref": "#/$defs/workflowTuple"
        },
        {
          "type": "null"
        }
      ],
      "description": "The revision this one follows (K-6) as an RS workflowTuple, or null for a first revision (C-01)."
    }
  },
  "properties": {
    "format": {
      "const": "chirality.aac.offer"
    },
    "formatVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "offerId": {
      "type": "string",
      "pattern": "^offer:"
    },
    "actKind": {
      "enum": [
        "A4",
        "A6",
        "A7",
        "A15",
        "A16"
      ]
    },
    "wording": {
      "enum": [
        "mark checked",
        "approve (engineering approval)",
        "rely (professional reliance)",
        "register workflow revision",
        "register workflow revisions",
        "decide"
      ]
    },
    "subject": {
      "type": "object",
      "required": [
        "class",
        "ref",
        "contentIdentity"
      ],
      "additionalProperties": false,
      "properties": {
        "class": {
          "const": "App file"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "contentIdentity": {
          "$ref": "#/$defs/contentIdentity"
        }
      }
    },
    "descriptorId": {
      "type": "string",
      "minLength": 1,
      "description": "The identity of the one DEL-02-02 descriptor this A15 act is composed from (R21-3; WR `descriptor_id`)."
    },
    "descriptorKind": {
      "enum": [
        "a15_descriptor",
        "a15_multi_descriptor"
      ],
      "description": "The kind of DEL-02-02's descriptor the A15 act is composed from: one descriptor per act (R21-3). 'a15_descriptor' (WR RB-4): one reviewed draft, one entry. 'a15_multi_descriptor' (WR §4.7 ME-3): two or more library entries registered in place, in one act."
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "subject",
          "reviewedDraft",
          "priorRevision"
        ],
        "additionalProperties": false,
        "properties": {
          "subject": {
            "type": "object",
            "required": [
              "ref",
              "contentIdentity"
            ],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "description": "The target revision the descriptor names for this entry."
              },
              "contentIdentity": {
                "$ref": "#/$defs/contentIdentity"
              }
            }
          },
          "reviewedDraft": {
            "$ref": "#/$defs/reviewedDraft"
          },
          "priorRevision": {
            "$ref": "#/$defs/priorRevision"
          }
        }
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "A16 CC-A / CI-4 (owner-selected explicit absence label): nonempty package scope copied unchanged; absent or empty package scope represented exactly as \"not named by the package\", never inferred. Offer/native confirmation/capture/RS copy the same wording. Non-string package scope is invalid, not absent. Other act kinds retain their own authoritative scope rules."
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "actorRequirement": {
      "type": "string",
      "minLength": 1
    },
    "declineAvailable": {
      "type": "boolean"
    },
    "answers": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "arrival",
            "runId"
          ],
          "additionalProperties": false,
          "properties": {
            "arrival": {
              "type": "object",
              "required": [
                "checkpoint",
                "arrivalOrdinal"
              ],
              "additionalProperties": false,
              "properties": {
                "checkpoint": {
                  "type": "string",
                  "minLength": 1
                },
                "arrivalOrdinal": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "runId": {
              "type": "string",
              "pattern": "^run:"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "standing"
          ],
          "additionalProperties": false,
          "properties": {
            "standing": {
              "const": "no arrival: a standing act (RC-6)"
            }
          }
        }
      ]
    },
    "requestRef": {
      "type": "string",
      "pattern": "^rec:"
    },
    "composedAt": {
      "type": "string",
      "minLength": 1
    },
    "offerDigest": {
      "$ref": "#/$defs/contentIdentity"
    },
    "alternatives": {
      "description": "A16 (R23-8): the package's alternatives as shown, each with its consequences.",
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "consequences"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "consequences": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "properties": {
            "actKind": {
              "not": {
                "const": "A4"
              }
            }
          }
        },
        {
          "required": [
            "subject"
          ],
          "properties": {
            "wording": {
              "const": "mark checked"
            },
            "declineAvailable": {
              "const": true
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "properties": {
            "actKind": {
              "not": {
                "const": "A6"
              }
            }
          }
        },
        {
          "required": [
            "subject"
          ],
          "properties": {
            "wording": {
              "const": "approve (engineering approval)"
            },
            "declineAvailable": {
              "const": true
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "properties": {
            "actKind": {
              "not": {
                "const": "A7"
              }
            }
          }
        },
        {
          "required": [
            "subject"
          ],
          "properties": {
            "wording": {
              "const": "rely (professional reliance)"
            },
            "declineAvailable": {
              "const": true
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "properties": {
            "actKind": {
              "not": {
                "const": "A15"
              }
            }
          }
        },
        {
          "required": [
            "descriptorId",
            "descriptorKind",
            "entries"
          ],
          "not": {
            "required": [
              "subject"
            ]
          },
          "properties": {
            "wording": {
              "enum": [
                "register workflow revision",
                "register workflow revisions"
              ]
            },
            "declineAvailable": {
              "const": false
            }
          }
        }
      ]
    },
    {
      "description": "Entries and the descriptor belong to A15 only.",
      "anyOf": [
        {
          "properties": {
            "actKind": {
              "const": "A15"
            }
          }
        },
        {
          "allOf": [
            {
              "not": {
                "required": [
                  "entries"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "descriptorId"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "descriptorKind"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "description": "The plural wording is A15's over several library entries only.",
      "anyOf": [
        {
          "properties": {
            "wording": {
              "not": {
                "const": "register workflow revisions"
              }
            }
          }
        },
        {
          "required": [
            "descriptorKind"
          ],
          "properties": {
            "descriptorKind": {
              "const": "a15_multi_descriptor"
            }
          }
        }
      ]
    },
    {
      "description": "An a15_descriptor (WR RB-4): exactly one entry, a reviewed draft ('draft:' form); wording 'register workflow revision'.",
      "anyOf": [
        {
          "not": {
            "required": [
              "descriptorKind"
            ],
            "properties": {
              "descriptorKind": {
                "const": "a15_descriptor"
              }
            }
          }
        },
        {
          "properties": {
            "entries": {
              "not": {
                "type": "array",
                "minItems": 2
              },
              "items": {
                "properties": {
                  "reviewedDraft": {
                    "properties": {
                      "draft": {
                        "pattern": "^draft:"
                      }
                    }
                  }
                }
              }
            },
            "wording": {
              "const": "register workflow revision"
            }
          }
        }
      ]
    },
    {
      "description": "An a15_multi_descriptor (WR §4.7 ME-3; L-4): two or more library entries reviewed in place ('entry:' form), none with a prior revision; wording 'register workflow revisions'.",
      "anyOf": [
        {
          "not": {
            "required": [
              "descriptorKind"
            ],
            "properties": {
              "descriptorKind": {
                "const": "a15_multi_descriptor"
              }
            }
          }
        },
        {
          "properties": {
            "entries": {
              "minItems": 2,
              "items": {
                "properties": {
                  "reviewedDraft": {
                    "properties": {
                      "draft": {
                        "pattern": "^entry:"
                      }
                    }
                  },
                  "priorRevision": {
                    "type": "null"
                  }
                }
              }
            },
            "wording": {
              "const": "register workflow revisions"
            }
          }
        }
      ]
    },
    {
      "description": "A16 (R23-8): one package as subject, its request, its alternatives; wording 'decide'; no decline. Alternatives belong to A16 only.",
      "allOf": [
        {
          "anyOf": [
            {
              "properties": {
                "actKind": {
                  "not": {
                    "const": "A16"
                  }
                }
              }
            },
            {
              "required": [
                "subject",
                "requestRef",
                "alternatives"
              ],
              "properties": {
                "wording": {
                  "const": "decide"
                },
                "declineAvailable": {
                  "const": false
                }
              }
            }
          ]
        },
        {
          "anyOf": [
            {
              "properties": {
                "actKind": {
                  "const": "A16"
                }
              }
            },
            {
              "not": {
                "required": [
                  "alternatives"
                ]
              }
            }
          ]
        },
        {
          "anyOf": [
            {
              "properties": {
                "wording": {
                  "not": {
                    "const": "decide"
                  }
                }
              }
            },
            {
              "properties": {
                "actKind": {
                  "const": "A16"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
