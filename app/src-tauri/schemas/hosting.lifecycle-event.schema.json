{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:del-01-01:hosting-boundary:v0.9:lifecycle-event",
  "title": "Supplier child lifecycle event (PROPOSED)",
  "description": "PROPOSED by DEL-01-01/HOSTING-BOUNDARY-v0.8 §4.6-§4.7 (R12-1, R12-2). One record per lifecycle transition of the supplier child. Element names are Chirality's own semantic names; no wire field of the supplier is selected. Placement (library, local implementation or service) is not chosen (R12-2). Representation and persistence stay DEL-01-02's (TBD-002). CC-H proposed candidate (2026-10-04); independent review pending.",
  "type": "object",
  "required": ["recordKind", "sequence", "transitionId", "generation", "fromState", "event", "toState", "at"],
  "additionalProperties": false,
  "properties": {
    "recordKind": {"const": "lifecycle-event"},
    "sequence": {"type": "integer", "minimum": 1, "description": "Order of the event within the App run."},
    "transitionId": {"type": "string", "pattern": "^LT-[0-9]{2}$", "description": "Row of the §4.7 transition table."},
    "generation": {"type": ["object", "null"], "required": ["appSession", "home", "spawnCounter"], "additionalProperties": false, "properties": {"appSession": {"type": "string", "minLength": 1}, "home": {"type": "string", "minLength": 1}, "spawnCounter": {"type": "integer", "minimum": 1}}, "description": "CC-H: full H5 identity. appSession is unique across App launches; home is stable App-owned home identity, not a credential or OS path."},
    "fromState": {"$ref": "#/$defs/state"},
    "event": {"$ref": "#/$defs/event"},
    "toState": {"$ref": "#/$defs/state"},
    "at": {"type": "string", "minLength": 1, "description": "Time of the event; representation unselected."},
    "actor": {"type": "string", "minLength": 1, "description": "Person reference for a start, stop or explicit restart the person asked for; 'app-startup' for an App start."},
    "reason": {"type": "string"},
    "supplierStanding": {"enum": ["verified-pin", "unverified-development"], "description": "CC-H: retained on LT-24 and all events through ready/closure of its generation."},
    "failureCount": {"type": "integer", "minimum": 0, "description": "Failures counted toward the restart bound inside the window, after this event."},
    "verificationResult": {"$ref": "#/$defs/verificationResult"},
    "versionIdentity": {"$ref": "#/$defs/versionIdentity"},
    "declaredCapabilities": {"type": "object", "description": "What the App declared at handshake (native content, unchanged)."},
    "failure": {"type": "string", "description": "What failed, for spawn-failed and handshake-failed: e.g. 'error-response', 'no-response-within-wait-limit', 'child-ended', 'spawn-error'."},
    "exitFacts": {"$ref": "#/$defs/exitFacts"},
    "stopRecord": {"$ref": "#/$defs/stopRecord"},
    "descendants": {"$ref": "#/$defs/descendants"},
    "closedGeneration": {"$ref": "#/$defs/closedGeneration"}
  },
  "allOf": [
    {"if": {"properties": {"event": {"const": "handshake-completed"}}},
     "then": {"required": ["versionIdentity", "declaredCapabilities"], "properties": {"toState": {"const": "ready"}}}},
    {"if": {"properties": {"toState": {"const": "refused"}}},
     "then": {"required": ["verificationResult"], "properties": {"verificationResult": {"properties": {"result": {"enum": ["mismatch", "unverifiable"]}}}}}},
    {"if": {"properties": {"event": {"enum": ["spawn-failed", "handshake-failed"]}}},
     "then": {"required": ["failure", "failureCount"]}},
    {"if": {"properties": {"event": {"const": "child-ended-without-stop-record"}}},
     "then": {"required": ["exitFacts", "closedGeneration"], "properties": {"toState": {"const": "exited-unexpectedly"}}}},
    {"if": {"properties": {"event": {"enum": ["stop-requested", "explicit-restart-requested"]}}},
     "then": {"required": ["actor"]}},
    {"if": {"properties": {"event": {"const": "stop-requested"}}},
     "then": {"required": ["stopRecord"]}},
    {"if": {"properties": {"event": {"const": "tree-ended"}}},
     "then": {"required": ["exitFacts", "descendants", "closedGeneration"], "properties": {"toState": {"const": "stopped"}}}},
    {"if": {"properties": {"transitionId": {"const": "LT-24"}}}, "then": {"required": ["verificationResult", "supplierStanding", "reason"], "properties": {"fromState": {"const": "verifying"}, "event": {"const": "development-start-authorized"}, "toState": {"const": "spawning"}, "supplierStanding": {"const": "unverified-development"}, "reason": {"const": "U-06 development run: unverified distribution, not the pinned supplier"}, "verificationResult": {"properties": {"result": {"const": "unverifiable"}}}}}},
    {"if": {"properties": {"transitionId": {"const": "LT-04"}}}, "then": {"required": ["verificationResult"], "properties": {"verificationResult": {"properties": {"result": {"const": "verified"}}}}}}
  ],
  "$defs": {
    "state": {"enum": ["absent", "verifying", "refused", "spawning", "handshaking", "ready", "exited-unexpectedly", "restart-waiting", "halted-after-repeated-failure", "stopping", "stopped"]},
    "event": {"enum": ["start-requested", "verification-passed", "verification-failed", "spawned", "spawn-failed", "handshake-completed", "handshake-failed", "child-ended-without-stop-record", "exit-recorded", "restart-delay-elapsed", "explicit-restart-requested", "stop-requested", "tree-ended", "development-start-authorized"]},
    "contentIdentity": {
      "type": "object", "required": ["algorithm", "value"], "additionalProperties": false,
      "properties": {"algorithm": {"type": "string", "minLength": 1, "description": "Recorded with each value; the algorithm is unselected (U-08)."}, "value": {"type": "string", "minLength": 1}}
    },
    "verificationResult": {
      "type": "object", "required": ["result"], "additionalProperties": false,
      "properties": {
        "result": {"enum": ["verified", "mismatch", "unverifiable"]},
        "element": {"type": "string", "description": "For mismatch: the element that differs (e.g. 'distribution content identity')."},
        "reason": {"type": "string", "description": "For unverifiable: why."}
      },
      "allOf": [
        {"if": {"properties": {"result": {"const": "mismatch"}}}, "then": {"required": ["element"]}},
        {"if": {"properties": {"result": {"const": "unverifiable"}}}, "then": {"required": ["reason"]}}
      ]
    },
    "versionIdentity": {
      "type": "object",
      "required": ["declaredPin", "observedVersionLabel", "handshakeReportedIdentity", "handshakeConsistency"],
      "additionalProperties": false,
      "properties": {
        "declaredPin": {"type": "string", "minLength": 1},
        "observedVersionLabel": {"type": "string"},
        "distributionContentIdentity": {"type": "array", "items": {"type": "object", "required": ["path", "identity"], "additionalProperties": false, "properties": {"path": {"type": "string"}, "identity": {"$ref": "#/$defs/contentIdentity"}}}},
        "launcherRecord": {"type": "object", "additionalProperties": false, "properties": {"launcher": {"enum": ["wrapper", "vendor-binary", "supplier-double"]}, "addedEnvironment": {"type": "array", "items": {"type": "string"}}}},
        "handshakeReportedIdentity": {"type": "object", "description": "The initialize response elements as observed (native content, unchanged)."},
        "handshakeConsistency": {"enum": ["consistent", "contradicts-declared-pin", "no-version-found"], "description": "The userAgent parse: a consistency check only (§7.2; S-F-01)."},
        "generatedOutputIdentity": {"type": "string"},
        "supplementIdentity": {"type": "string"},
        "configurationIdentity": {"type": "object"}
      }
    },
    "exitFacts": {
      "type": "object", "required": ["exitCode", "signal"], "additionalProperties": false,
      "properties": {
        "exitCode": {"type": ["integer", "null"]},
        "signal": {"type": ["string", "null"]},
        "lastReceiptPosition": {"type": "integer", "minimum": 0},
        "malformedFrameCount": {"type": "integer", "minimum": 0},
        "diagnosticOutputBytes": {"type": "integer", "minimum": 0},
        "forcedAfterGrace": {"type": "boolean"}
      }
    },
    "stopRecord": {
      "type": "object", "required": ["actor", "reason", "outstandingEntryHandling"], "additionalProperties": false,
      "properties": {
        "actor": {"type": "string", "minLength": 1},
        "reason": {"type": "string"},
        "outstandingEntryHandling": {"enum": ["declined-by-app-rule-on-stop", "left-to-end-with-process"], "description": "The two paths of §4.5 step 2; the choice is DEL-01-02's (U-10)."},
        "endingMeans": {"enum": ["close-input", "termination-signal"]}
      }
    },
    "descendants": {
      "type": "object", "required": ["checked", "surviving"], "additionalProperties": false,
      "properties": {
        "checked": {"type": "boolean"},
        "surviving": {"type": "integer", "minimum": 0},
        "handling": {"type": "string", "description": "What was done with survivors (U-16); recorded, never assumed."}
      }
    },
    "closedGeneration": {
      "type": "object", "required": ["unknownNoResponse", "endedUnanswered"], "additionalProperties": false,
      "properties": {
        "unknownNoResponse": {"type": "integer", "minimum": 0, "description": "Client requests of the generation that got outcome unknown-no-response."},
        "endedUnanswered": {"type": "integer", "minimum": 0, "description": "Register entries moved to ended-unanswered(process-exit)."}
      }
    }
  }
}
