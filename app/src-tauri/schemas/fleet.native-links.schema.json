{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:app-v4:del-06-01:fleet-native-links:0.2",
  "title": "Source-qualified native conversation relationship and delegation observations",
  "description": "Native conversation identity is the native thread ID qualified by its stable actual home/source. Native generation and request identity are observation context, not an objective/undertaking key. The App writes correlated Continue-as/start and fork facts as related conversations, and what it observes of Codex's native delegation: a dispatch (a completed spawn item naming a new child thread, with its association to a brief), the child's status as Codex last reported it, and the end of observation. A dispatch establishes the child and its parent only: no work done, return, review or integration. An observation carries no undertaking; only its association ties a dispatch to a brief. No role supply or current authority is established. Earlier 0.1 records remain quoted compatibility sources.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "observationId",
    "kind",
    "recorder",
    "observedAt",
    "body"
  ],
  "properties": {
    "format": {
      "const": "chirality.fleet.record"
    },
    "formatVersion": {
      "const": "0.2"
    },
    "observationId": {
      "type": "string",
      "pattern": "^fl:app:[A-Za-z0-9._:/-]+$"
    },
    "kind": {
      "enum": [
        "related_conversation",
        "dispatch_observed",
        "child_observed",
        "observation_ended",
        "recording_limit",
        "recording_recovered"
      ]
    },
    "recorder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "identity"
      ],
      "properties": {
        "kind": {
          "const": "App"
        },
        "identity": {
          "const": "app-writer:local"
        }
      }
    },
    "observedAt": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "description": "Descriptive text only; never an identity or association key.",
      "type": "string"
    },
    "body": {
      "type": "object"
    }
  },
  "$defs": {
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appSession",
        "home",
        "spawnCounter"
      ],
      "properties": {
        "appSession": {
          "type": "string",
          "minLength": 1
        },
        "home": {
          "type": "string",
          "minLength": 1
        },
        "spawnCounter": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threadId",
        "generation"
      ],
      "properties": {
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "$ref": "#/$defs/generation"
        }
      }
    },
    "nativePath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "bytes"
      ],
      "properties": {
        "encoding": {
          "const": "unix_bytes"
        },
        "bytes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "nativeHome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "homeId",
        "root",
        "physical"
      ],
      "properties": {
        "homeId": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "$ref": "#/$defs/nativePath"
        },
        "physical": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "device",
            "inode"
          ],
          "properties": {
            "device": {
              "type": "integer",
              "minimum": 0
            },
            "inode": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "contentIdentity": {
      "description": "Identity of exact bytes: the lowercase SHA-256 hex digest under the App's exact-bytes method.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "value"
      ],
      "properties": {
        "method": {
          "const": "chirality.app.exact-bytes.sha256/v1"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "nativeItem": {
      "description": "One native item by Codex's own thread, turn and item identities.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threadId",
        "turnId",
        "itemId"
      ],
      "properties": {
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "turnId": {
          "type": "string",
          "minLength": 1
        },
        "itemId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "briefFile": {
      "description": "A brief file path relative to the project's fleet folder.",
      "type": "string",
      "pattern": "^briefs/[A-Za-z0-9._-]+\\.json$"
    },
    "briefId": {
      "type": "string",
      "pattern": "^brief:[A-Za-z0-9._-]+$"
    },
    "association": {
      "description": "How the observed dispatch is tied to a brief, from the spawn prompt Codex supplied and the brief file's bytes when the dispatch was recorded. A matching reference shows which brief the prompt named and what its bytes were then, not that the child received or read it. A mismatch shows only that the file's bytes are not those referenced, not which of the two changed. Nothing is inferred: an absent prompt, an absent reference and a reference that cannot be resolved are each recorded as such.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "no brief reference"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "brief",
            "briefFile",
            "briefContent"
          ],
          "properties": {
            "state": {
              "const": "brief referenced"
            },
            "brief": {
              "$ref": "#/$defs/briefId"
            },
            "briefFile": {
              "$ref": "#/$defs/briefFile"
            },
            "briefContent": {
              "$ref": "#/$defs/contentIdentity"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "brief",
            "briefFile",
            "referencedContent",
            "currentContent"
          ],
          "properties": {
            "state": {
              "const": "brief referenced; content does not match the reference"
            },
            "brief": {
              "$ref": "#/$defs/briefId"
            },
            "briefFile": {
              "$ref": "#/$defs/briefFile"
            },
            "referencedContent": {
              "$ref": "#/$defs/contentIdentity"
            },
            "currentContent": {
              "$ref": "#/$defs/contentIdentity"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason",
            "references"
          ],
          "properties": {
            "state": {
              "const": "brief reference not resolved"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "references": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "briefFile",
                  "referencedContent"
                ],
                "properties": {
                  "briefFile": {
                    "type": "string",
                    "minLength": 1
                  },
                  "referencedContent": {
                    "$ref": "#/$defs/contentIdentity"
                  }
                }
              },
              "description": "Each reference the prompt gave in full; empty where no complete reference could be read."
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "related_conversation"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relation",
              "source",
              "thread",
              "nativeHome",
              "rpc",
              "typesPin"
            ],
            "properties": {
              "relation": {
                "enum": [
                  "continued from",
                  "forked from"
                ]
              },
              "source": {
                "$ref": "#/$defs/endpoint"
              },
              "thread": {
                "$ref": "#/$defs/endpoint"
              },
              "nativeHome": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "homeId",
                  "root",
                  "physical"
                ],
                "properties": {
                  "homeId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "root": {
                    "$ref": "#/$defs/nativePath"
                  },
                  "physical": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "device",
                      "inode"
                    ],
                    "properties": {
                      "device": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "inode": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                }
              },
              "rpc": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "method",
                  "requestId",
                  "requestRef"
                ],
                "properties": {
                  "method": {
                    "enum": [
                      "thread/start",
                      "thread/fork"
                    ]
                  },
                  "requestId": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "integer",
                        "minimum": 0
                      }
                    ]
                  },
                  "requestRef": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "typesPin": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "dispatch_observed"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mechanism",
              "parent",
              "child",
              "parentSource",
              "nativeHome",
              "spawnItem",
              "spawnPrompt",
              "association",
              "observation",
              "typesPin"
            ],
            "properties": {
              "mechanism": {
                "const": "Codex native subagent"
              },
              "parent": {
                "$ref": "#/$defs/endpoint"
              },
              "child": {
                "$ref": "#/$defs/endpoint"
              },
              "parentSource": {
                "const": "collabAgentToolCall.senderThreadId"
              },
              "nativeHome": {
                "$ref": "#/$defs/nativeHome"
              },
              "spawnItem": {
                "$ref": "#/$defs/nativeItem"
              },
              "spawnPrompt": {
                "description": "The prompt text is never recorded, only the identity of its exact UTF-8 bytes, or that Codex supplied none.",
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "state",
                      "content",
                      "bytes"
                    ],
                    "properties": {
                      "state": {
                        "const": "supplied"
                      },
                      "content": {
                        "$ref": "#/$defs/contentIdentity"
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "state"
                    ],
                    "properties": {
                      "state": {
                        "const": "not supplied"
                      }
                    }
                  }
                ]
              },
              "association": {
                "$ref": "#/$defs/association"
              },
              "observation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "position"
                ],
                "properties": {
                  "source": {
                    "const": "item/completed notification, received live"
                  },
                  "position": {
                    "description": "The App's receipt position in this generation; never a native sequence.",
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "typesPin": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "child_observed"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "child",
              "status",
              "statusSource",
              "sourceItem",
              "nativeHome",
              "typesPin"
            ],
            "properties": {
              "child": {
                "$ref": "#/$defs/endpoint"
              },
              "status": {
                "description": "The supplier's value, unchanged.",
                "type": "string",
                "minLength": 1
              },
              "statusSource": {
                "const": "collabAgentToolCall.agentsStates"
              },
              "sourceItem": {
                "$ref": "#/$defs/nativeItem"
              },
              "nativeHome": {
                "$ref": "#/$defs/nativeHome"
              },
              "typesPin": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "observation_ended"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "child",
              "cause",
              "lastObserved",
              "nativeHome"
            ],
            "properties": {
              "child": {
                "$ref": "#/$defs/endpoint"
              },
              "cause": {
                "enum": [
                  "Codex process stopped",
                  "Codex process exited unexpectedly",
                  "App quit",
                  "App relaunch",
                  "cause not observed"
                ]
              },
              "lastObserved": {
                "description": "The last status recorded for the child in that generation, or null. Nothing about the child's outcome follows.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "nativeHome": {
                "$ref": "#/$defs/nativeHome"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "recording_limit",
              "recording_recovered"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "originalObservationId",
              "phase",
              "statement"
            ],
            "properties": {
              "originalObservationId": {
                "type": "string",
                "pattern": "^fl:app:[A-Za-z0-9._:/-]+$"
              },
              "phase": {
                "enum": [
                  "store",
                  "project"
                ]
              },
              "statement": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
