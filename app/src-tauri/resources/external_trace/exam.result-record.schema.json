{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:app-v4:del-09-01:exam-result-record:0.2",
  "title": "Examination result record (DEL-09-01 EXP-v0.2 §4.1; PROPOSED)",
  "description": "One record per examined case, or per part of a case, on one subject: an identified candidate, a test double, or a definition. Outcome values are HOSTING-v0.9 §9.3's outcome labels, used as written (R23-1); their meanings are EXAMINATION §1 as defined in EXP §3.1. Names are Chirality semantic labels; no supplier or host wire field is selected and no placement is chosen. Evidence is linked by reference, never copied. Rules a schema cannot express (aggregation, actor different from recorder, native-substitution, reopening) are EXP §3.5 lists every rule EXP-R1…EXP-R9 and what enforces it (this schema or prototype/check_exp.py). Digests are sha256 (R23-17).",
  "type": "object",
  "required": [
    "record_kind",
    "format",
    "record_id",
    "support_revision",
    "case",
    "criterion",
    "activity",
    "run_basis",
    "subject",
    "configuration",
    "date",
    "outcome",
    "evidence",
    "currency"
  ],
  "additionalProperties": false,
  "properties": {
    "record_kind": {
      "const": "exam_result"
    },
    "format": {
      "const": "EXP-v0.2"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "support_revision": {
      "description": "The examination-support revision the record was written under (EXP §4.4; SCC-003 milestone M1).",
      "$ref": "#/$defs/support_revision"
    },
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "owner_deliverable"
      ],
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1,
          "description": "The owning journey's or feature's case identifier, e.g. VC-R-14, W14-05, EXP-VC-03."
        },
        "owner_deliverable": {
          "type": "string",
          "pattern": "^DEL-[0-9]{2}-[0-9]{2}$"
        },
        "scenario": {
          "type": "string",
          "pattern": "^V4-EXM-[0-9]{2}$"
        },
        "part": {
          "type": "string",
          "minLength": 1,
          "description": "Present when this record is one part of a case."
        }
      }
    },
    "criterion": {
      "type": "object",
      "required": [
        "source",
        "identity"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Source criterion, e.g. 'EXAMINATION.md V4-EXM-11' or 'DEL-01-02 ScopeOfWork AC-004'."
        },
        "identity": {
          "$ref": "#/$defs/digest",
          "description": "sha256 of the criterion text as examined (R23-17), so a later change is detectable (EXP §6.3)."
        },
        "disposition_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Only when a separately authorized criterion disposition applies: its record (REQ-005)."
        }
      }
    },
    "activity": {
      "enum": [
        "verification",
        "validation"
      ],
      "description": "EXAMINATION §1. 'validation' only records a practitioner's actual use and requires 'practitioner'."
    },
    "practitioner": {
      "type": "string",
      "minLength": 1
    },
    "run_basis": {
      "enum": [
        "definition_check",
        "rehearsal",
        "candidate"
      ],
      "description": "definition_check: rules run on a model or prototype; rehearsal: a test double or a replayed recording without a candidate; candidate: an identified App (and host, where joined) candidate. Mapping in EXP §3.2."
    },
    "subject": {
      "oneOf": [
        {
          "$ref": "#/$defs/candidate_subject"
        },
        {
          "$ref": "#/$defs/double_subject"
        },
        {
          "$ref": "#/$defs/definition_subject"
        }
      ]
    },
    "configuration": {
      "$ref": "#/$defs/configuration"
    },
    "date": {
      "type": "object",
      "required": [
        "value",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"
        },
        "source": {
          "enum": [
            "observed_clock",
            "record_timestamp",
            "stated_by_person"
          ]
        }
      }
    },
    "outcome": {
      "$ref": "#/$defs/outcome"
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "missing_inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/missing_input"
      }
    },
    "blocked_by": {
      "type": "string",
      "minLength": 1
    },
    "not_run_because": {
      "type": "string",
      "minLength": 1
    },
    "limits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/limit"
      }
    },
    "acts_cited": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/act_citation"
      }
    },
    "currency": {
      "$ref": "#/$defs/currency"
    },
    "parts_not_applicable": {
      "type": "array",
      "description": "R23-19: parts declared not applicable in the case definition, before the run, with their reason. Left out of aggregation (EXP-R1) and listed here; never also in parts.",
      "items": {
        "type": "object",
        "required": [
          "part",
          "reason",
          "declared_in"
        ],
        "additionalProperties": false,
        "properties": {
          "part": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "declared_in": {
            "type": "object",
            "required": [
              "case_definition",
              "identity"
            ],
            "additionalProperties": false,
            "properties": {
              "case_definition": {
                "type": "string",
                "minLength": 1
              },
              "identity": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "not-run"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "not_run_because"
            ]
          },
          {
            "required": [
              "missing_inputs"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "required": [
          "blocked_by"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "inconclusive"
          }
        }
      },
      "then": {
        "required": [
          "limits"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "activity": {
            "const": "validation"
          }
        }
      },
      "then": {
        "required": [
          "practitioner"
        ],
        "properties": {
          "run_basis": {
            "const": "candidate"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_basis": {
            "const": "candidate"
          }
        }
      },
      "then": {
        "properties": {
          "subject": {
            "$ref": "#/$defs/candidate_subject"
          },
          "configuration": {
            "required": [
              "codex_pin",
              "route",
              "model",
              "model_server"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_basis": {
            "const": "rehearsal"
          }
        }
      },
      "then": {
        "properties": {
          "subject": {
            "$ref": "#/$defs/double_subject"
          },
          "case": {
            "not": {
              "required": [
                "scenario"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_basis": {
            "const": "definition_check"
          }
        }
      },
      "then": {
        "properties": {
          "subject": {
            "$ref": "#/$defs/definition_subject"
          },
          "case": {
            "not": {
              "required": [
                "scenario"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "configuration": {
            "properties": {
              "route": {
                "properties": {
                  "kind": {
                    "const": "native_packaged"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "route"
            ]
          },
          "outcome": {
            "not": {
              "const": "not-run"
            }
          }
        },
        "required": [
          "configuration",
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "run_basis": {
            "const": "candidate"
          },
          "subject": {
            "properties": {
              "app_candidate": {
                "properties": {
                  "packaged": {
                    "const": true
                  }
                },
                "required": [
                  "packaged",
                  "package_record"
                ]
              }
            },
            "required": [
              "app_candidate"
            ]
          }
        }
      },
      "description": "EXP-R2: a native_packaged result other than not-run needs a candidate built as a DEL-01-06 package with its record (SCC-003 M2; NB-3). Without a package the case cannot be attempted, so it is not-run with the package as missing input (R23-20)."
    }
  ],
  "$defs": {
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "blocked",
        "not-run",
        "inconclusive"
      ],
      "description": "HOSTING-v0.9 §9.3 outcome labels, as written (R23-1). Meanings: EXP §3.1."
    },
    "support_revision": {
      "type": "object",
      "required": [
        "exp_version",
        "schema_id"
      ],
      "additionalProperties": false,
      "properties": {
        "exp_version": {
          "type": "string",
          "pattern": "^EXP-v[0-9]+\\.[0-9]+$"
        },
        "schema_id": {
          "type": "string",
          "minLength": 1
        },
        "prototype_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "candidate_subject": {
      "type": "object",
      "required": [
        "kind",
        "app_candidate"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "candidate"
        },
        "app_candidate": {
          "type": "object",
          "required": [
            "revision",
            "build_identity"
          ],
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "build_identity": {
              "type": "string",
              "minLength": 1
            },
            "packaged": {
              "type": "boolean",
              "description": "True when the build is a DEL-01-06 package; then 'package_record' is required."
            },
            "package_record": {
              "type": "string",
              "minLength": 1,
              "description": "DEL-01-06 OUT-002 identity record reference (SCC-003 milestone M2)."
            }
          },
          "if": {
            "properties": {
              "packaged": {
                "const": true
              }
            },
            "required": [
              "packaged"
            ]
          },
          "then": {
            "required": [
              "package_record"
            ]
          }
        },
        "host_candidate": {
          "type": "string",
          "minLength": 1,
          "description": "Joined witnesses only."
        },
        "identification_record": {
          "type": "string",
          "minLength": 1,
          "description": "The journey's own candidate identification record where it keeps one, e.g. W14-00."
        },
        "invented_material": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "double_subject": {
      "type": "object",
      "required": [
        "kind",
        "double",
        "file_digests"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "double"
        },
        "double": {
          "type": "string",
          "minLength": 1
        },
        "file_digests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64} .+$"
          }
        },
        "recording": {
          "type": "string",
          "minLength": 1,
          "description": "Replayed recording, when the rehearsal replays one (HOSTING §9.3)."
        }
      }
    },
    "definition_subject": {
      "type": "object",
      "required": [
        "kind",
        "version_label"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "definition"
        },
        "version_label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "configuration": {
      "type": "object",
      "required": [
        "codex_pin",
        "route"
      ],
      "additionalProperties": false,
      "properties": {
        "codex_pin": {
          "description": "The Codex version the result binds to (R23-3: either pin). 'not_applicable' only for records with no Codex involvement.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            {
              "const": "not_applicable"
            }
          ]
        },
        "codex_distribution_identity": {
          "type": "string",
          "minLength": 1,
          "description": "HOSTING §7.1 distribution content identity reference, where verified."
        },
        "model": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "requested"
              ],
              "additionalProperties": false,
              "properties": {
                "requested": {
                  "type": "string",
                  "minLength": 1
                },
                "reported": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "enum": [
                "not_observed",
                "not_applicable"
              ]
            }
          ]
        },
        "model_server": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "label"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "chatgpt_account",
                    "api_key",
                    "local_provider",
                    "other"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "server_version": {
                  "type": "string",
                  "minLength": 1
                },
                "home": {
                  "enum": [
                    "H-acct",
                    "H-key",
                    "not_applicable"
                  ],
                  "description": "App-owned Codex home (DECISION-K3 K-1; DECISION-L L-1)."
                }
              }
            },
            {
              "enum": [
                "not_observed",
                "not_applicable"
              ]
            }
          ]
        },
        "route": {
          "$ref": "#/$defs/route"
        },
        "settings_in_effect": {
          "type": "string",
          "minLength": 1,
          "description": "The person's tool-permission and sandbox settings actually in effect, by reference (HOSTING §9.1; D3)."
        },
        "host_profile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "route": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "model_only",
            "seam_replay",
            "seam_live",
            "interface_webkit",
            "interface_chromium",
            "native_development",
            "native_packaged"
          ]
        },
        "engine": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "platform": {
          "type": "object",
          "required": [
            "os",
            "arch"
          ],
          "additionalProperties": false,
          "properties": {
            "os": {
              "type": "string",
              "minLength": 1
            },
            "arch": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "native_route": {
          "description": "How a native step was operated (EXP §8; R23-13). A change of method or tool is a configuration change that reopens affected native cases.",
          "type": "object",
          "required": [
            "method"
          ],
          "additionalProperties": false,
          "properties": {
            "method": {
              "enum": [
                "person_operated",
                "ui_automation"
              ]
            },
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "form_ref": {
              "type": "string",
              "minLength": 1
            },
            "tool_definition_check": {
              "type": "string",
              "minLength": 1,
              "description": "The EXP-DC-N2 record admitting this tool version on this candidate (EXP §8.3)."
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "method": {
                    "const": "ui_automation"
                  }
                }
              },
              "then": {
                "required": [
                  "tool",
                  "tool_definition_check"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "method": {
                    "const": "person_operated"
                  }
                }
              },
              "then": {
                "required": [
                  "form_ref"
                ]
              }
            }
          ]
        },
        "webview": {
          "type": "object",
          "required": [
            "name",
            "webkit_version",
            "os_version"
          ],
          "additionalProperties": false,
          "description": "The macOS WebKit environment the App interface ran in (WKWebView), REQ-007/AC-008.",
          "properties": {
            "name": {
              "const": "WKWebView"
            },
            "webkit_version": {
              "type": "string",
              "minLength": 1
            },
            "os_version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "runner_definition_check": {
          "type": "string",
          "minLength": 1,
          "description": "The EXP-DC-RUNNER record admitting this runner version (EXP §8.3)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "interface_webkit",
                  "interface_chromium"
                ]
              }
            }
          },
          "then": {
            "required": [
              "engine",
              "platform",
              "runner_definition_check"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "native_development",
                  "native_packaged"
                ]
              }
            }
          },
          "then": {
            "required": [
              "platform",
              "native_route",
              "webview"
            ]
          }
        }
      ]
    },
    "part": {
      "type": "object",
      "required": [
        "part",
        "expectation",
        "outcome"
      ],
      "additionalProperties": false,
      "properties": {
        "part": {
          "type": "string",
          "minLength": 1
        },
        "expectation": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "needs_native": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "not_run_because": {
          "type": "string",
          "minLength": 1
        },
        "blocked_by": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "not-run"
              }
            }
          },
          "then": {
            "required": [
              "not_run_because"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "blocked"
              }
            }
          },
          "then": {
            "required": [
              "blocked_by"
            ]
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "ref",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "provenance": {
          "enum": [
            "test_definition",
            "recorded_replay",
            "static_inspection",
            "live_observation",
            "person_act",
            "host_receipt",
            "review_record",
            "feature_check"
          ],
          "description": "Kept distinct even when one evidence set holds several (EXAMINATION §2; XT §6)."
        },
        "route": {
          "enum": [
            "model_only",
            "seam_replay",
            "seam_live",
            "interface_webkit",
            "interface_chromium",
            "native_development",
            "native_packaged"
          ],
          "description": "Route of this piece of evidence where it differs from the record's (EXP-R4)."
        },
        "fixture_standing": {
          "enum": [
            "recorded",
            "recorded-truncated",
            "mutated",
            "constructed"
          ],
          "description": "HOSTING §9.2 fixture standing, as written."
        },
        "redaction_record": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "missing_input": {
      "type": "object",
      "required": [
        "input",
        "supplier"
      ],
      "additionalProperties": false,
      "properties": {
        "input": {
          "type": "string",
          "minLength": 1
        },
        "supplier": {
          "type": "string",
          "minLength": 1
        },
        "point_of_need": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limit": {
      "type": "object",
      "required": [
        "label",
        "vocabulary"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "vocabulary": {
          "type": "string",
          "minLength": 1,
          "description": "Whose label this is, e.g. 'EXP' or 'RS-v0.9 evidenceLimitLabel'. EXP does not define other owners' labels (EXP §3.4)."
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "act_citation": {
      "type": "object",
      "required": [
        "record_ref",
        "kind",
        "actor",
        "recorder"
      ],
      "additionalProperties": false,
      "properties": {
        "record_ref": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "The act kind as the act record's owner names it."
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "recorder": {
          "type": "string",
          "minLength": 1
        },
        "capture_evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "currency": {
      "type": "object",
      "required": [
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "current",
            "historical",
            "reopened"
          ]
        },
        "change_ref": {
          "type": "string",
          "minLength": 1,
          "description": "The change-impact record that made this result historical or reopened its case."
        }
      },
      "if": {
        "properties": {
          "state": {
            "enum": [
              "historical",
              "reopened"
            ]
          }
        }
      },
      "then": {
        "required": [
          "change_ref"
        ]
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
