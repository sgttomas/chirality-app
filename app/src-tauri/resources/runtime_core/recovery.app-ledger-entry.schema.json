{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:app-v4:del-01-02:app-ledger-entry:0.6",
  "title": "DEL-01-02 App ledger entry — what the App keeps across relaunch (PROPOSED)",
  "description": "EXECUTION_AND_RECOVERY.md §7. Append-only, one entry per line (as RS S-A); location and technology unselected (TBD-002). Pointers and App-observed facts only: no message, item, plan, command text, tool output or request payload is kept; those are read back from Codex (ARCHITECTURE §3; R17-4).",
  "oneOf": [
    {
      "$ref": "#/$defs/session_started"
    },
    {
      "$ref": "#/$defs/quit_requested"
    },
    {
      "$ref": "#/$defs/quit_answered"
    },
    {
      "$ref": "#/$defs/session_ended"
    },
    {
      "$ref": "#/$defs/conversation_index"
    },
    {
      "$ref": "#/$defs/register_entry_summary"
    },
    {
      "$ref": "#/$defs/stop_request"
    },
    {
      "$ref": "#/$defs/lifecycle_ref"
    },
    {
      "$ref": "#/$defs/codex_stop"
    },
    {
      "$ref": "#/$defs/level_chosen"
    },
    {
      "$ref": "#/$defs/level_sent"
    },
    {
      "$ref": "#/$defs/level_reported"
    }
  ],
  "$defs": {
    "session_started": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "session",
        "at",
        "previousSessionEnd",
        "candidate"
      ],
      "properties": {
        "kind": {
          "const": "session_started"
        },
        "session": {
          "$ref": "#/$defs/nonempty"
        },
        "at": {
          "$ref": "#/$defs/nonempty"
        },
        "previousSession": {
          "$ref": "#/$defs/nonempty"
        },
        "previousSessionEnd": {
          "enum": [
            "none",
            "clean",
            "quit-with-live-work",
            "ended-without-record",
            "system-terminated"
          ]
        },
        "candidate": {
          "$ref": "#/$defs/nonempty"
        },
        "livenessLock": {
          "description": "0.5: present (true) when this session held its App session liveness lock beside the ledger before this entry was written. A held lock refuses a later session start. Every other lock-file outcome says nothing about whether the session ended; an unrecorded end is established only by the App data custody and same-process rule. Absent: a session that declared no lock.",
          "const": true
        }
      }
    },
    "quit_requested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "session",
        "at",
        "actor",
        "liveTurns",
        "outstandingEntries",
        "activeDescendants"
      ],
      "properties": {
        "kind": {
          "const": "quit_requested"
        },
        "session": {
          "$ref": "#/$defs/nonempty"
        },
        "at": {
          "$ref": "#/$defs/nonempty"
        },
        "actor": {
          "$ref": "#/$defs/person"
        },
        "liveTurns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/turnRef"
          }
        },
        "outstandingEntries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entryRef"
          }
        },
        "activeDescendants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/descendant"
          }
        }
      }
    },
    "quit_answered": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "session",
        "at",
        "answer",
        "actor"
      ],
      "properties": {
        "kind": {
          "const": "quit_answered"
        },
        "session": {
          "$ref": "#/$defs/nonempty"
        },
        "at": {
          "$ref": "#/$defs/nonempty"
        },
        "answer": {
          "enum": [
            "confirmed",
            "cancelled"
          ]
        },
        "actor": {
          "$ref": "#/$defs/person"
        }
      }
    },
    "session_ended": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "session",
        "at",
        "how",
        "stopRequests"
      ],
      "properties": {
        "kind": {
          "const": "session_ended"
        },
        "session": {
          "$ref": "#/$defs/nonempty"
        },
        "at": {
          "$ref": "#/$defs/nonempty"
        },
        "how": {
          "enum": [
            "quit",
            "system-terminated"
          ]
        },
        "stopRequests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "stopRequestId",
              "state"
            ],
            "additionalProperties": false,
            "properties": {
              "stopRequestId": {
                "type": "string",
                "pattern": "^stop:.+"
              },
              "state": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "conversation_index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "session",
        "at",
        "threadId",
        "home",
        "project",
        "tags",
        "lastObservedExecution"
      ],
      "properties": {
        "kind": {
          "const": "conversation_index"
        },
        "session": {
          "$ref": "#/$defs/nonempty"
        },
        "at": {
          "$ref": "#/$defs/nonempty"
        },
        "threadId": {
          "$ref": "#/$defs/nonempty"
        },
        "home": {
          "$ref": "#/$defs/home"
        },
        "forkedFrom": {
          "description": "The source thread when this conversation was made by thread/fork (OBS-3 W-6: the fork's history is referenced from the source's rollout).",
          "$ref": "#/$defs/nonempty"
        },
        "project": {
          "description": "Opaque known App project reference, including an explicitly configured/opened directory reference. CC-REC-ATTACHMENT-PROJECT-CONTEXT: no row for unestablished project; never null/fake unknown/cwd fallback. Historical association is not renamed by a new submission context.",
          "$ref": "#/$defs/nonempty"
        },
        "tags": {
          "description": "Opaque tags handed at run time by receivers (for example a run reference). Several per owner, in order (seq), so that runs follow one another in one conversation (R19-2). Stored and returned, never interpreted (R17-10). CC-REC-ATTACHMENT-PROJECT-CONTEXT adds owner DEL-01-04 compact [submissionRef, projectRef-or-null] string; null is only within that opaque value, not the project field.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "owner",
              "value",
              "seq"
            ],
            "additionalProperties": false,
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "seq": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "lastObservedExecution": {
          "description": "Shown only as 'last observed by the App at ‹at›', never as Codex's state.",
          "type": "object",
          "required": [
            "state",
            "at"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "indexed",
                "recovery-pending",
                "recovering",
                "unavailable",
                "loaded-idle",
                "turn-live",
                "interrupt-pending",
                "system-error",
                "observation-lost"
              ]
            },
            "at": {
              "type": "string",
              "minLength": 1
            },
            "liveTurn": {
              "type": "string",
              "minLength": 1
            },
            "lostCause": {
              "$ref": "#/$defs/lossContext"
            },
            "abortNoteExpected": {
              "description": "G-5: the live turn was ended by a graceful stop, after which Codex 0.158.0 writes its abort note into history (OBS-2 §5.2).",
              "type": "boolean"
            },
            "openItems": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "itemId",
                  "itemType"
                ],
                "additionalProperties": false,
                "properties": {
                  "itemId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "itemType": {
                    "type": "string",
                    "minLength": 1
                  },
                  "turnId": {
                    "description": "CC-REC-ITEM-TURN-CUSTODY: actual observed opaque native turn reference. Absent means unknown; never infer from liveTurn. Scope is enclosing thread/home/lastLoadedGeneration.",
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "lastLoadedGeneration": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "register_entry_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "session",
        "at",
        "generation",
        "requestIdentity",
        "method",
        "state",
        "transition"
      ],
      "properties": {
        "kind": {
          "const": "register_entry_summary"
        },
        "session": {
          "$ref": "#/$defs/nonempty"
        },
        "at": {
          "$ref": "#/$defs/nonempty"
        },
        "generation": {
          "$ref": "#/$defs/nonempty"
        },
        "requestIdentity": {
          "$ref": "#/$defs/nonempty"
        },
        "method": {
          "$ref": "#/$defs/nonempty"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "state": {
          "enum": [
            "listed",
            "closed"
          ]
        },
        "transition": {
          "type": "string",
          "pattern": "^RQ-[0-9][0-9]$"
        },
        "endedAs": {
          "description": "ended-unanswered(process-exit): written by the session that held the request, when its Codex generation closed. open-at-app-session-end (0.5): written at a later session's start for a request an earlier App session left recorded open. That session's end ended the connection it could be answered on. No reply is recorded; whether one was written after the last record, and whether Codex's process had ended, were not observed.",
          "enum": [
            "answered",
            "declined",
            "errored",
            "resolved-by-supplier",
            "settle-write-failed",
            "reply-outcome-unknown",
            "ended-unanswered(process-exit)",
            "open-at-app-session-end"
          ]
        },
        "origin": {
          "type": "string",
          "pattern": "^(person-via-interaction|app-explicit-error|supplier-internal|app-rule:.+)$"
        },
        "replyWrite": {
          "enum": [
            "written",
            "write-failed",
            "not-attempted",
            "unknown"
          ]
        },
        "acknowledgment": {
          "enum": [
            "observed",
            "not-observed",
            "not-observable-at-pin"
          ]
        },
        "context": {
          "$ref": "#/$defs/lossContext"
        },
        "sameItemAs": {
          "description": "RQ-07: an earlier entry with the same subject item reference (observed equality of the reference, not the same request).",
          "$ref": "#/$defs/nonempty"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "closed"
              }
            }
          },
          "then": {
            "required": [
              "endedAs"
            ]
          }
        }
      ]
    },
    "stop_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "session",
        "at",
        "record"
      ],
      "properties": {
        "kind": {
          "const": "stop_request"
        },
        "session": {
          "$ref": "#/$defs/nonempty"
        },
        "at": {
          "$ref": "#/$defs/nonempty"
        },
        "record": {
          "description": "A recovery.stop-request record (validated against that schema).",
          "type": "object"
        }
      }
    },
    "lifecycle_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "session",
        "at",
        "home",
        "generation",
        "transition",
        "state"
      ],
      "properties": {
        "kind": {
          "const": "lifecycle_ref"
        },
        "session": {
          "$ref": "#/$defs/nonempty"
        },
        "at": {
          "$ref": "#/$defs/nonempty"
        },
        "home": {
          "$ref": "#/$defs/home"
        },
        "generation": {
          "$ref": "#/$defs/nonempty"
        },
        "transition": {
          "type": "string",
          "pattern": "^LT-[0-9][0-9]$"
        },
        "state": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "codex_stop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "session",
        "at",
        "actor",
        "homes",
        "restart",
        "liveTurns",
        "outstandingEntries"
      ],
      "properties": {
        "kind": {
          "const": "codex_stop"
        },
        "session": {
          "$ref": "#/$defs/nonempty"
        },
        "at": {
          "$ref": "#/$defs/nonempty"
        },
        "actor": {
          "$ref": "#/$defs/person"
        },
        "homes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/home"
          }
        },
        "restart": {
          "type": "boolean"
        },
        "liveTurns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/turnRef"
          }
        },
        "outstandingEntries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entryRef"
          }
        }
      }
    },
    "level_chosen": {
      "description": "0.6: the permission level the person chose (PRD V4-AUT-06): the person's own setting, confirmed by the App's native statement. No decision actor and no act kind: it is not a human-act record.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "session", "entryId", "at", "scope", "level", "previous", "confirmation"],
      "properties": {
        "kind": {"const": "level_chosen"},
        "session": {"$ref": "#/$defs/nonempty"},
        "entryId": {"$ref": "#/$defs/nonempty"},
        "at": {"$ref": "#/$defs/nonempty"},
        "scope": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["kind"],
           "properties": {"kind": {"const": "default-for-new-conversations"}}},
          {"type": "object", "additionalProperties": false, "required": ["kind", "home", "threadId"],
           "properties": {"kind": {"const": "conversation"}, "home": {"$ref": "#/$defs/nonempty"},
                          "threadId": {"$ref": "#/$defs/nonempty"}}}
        ]},
        "level": {"$ref": "#/$defs/levelValues"},
        "previous": {"oneOf": [{"$ref": "#/$defs/nonempty"}, {"type": "null"}]},
        "confirmation": {"type": "object", "additionalProperties": false, "required": ["kind", "statementDigest"],
                         "properties": {"kind": {"const": "native"},
                                        "statementDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
      }
    },
    "level_sent": {
      "description": "0.6: the App began to send a chosen level to its Codex, once per conversation per chosen level, at the first request carrying it. Says nothing of Codex.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "session", "entryId", "at", "chosen", "home", "threadId", "method", "requestRef", "writeResult", "takesEffect"],
      "properties": {
        "kind": {"const": "level_sent"},
        "session": {"$ref": "#/$defs/nonempty"},
        "entryId": {"$ref": "#/$defs/nonempty"},
        "at": {"$ref": "#/$defs/nonempty"},
        "chosen": {"$ref": "#/$defs/nonempty"},
        "home": {"$ref": "#/$defs/nonempty"},
        "threadId": {"oneOf": [{"$ref": "#/$defs/nonempty"}, {"type": "null"}]},
        "method": {"enum": ["thread/start", "thread/resume", "thread/fork", "turn/start"]},
        "requestRef": {"$ref": "#/$defs/nonempty"},
        "writeResult": {"enum": ["written", "write-failed", "not-established"]},
        "takesEffect": {"enum": ["now", "from-next-turn"]}
      }
    },
    "level_reported": {
      "description": "0.6: what Codex's own reply to a start, resume or fork reported as the approval and sandbox in force, and whether it agrees with the level sent. Written only from a reply.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "session", "entryId", "at", "chosen", "sent", "home", "threadId", "from", "approvalPolicy", "approvalsReviewer", "sandbox", "agreement"],
      "properties": {
        "kind": {"const": "level_reported"},
        "session": {"$ref": "#/$defs/nonempty"},
        "entryId": {"$ref": "#/$defs/nonempty"},
        "at": {"$ref": "#/$defs/nonempty"},
        "chosen": {"$ref": "#/$defs/nonempty"},
        "sent": {"$ref": "#/$defs/nonempty"},
        "home": {"$ref": "#/$defs/nonempty"},
        "threadId": {"$ref": "#/$defs/nonempty"},
        "from": {"enum": ["thread/start", "thread/resume", "thread/fork"]},
        "approvalPolicy": {},
        "approvalsReviewer": {},
        "sandbox": {},
        "agreement": {"enum": ["agrees", "differs"]}
      }
    },
    "levelValues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tableDigest", "approvalPolicy", "approvalsReviewer", "sandbox", "sandboxPolicy", "workspaceWrite"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"},
        "tableDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approvalPolicy": {"enum": ["untrusted", "on-request", "never"]},
        "approvalsReviewer": {"const": "user"},
        "sandbox": {"enum": ["read-only", "workspace-write", "danger-full-access"]},
        "sandboxPolicy": {"type": "object"},
        "workspaceWrite": {"oneOf": [{"type": "object"}, {"type": "null"}]}
      }
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "person": {
      "description": "DECISION-K1 K1-4: the person as the App observes them, never verified.",
      "type": "object",
      "required": [
        "kind",
        "identity",
        "identityStatus"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "person"
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "identityStatus": {
          "const": "identity not verified"
        }
      }
    },
    "turnRef": {
      "type": "object",
      "required": [
        "threadId",
        "turnId"
      ],
      "additionalProperties": false,
      "properties": {
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "turnId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "subject": {
      "description": "Supplier references carried as data (HOSTING §6.1 subject references); never payload content.",
      "type": "object",
      "required": [
        "threadId"
      ],
      "additionalProperties": false,
      "properties": {
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "turnId": {
          "type": "string",
          "minLength": 1
        },
        "itemId": {
          "type": "string",
          "minLength": 1
        },
        "callId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entryRef": {
      "description": "A register entry by reference: generation, identity, method and subject only. Native parameters are never carried (R17-4).",
      "type": "object",
      "required": [
        "generation",
        "requestIdentity",
        "method"
      ],
      "additionalProperties": false,
      "properties": {
        "generation": {
          "type": "string",
          "minLength": 1
        },
        "requestIdentity": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "$ref": "#/$defs/subject"
        }
      }
    },
    "descendant": {
      "type": "object",
      "required": [
        "kind",
        "ref",
        "observedStatus"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "child-thread",
            "background-terminal",
            "process"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "observedStatus": {
          "enum": [
            "active",
            "ended",
            "unknown"
          ]
        }
      }
    },
    "lossContext": {
      "enum": [
        "supplier-exit",
        "supplier-stop",
        "app-quit",
        "system-termination",
        "app-ended-without-record"
      ]
    },
    "home": {
      "description": "The App-owned Codex home (DECISION-L L-1): H-acct, or H-key for API-key conversations.",
      "type": "string",
      "pattern": "^H-[a-z]+$"
    }
  }
}
