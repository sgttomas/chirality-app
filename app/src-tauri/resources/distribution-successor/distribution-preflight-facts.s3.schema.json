{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:distribution-preflight-facts:s3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "generation",
    "inventory",
    "raw_version_label",
    "configuration",
    "limit"
  ],
  "properties": {
    "format": {
      "const": "distribution-preflight-facts.s3"
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appSession": {
          "type": "string",
          "minLength": 1
        },
        "home": {
          "type": "string",
          "minLength": 1
        },
        "spawnCounter": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "appSession",
        "home",
        "spawnCounter"
      ]
    },
    "inventory": {
      "title": "CC-HOSTING-DISTRIBUTION-01 candidate inventory value; no qualification standing",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "algorithm",
        "manifest_sha256",
        "entries"
      ],
      "properties": {
        "method": {
          "const": "codex-vendor-tree-v1"
        },
        "algorithm": {
          "const": "sha-256"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "kind",
                  "mode"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Exact relative UTF-8 path; semantic checks enforce components, uniqueness and parent directories. Root is dot, directory only."
                  },
                  "mode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4095,
                    "description": "POSIX st_mode & 07777; decimal representation."
                  },
                  "kind": {
                    "const": "dir"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "kind",
                  "mode",
                  "size",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Exact relative UTF-8 path; semantic checks enforce components, uniqueness and parent directories. Root is dot, directory only."
                  },
                  "mode": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4095,
                    "description": "POSIX st_mode & 07777; decimal representation."
                  },
                  "kind": {
                    "const": "file"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$",
                    "minLength": 64,
                    "maxLength": 64
                  }
                }
              }
            ]
          }
        }
      }
    },
    "raw_version_label": {
      "type": "string",
      "minLength": 1
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resolved_root": {
          "type": "string",
          "minLength": 1
        },
        "resolved_executable": {
          "type": "string",
          "minLength": 1
        },
        "working_directory": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "path_prefix": {
          "type": "string",
          "minLength": 1
        },
        "path_remainder_provenance": {
          "type": "string",
          "minLength": 1
        },
        "app_supplied_nonsecret": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "removed_environment_names": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "probe_home": {
          "type": "string",
          "minLength": 1
        },
        "account_home": {
          "type": "string",
          "minLength": 1
        },
        "home_link_states": {
          "type": "string",
          "minLength": 1
        },
        "k12_flags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "secret_redactions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "resolved_root",
        "resolved_executable",
        "working_directory",
        "argv",
        "path_prefix",
        "path_remainder_provenance",
        "app_supplied_nonsecret",
        "removed_environment_names",
        "probe_home",
        "account_home",
        "home_link_states",
        "k12_flags",
        "secret_redactions"
      ]
    },
    "limit": {
      "const": "Bounded source observations; no installed integrity/custody issuer or qualification"
    }
  }
}
