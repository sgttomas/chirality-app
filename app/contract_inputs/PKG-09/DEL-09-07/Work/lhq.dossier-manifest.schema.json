{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:app-v4:del-09-07:dossier-manifest:0.1",
  "title": "Local host qualification dossier manifest (DEL-09-07 DOS-v0.1; PROPOSED)",
  "description": "Links every record of the one joined dossier (OUT-002) by reference. Case results are DEL-09-01 EXP result records; reopening uses EXP change-impact records; independent review an EXP review record. Rules a schema cannot express (DH-1 against the cited EXP record; DJ-1…DJ-3) are stated in DOS §4–§5.",
  "type": "object",
  "required": [
    "record_kind",
    "format",
    "dossier_id",
    "version",
    "date",
    "cir_refs",
    "case_results",
    "traffic_observation_refs",
    "host_evidence",
    "act_owner_account",
    "interface_coverage",
    "applicability",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "record_kind": {
      "const": "lhq_dossier_manifest"
    },
    "format": {
      "const": "DOS-v0.1"
    },
    "dossier_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "previous_version": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "object",
      "required": [
        "value",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"
        },
        "source": {
          "enum": [
            "observed_clock",
            "record_timestamp",
            "stated_by_person"
          ]
        }
      }
    },
    "cir_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "case_results": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "case",
          "exam_result_refs"
        ],
        "additionalProperties": false,
        "properties": {
          "case": {
            "enum": [
              "LHQ-20",
              "LHQ-21",
              "LHQ-22",
              "LHQ-23"
            ]
          },
          "exam_result_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "traffic_observation_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "host_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "kind",
          "resolution_at_write"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "host_run_record",
              "host_receipt",
              "origin_mark",
              "content_identity",
              "act_record",
              "destination_record",
              "findings"
            ]
          },
          "resolution_at_write": {
            "enum": [
              "resolved",
              "unresolvable",
              "not_supplied"
            ]
          }
        }
      }
    },
    "act_owner_account": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "act",
          "owner",
          "claimed_discharged"
        ],
        "additionalProperties": false,
        "properties": {
          "act": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "claimed_discharged": {
            "const": false
          }
        }
      }
    },
    "interface_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "route",
          "applies_to",
          "standing"
        ],
        "additionalProperties": false,
        "properties": {
          "route": {
            "enum": [
              "interface_webkit",
              "interface_chromium",
              "native_development",
              "native_packaged"
            ]
          },
          "applies_to": {
            "enum": [
              "host_panel",
              "app_candidate"
            ]
          },
          "standing": {
            "enum": [
              "present",
              "absent",
              "not_applicable"
            ]
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "standing": {
                  "const": "present"
                }
              }
            },
            "then": {
              "required": [
                "evidence_ref"
              ]
            }
          }
        ]
      }
    },
    "applicability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "changed",
          "change_kind",
          "reopens"
        ],
        "additionalProperties": false,
        "properties": {
          "changed": {
            "enum": [
              "host_candidate",
              "app_candidate",
              "local_model_server",
              "adopted_policy",
              "initial_allow_list",
              "observation_tooling",
              "operation_binding",
              "invented_material",
              "codex_pin",
              "case_definition"
            ]
          },
          "change_kind": {
            "enum": [
              "candidate_code",
              "codex_pin",
              "configuration",
              "fixture",
              "native_route",
              "support_revision",
              "criterion_disposition",
              "package",
              "case_definition"
            ],
            "description": "EXP-v0.2 change kinds (exam.change-impact.schema.json)."
          },
          "reopens": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "LHQ-20",
                "LHQ-21",
                "LHQ-22",
                "LHQ-23"
              ]
            }
          }
        }
      }
    },
    "independent_review_ref": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "vocabulary"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "vocabulary": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "applies_to": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "handoff_del_11_03": {
      "type": "object",
      "required": [
        "p20a_result_ref",
        "counts_as_completed_witness",
        "acceptance_acts",
        "receipts",
        "statement"
      ],
      "additionalProperties": false,
      "properties": {
        "p20a_result_ref": {
          "type": "string",
          "minLength": 1
        },
        "counts_as_completed_witness": {
          "type": "boolean"
        },
        "acceptance_acts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "record_ref",
              "actor",
              "recorder"
            ],
            "additionalProperties": false,
            "properties": {
              "record_ref": {
                "type": "string",
                "minLength": 1
              },
              "actor": {
                "type": "string",
                "minLength": 1
              },
              "recorder": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "receipts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref",
              "resolution_at_write"
            ],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "resolution_at_write": {
                "enum": [
                  "resolved",
                  "unresolvable",
                  "not_supplied"
                ]
              }
            }
          }
        },
        "statement": {
          "const": "Evidence for the owner's replacement judgment; not a replacement decision, release or professional reliance."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "counts_as_completed_witness": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "acceptance_acts": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "handoff_del_09_11": {
      "type": "object",
      "required": [
        "journey_run_ref",
        "cir_ref",
        "journey_dates",
        "run_authors",
        "withheld",
        "record_set",
        "receipt_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "journey_run_ref": {
          "type": "string",
          "minLength": 1
        },
        "cir_ref": {
          "type": "string",
          "minLength": 1
        },
        "journey_dates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "value",
              "source"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"
              },
              "source": {
                "enum": [
                  "observed_clock",
                  "record_timestamp",
                  "stated_by_person"
                ]
              }
            }
          }
        },
        "run_authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "identity",
              "role"
            ],
            "additionalProperties": false,
            "properties": {
              "identity": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "person_requester",
                  "person_actor",
                  "host_agent_session",
                  "recorder",
                  "dossier_assembler",
                  "examiner"
                ]
              }
            }
          }
        },
        "record_set": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256",
              "standing"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "standing": {
                "enum": [
                  "record",
                  "project_file",
                  "host_evidence",
                  "not_authority"
                ],
                "description": "DEL-09-11 input-set standing (RRM §3). Only the run's primary project records; the agent's run summary only as not_authority."
              }
            }
          }
        },
        "receipt_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref",
              "resolution_at_write"
            ],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "resolution_at_write": {
                "enum": [
                  "resolved",
                  "unresolvable",
                  "not_supplied"
                ]
              }
            }
          }
        },
        "withheld": {
          "type": "array",
          "minItems": 1,
          "description": "DOS §5, DJ-1 (RV-LHQ-U2 U2-R2): named, never supplied. Kinds are DEL-09-11's input-set classes (RRM §3). The dossier's case results, the examiner's reconstruction and its review record are derived_view.",
          "items": {
            "type": "object",
            "required": [
              "identity",
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "identity": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "harness_session",
                  "host_agent_conversation",
                  "app_conversation",
                  "author_memory",
                  "derived_view"
                ]
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "handoff_del_11_03"
        ],
        "properties": {
          "handoff_del_11_03": {
            "properties": {
              "counts_as_completed_witness": {
                "const": true
              }
            },
            "required": [
              "counts_as_completed_witness"
            ]
          }
        }
      },
      "then": {
        "required": [
          "independent_review_ref"
        ]
      }
    }
  ]
}