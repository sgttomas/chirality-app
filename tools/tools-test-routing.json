{
  "schema": "chirality-software-workflow/v1",
  "project_root": "..",
  "description": "Path-routing profile for the tools/ test estate. Consumed by tools/run_affected_tests.py (locally and in governance-harness PR runs) via tools/software_workflow/select_affected_checks.py. always_checks are live-tree gates that any change can trip and therefore always run; path_rules route the isolated per-tool suites. Pushes to main always run the full estate regardless of this profile (the routing is a PR/session economy, never the authority).",
  "always_checks": [
    "practitioner_harness",
    "validation"
  ],
  "checks": {
    "analysis": {
      "pytest_paths": [
        "tools/analysis"
      ]
    },
    "coordination": {
      "pytest_paths": [
        "tools/coordination"
      ]
    },
    "decomp": {
      "pytest_paths": [
        "tools/decomp"
      ]
    },
    "drawing_extract": {
      "pytest_paths": [
        "tools/drawing_extract"
      ]
    },
    "equation_audit": {
      "pytest_paths": [
        "tools/equation_audit"
      ]
    },
    "pdf2md": {
      "pytest_paths": [
        "tools/pdf2md"
      ]
    },
    "practitioner_harness": {
      "pytest_paths": [
        "tools/practitioner_harness"
      ]
    },
    "publication": {
      "pytest_paths": [
        "tools/publication"
      ]
    },
    "reporting": {
      "pytest_paths": [
        "tools/reporting"
      ]
    },
    "retrieval": {
      "pytest_paths": [
        "tools/retrieval"
      ]
    },
    "scope_of_work": {
      "pytest_paths": [
        "tools/scope_of_work"
      ]
    },
    "software_workflow": {
      "pytest_paths": [
        "tools/software_workflow"
      ]
    },
    "source_audit": {
      "pytest_paths": [
        "tools/source_audit"
      ]
    },
    "source_catalog": {
      "pytest_paths": [
        "tools/source_catalog"
      ]
    },
    "taskmgmt": {
      "pytest_paths": [
        "tools/taskmgmt"
      ]
    },
    "validation": {
      "pytest_paths": [
        "tools/validation"
      ]
    },
    "workflow_runtime": {
      "pytest_paths": [
        "tools/workflow_runtime"
      ]
    },
    "evaluation": {
      "pytest_paths": [
        "tools/evaluation"
      ]
    },
    "scaffolding": {
