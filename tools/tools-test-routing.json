        "software_workflow",
        "source_audit",
        "source_catalog",
        "taskmgmt",
        "validation",
        "workflow_runtime",
        "evaluation",
        "scaffolding"
      ]
    },
    {
      "paths": [
        "workflows/*",
        "agents/*"
      ],
      "checks": [
        "workflow_runtime",
        "validation"
      ]
    },
    {
      "paths": [
        "tools/evaluation/*"
      ],
      "checks": [
