  "path_rules": [
    {
      "paths": [
        "tools/analysis/*"
      ],
      "checks": [
        "analysis"
      ]
    },
    {
      "paths": [
        "tools/coordination/*"
      ],
      "checks": [
        "coordination"
      ]
    },
    {
      "paths": [
        "tools/decomp/*"
      ],
      "checks": [
        "decomp"
      ]
    },
    {
      "paths": [
        "tools/drawing_extract/*"
      ],
      "checks": [
        "drawing_extract"
      ]
    },
    {
      "paths": [
        "tools/equation_audit/*"
      ],
      "checks": [
        "equation_audit"
      ]
    },
    {
      "paths": [
        "tools/pdf2md/*"
      ],
      "checks": [
        "pdf2md"
      ]
    },
    {
      "paths": [
        "tools/publication/*"
      ],
      "checks": [
        "publication"
      ]
    },
    {
      "paths": [
        "tools/reporting/*"
      ],
      "checks": [
        "reporting"
      ]
    },
    {
      "paths": [
