{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chirality-workflow-catalog/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "library", "centralWorkflowNames", "navigation"],
  "properties": {
    "schema": {"const": "chirality-workflow-catalog/v1"},
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "sourceRootId"],
      "properties": {
        "source": {"enum": ["project", "user", "bundled"]},
        "sourceRootId": {"type": "string", "minLength": 1}
      }
    },
    "centralWorkflowNames": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "uniqueItems": true
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "specialist", "superseded"],
      "properties": {
        "core": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {"$ref": "#/$defs/workflowName"},
              "displayName": {"type": "string", "minLength": 1}
            }
          }
        },
        "specialist": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label", "workflows"],
            "properties": {
              "key": {"$ref": "#/$defs/workflowName"},
              "label": {"type": "string", "minLength": 1},
              "workflows": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name"],
                  "properties": {
                    "name": {"$ref": "#/$defs/workflowName"},
                    "tier": {"enum": ["primary", "supporting"]}
                  }
                }
              }
            }
          }
        },
        "superseded": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "replacedBy"],
            "properties": {
              "name": {"$ref": "#/$defs/workflowName"},
              "replacedBy": {"$ref": "#/$defs/workflowName"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "workflowName": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "minLength": 1, "maxLength": 64}
  }
}
