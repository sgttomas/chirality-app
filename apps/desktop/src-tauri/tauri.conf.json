{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chirality Dev",
  "version": "4.0.0-dev",
  "identifier": "com.chirality.app.dev",
  "build": {
    "beforeDevCommand": "npm run library && npm run codex && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run library && npm run codex && npm run build",
    "beforeBundleCommand": "npm run library && npm run codex",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chirality",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "library/library-v3.5.0/": "library/library-v3.5.0/",
      "codex/codex-0.171.0-aarch64-apple-darwin/": "codex/codex-0.171.0-aarch64-apple-darwin/",
      "../licenses/codex/LICENSE": "licenses/codex/LICENSE",
      "../licenses/codex/NOTICE": "licenses/codex/NOTICE",
      "../node_modules/@chirality/engine-ui/src/fonts/LICENSE-IBM-Plex-OFL.txt": "licenses/LICENSE-IBM-Plex-OFL.txt"
    }
  }
}
