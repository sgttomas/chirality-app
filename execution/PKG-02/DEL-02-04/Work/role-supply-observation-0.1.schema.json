{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:app-v4:del-02-04:role-supply-observation:0.1",
  "title": "App role supply observation log",
  "description": "Immutable observations grouped by stable supplyId, from actual App native request custody or an App pre-send refusal. A later correlated observation appends another row; prior rows remain exact. Quoted cold evidence never restores current role/CCE authority. Historical chirality.role.supply/0.2 remains a different format.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "observationId",
    "supplyId",
    "seq",
    "recordedAt",
    "prevLine",
    "trigger",
    "thread",
    "request",
    "selection",
    "outcome",
    "supplierReported",
    "lineage",
    "adoption",
    "project",
    "recorder"
  ],
  "properties": {
    "format": {
      "const": "chirality.role.supply.observation"
    },
    "formatVersion": {
      "const": "0.1"
    },
    "observationId": {
      "type": "string",
      "pattern": "^role-observation:v1:[0-9a-f-]{36}$"
    },
    "supplyId": {
      "type": "string",
      "pattern": "^sup:.+"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "recordedAt": {
      "type": "string",
      "minLength": 1
    },
    "prevLine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "const": "chirality.rs.line.sha256/v1"
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "method",
        "value"
      ]
    },
    "trigger": {
      "enum": [
        "thread-start",
        "fork"
      ]
    },
    "thread": {
      "type": [
        "string",
        "null"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "home": {
          "type": [
            "string",
            "null"
          ]
        },
        "generation": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "appSession": {
                  "type": "string",
                  "minLength": 1
                },
                "home": {
                  "type": "string",
                  "minLength": 1
                },
                "spawnCounter": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "appSession",
                "home",
                "spawnCounter"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "requestIdentity": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "requestRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "enum": [
            "thread/start",
            "thread/fork",
            null
          ]
        },
        "writeResult": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "sourceCurrent": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "home",
        "generation",
        "requestIdentity",
        "requestRef",
        "method",
        "writeResult",
        "outcome",
        "sourceCurrent"
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "HELP_HUMAN",
            "HELPS_HUMANS",
            "WORKING_ITEMS",
            "TASK",
            "none",
            "unknown"
          ]
        },
        "preselected": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "null means not established from the actual App entry choice"
        },
        "roleSet": {
          "oneOf": [
            {
              "$ref": "#/$defs/contentIdentity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "role",
        "preselected",
        "roleSet"
      ]
    },
    "outcome": {
      "enum": [
        "supplied",
        "inherited",
        "refused-before-send",
        "request-failed",
        "unknown"
      ]
    },
    "supplierReported": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instructionSources": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "agentRole": {
          "type": [
            "string",
            "null"
          ]
        },
        "forkedFromId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "instructionSources",
        "agentRole",
        "forkedFromId"
      ]
    },
    "lineage": {
      "type": "object"
    },
    "adoption": {
      "const": "unknown"
    },
    "carried": {
      "type": "object",
      "required": [
        "developerInstructions",
        "baseInstructions",
        "nativeChildRoles"
      ],
      "additionalProperties": false,
      "properties": {
        "compositionFormat": {
          "const": "chirality.role.compose/0.2"
        },
        "developerInstructions": {
          "type": "object",
          "required": [
            "content",
            "byteLength",
            "parts"
          ],
          "additionalProperties": false,
          "properties": {
            "content": {
              "$ref": "#/$defs/contentIdentity"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 1
            },
            "parts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/part"
              }
            }
          }
        },
        "baseInstructions": {
          "const": "not-set",
          "description": "R17-8: never set"
        },
        "nativeChildRoles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/childRole"
          }
        }
      }
    },
    "appBytes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "composed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "content": {
              "$ref": "#/$defs/contentIdentity"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "content",
            "byteLength"
          ]
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "content": {
                "$ref": "#/$defs/contentIdentity"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "content",
              "byteLength"
            ]
          }
        }
      },
      "required": [
        "composed",
        "parts"
      ]
    },
    "evidenceLimit": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectId",
        "sourceRoot",
        "device",
        "inode"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "sourceRoot": {
          "type": "object"
        },
        "device": {
          "type": "integer",
          "minimum": 0
        },
        "inode": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "recorder": {
      "const": "App DEL-02-04 role supply observer"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "carried"
        ]
      },
      "then": {
        "required": [
          "appBytes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "supplied",
              "inherited"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "thread": {
            "type": "string",
            "minLength": 1
          },
          "request": {
            "properties": {
              "generation": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "appSession": {
                    "type": "string",
                    "minLength": 1
                  },
                  "home": {
                    "type": "string",
                    "minLength": 1
                  },
                  "spawnCounter": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "appSession",
                  "home",
                  "spawnCounter"
                ]
              },
              "home": {
                "type": "string",
                "minLength": 1
              },
              "requestRef": {
                "type": "string",
                "minLength": 1
              },
              "writeResult": {
                "const": "written"
              },
              "outcome": {
                "const": "response-observed-result"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "supplied"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "carried",
          "appBytes"
        ],
        "properties": {
          "trigger": {
            "const": "thread-start"
          },
          "request": {
            "properties": {
              "method": {
                "const": "thread/start"
              }
            }
          },
          "selection": {
            "properties": {
              "role": {
                "enum": [
                  "HELP_HUMAN",
                  "HELPS_HUMANS",
                  "WORKING_ITEMS",
                  "TASK",
                  "none"
                ]
              },
              "roleSet": {
                "$ref": "#/$defs/contentIdentity"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "inherited"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "trigger": {
            "const": "fork"
          },
          "request": {
            "properties": {
              "method": {
                "const": "thread/fork"
              }
            }
          },
          "selection": {
            "properties": {
              "role": {
                "enum": [
                  "HELP_HUMAN",
                  "HELPS_HUMANS",
                  "WORKING_ITEMS",
                  "TASK",
                  "none"
                ]
              }
            }
          },
          "lineage": {
            "required": [
              "inheritedFrom"
            ],
            "properties": {
              "inheritedFrom": {
                "type": "string",
                "pattern": "^sup:.+"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "guidanceSource": {
      "oneOf": [
        {
          "$ref": "#/$defs/seededGuidanceSource"
        },
        {
          "$ref": "#/$defs/editableGuidanceSource"
        }
      ]
    },
    "editableGuidanceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store",
        "path",
        "reviewedDefault",
        "state",
        "seedHistory"
      ],
      "properties": {
        "store": {
          "const": "editable-copy"
        },
        "path": {
          "type": "string",
          "pattern": "^(AGENTS\\.md|agents/AGENT_(HELP_HUMAN|HELPS_HUMANS|WORKING_ITEMS|TASK)\\.md)$"
        },
        "reviewedDefault": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release",
            "content"
          ],
          "properties": {
            "release": {
              "type": "string",
              "minLength": 1
            },
            "content": {
              "$ref": "#/$defs/contentIdentity"
            }
          }
        },
        "state": {
          "enum": [
            "default",
            "modified"
          ]
        },
        "seedHistory": {
          "$ref": "#/$defs/seedHistory"
        }
      }
    },
    "seedHistory": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "unestablished"
            },
            "reason": {
              "enum": [
                "missing",
                "invalid",
                "unreadable",
                "changed",
                "preserved-path"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "standing",
            "record",
            "release",
            "defaultContent",
            "matchesSuppliedContent"
          ],
          "properties": {
            "status": {
              "const": "declared"
            },
            "standing": {
              "const": "mutable seed-record declaration; creation custody not authenticated"
            },
            "record": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "content"
              ],
              "properties": {
                "path": {
                  "const": ".seed-record.json"
                },
                "content": {
                  "$ref": "#/$defs/contentIdentity"
                }
              }
            },
            "release": {
              "type": "string",
              "minLength": 1
            },
            "defaultContent": {
              "$ref": "#/$defs/contentIdentity"
            },
            "matchesSuppliedContent": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "contentIdentity": {
      "description": "Same shape as RS-v0.8 contentIdentity. Method designation required; the algorithm is open (HOSTING U-08).",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "method",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "notObtainable",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "notObtainable": {
              "const": true
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "seededGuidanceSource": {
      "type": "object",
      "required": [
        "store",
        "path",
        "release",
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "store": {
          "enum": [
            "seeded-copy"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(AGENTS\\.md|agents/AGENT_(HELP_HUMAN|HELPS_HUMANS|WORKING_ITEMS|TASK)\\.md)$"
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "description": "App release whose default was seeded"
        },
        "state": {
          "enum": [
            "default",
            "modified"
          ]
        },
        "defaultContent": {
          "$ref": "#/$defs/contentIdentity",
          "description": "The shipped default's identity, for comparison"
        }
      }
    },
    "part": {
      "type": "object",
      "required": [
        "kind",
        "source",
        "content",
        "offset",
        "length"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "product-guidance",
            "role-guidance"
          ],
          "description": "No workflow part (R19-1, R19-7)"
        },
        "role": {
          "enum": [
            "HELP_HUMAN",
            "HELPS_HUMANS",
            "WORKING_ITEMS",
            "TASK"
          ]
        },
        "source": {
          "$ref": "#/$defs/guidanceSource"
        },
        "content": {
          "$ref": "#/$defs/contentIdentity"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Byte offset of the part in the UTF-8 composed text"
        },
        "length": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "role-guidance"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "role"
            ]
          }
        }
      ]
    },
    "childRole": {
      "type": "object",
      "required": [
        "role",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "HELP_HUMAN",
            "HELPS_HUMANS",
            "WORKING_ITEMS",
            "TASK"
          ]
        },
        "status": {
          "enum": [
            "supplied",
            "not-supplied"
          ]
        },
        "configKeys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^agents\\.(HELP_HUMAN|HELPS_HUMANS|WORKING_ITEMS|TASK)\\.(description|config_file)$"
          }
        },
        "composed": {
          "$ref": "#/$defs/contentIdentity",
          "description": "Identity of the child's developer_instructions text (product guidance + role); it replaces the parent's for the child (OBS-2 O-4a, through an adapter)"
        },
        "file": {
          "$ref": "#/$defs/contentIdentity",
          "description": "Identity of the role configuration file the key names"
        },
        "reason": {
          "enum": [
            "user-configuration-defines-role",
            "not-offered-by-role",
            "mechanism-not-supported-at-pin",
            "user-configuration-not-read"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "supplied"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "configKeys",
              "composed",
              "file"
            ],
            "not": {
              "required": [
                "reason"
              ]
            }
          },
          "else": {
            "required": [
              "reason"
            ],
            "not": {
              "required": [
                "configKeys"
              ]
            }
          }
        }
      ]
    }
  }
}
