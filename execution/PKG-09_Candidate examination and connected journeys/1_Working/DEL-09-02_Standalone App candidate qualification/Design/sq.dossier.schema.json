{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:app-v4:del-09-02:standalone-dossier:0.1",
  "title": "Standalone qualification dossier (DEL-09-02 SQ-v0.1 §5; OUT-002; PROPOSED)",
  "description": "One dossier per identified App candidate. It indexes the three named scenarios (V4-EXM-10, V4-EXM-11 inside the same run, V4-EXM-12) step by step; each step points to DEL-09-01 EXP result records and to the supplier feature cases it joins, never copying them. Outcomes are EXP's (HOSTING §9.3 labels). Rules beyond the schema: SQ-R1…SQ-R6 in prototype/check_sq.py.",
  "type": "object",
  "required": ["record_kind", "format", "record_id", "support_revision", "candidate", "integration_owner", "examiner", "scenarios", "handoff", "currency", "date"],
  "additionalProperties": false,
  "properties": {
    "record_kind": { "const": "sq_dossier" },
    "format": { "const": "SQ-v0.1" },
    "record_id": { "type": "string", "minLength": 1 },
    "support_revision": { "type": "string", "pattern": "^EXP-v[0-9]+\\.[0-9]+$" },
    "candidate": {
      "type": "object",
      "required": ["revision", "build_identity", "codex_pin"],
      "additionalProperties": false,
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "build_identity": { "type": "string", "minLength": 1 },
        "codex_pin": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "package_record": { "type": "string", "minLength": 1, "description": "DEL-01-06 package identity record, when the native steps ran on a package." }
      }
    },
    "integration_owner": { "type": "string", "minLength": 1, "description": "App workflow-experience integration owner (CLM-004)." },
    "examiner": {
      "type": "object",
      "required": ["identity", "separation"],
      "additionalProperties": false,
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "separation": { "enum": ["separate_person", "separate_session_no_authoring", "not_separate"] },
        "review_record": { "type": "string", "minLength": 1, "description": "EXP review record (VER-007)." }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    },
    "handoff": {
      "type": "object",
      "required": ["to", "supplies", "not_claimed"],
      "additionalProperties": false,
      "properties": {
        "to": { "const": "DEL-11-03" },
        "supplies": {
          "type": "array",
          "items": { "enum": ["scenario_outcomes", "evidence_limits", "input_gaps", "v3_comparison_inputs", "affected_rechecks"] }
        },
        "not_claimed": {
          "type": "array",
          "items": { "enum": ["joined_host_witness", "replacement", "public_release", "retirement", "professional_reliance", "practitioner_validation"] },
          "description": "SQ-R5: all six must be listed."
        }
      }
    },
    "currency": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": { "enum": ["current", "historical", "reopened"] },
        "change_ref": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "state": { "enum": ["historical", "reopened"] } } },
      "then": { "required": ["change_ref"] }
    },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" }
  },
  "$defs": {
    "outcome": { "enum": ["pass", "fail", "blocked", "not-run", "inconclusive"] },
    "scenario": {
      "type": "object",
      "required": ["scenario", "run_ref", "steps", "outcome"],
      "additionalProperties": false,
      "properties": {
        "scenario": { "enum": ["V4-EXM-10", "V4-EXM-11", "V4-EXM-12"] },
        "run_ref": { "type": "string", "minLength": 1, "description": "The joined run. V4-EXM-11's must equal V4-EXM-10's (SQ-R2)." },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
        "access_modes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "home", "conversation_ref"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["chatgpt_account", "api_key", "local_provider"] },
              "home": { "enum": ["H-acct", "H-key"] },
              "conversation_ref": { "type": "string", "minLength": 1 }
            }
          }
        },
        "outcome": { "$ref": "#/$defs/outcome" }
      },
      "if": { "properties": { "scenario": { "const": "V4-EXM-12" } } },
      "then": { "required": ["access_modes"] }
    },
    "step": {
      "type": "object",
      "required": ["step", "state", "supplier_cases"],
      "additionalProperties": false,
      "properties": {
        "step": { "type": "string", "pattern": "^(J-[1-9]|S11-[1-6]|M12-[1-6])$" },
        "state": { "enum": ["designed", "awaiting_input", "held", "recorded"] },
        "result_record": { "type": "string", "minLength": 1, "description": "EXP result record id." },
        "outcome": { "$ref": "#/$defs/outcome" },
        "missing_input": { "type": "string", "minLength": 1 },
        "supplier_cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["deliverable", "file", "case_id"],
            "additionalProperties": false,
            "properties": {
              "deliverable": { "type": "string", "pattern": "^DEL-[0-9]{2}-[0-9]{2}$" },
              "file": { "type": "string", "minLength": 1, "description": "The supplier's Design file name: case ids are file-qualified (e.g. VC-01 exists in more than one file)." },
              "case_id": { "type": "string", "minLength": 1 },
              "result_ref": { "type": "string", "minLength": 1, "description": "The supplier's own candidate-bound result, when it exists." }
            }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "state": { "const": "recorded" } } }, "then": { "required": ["result_record", "outcome"] } },
        { "if": { "properties": { "state": { "enum": ["awaiting_input", "held"] } } }, "then": { "required": ["missing_input"] } }
      ]
    }
  }
}
