{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:app-v4:del-01-04:nir:draft-transition:0.2",
  "title": "Draft transition, as DEL-01-04 receives it (PROPOSED receiving requirement, DEL-01-04/NIR-v0.2 §7)",
  "description": "PROPOSED by DEL-01-04/NIR-v0.2 (R17-1; OUT-004, REQ-004). DEL-02-02 owns the transition and its format: WR §5.1 and `workspace-registration.schema.json` $defs/draft_transition (node D5). This schema restates that shape with D5's own element names and values, and the two optional elements R18-1 (C-02) has D5 add on the events 'registered' and 'registration not completed': 'a15_record' (the RS A15 record the App act control wrote at capture, K-8) and 'revision'. Read side (NIR §7): DEL-01-04 takes them from the transition when present, otherwise from WR's library_entry for the same draft, and shows 'registered' only when the A15 record is known from one of the two. Per R17-11 an A15's relations are the reviewed draft and the prior revision; WD's derived-from is not carried here.",
  "type": "object",
  "required": [
    "record_kind",
    "event",
    "draft",
    "from",
    "to",
    "cause",
    "time",
    "attribution"
  ],
  "additionalProperties": false,
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "content_identity": {
      "type": "object",
      "required": [
        "method",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "$ref": "#/$defs/text"
        },
        "value": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "draft_state": {
      "enum": [
        "absent",
        "draft",
        "not valid",
        "under review",
        "changed since review",
        "registered, unchanged since",
        "removed"
      ]
    }
  },
  "properties": {
    "record_kind": {
      "const": "draft_transition"
    },
    "event": {
      "enum": [
        "written",
        "changed",
        "review shown",
        "review stale",
        "registration refused",
        "registered",
        "registration not completed",
        "removed"
      ]
    },
    "draft": {
      "type": "object",
      "required": [
        "draft_location",
        "draft_root",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "draft_location": {
          "enum": [
            "project",
            "user"
          ]
        },
        "draft_root": {
          "$ref": "#/$defs/text"
        },
        "name": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "content": {
      "$ref": "#/$defs/content_identity"
    },
    "from": {
      "$ref": "#/$defs/draft_state"
    },
    "to": {
      "$ref": "#/$defs/draft_state"
    },
    "disposition": {
      "enum": [
        "new workflow",
        "new revision",
        "in place",
        "refused: name taken",
        "refused: identical content",
        "refused: draft not valid",
        "refused: changed since review",
        "refused: slot moved on"
      ]
    },
    "cause": {
      "$ref": "#/$defs/text"
    },
    "time": {
      "$ref": "#/$defs/text"
    },
    "attribution": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "file change item",
            "app action",
            "not observed"
          ]
        },
        "thread": {
          "$ref": "#/$defs/text"
        },
        "item": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "a15_record": {
      "type": "string",
      "pattern": "^rec:",
      "description": "Optional (C-02): the RS human_act A15 record the App act control wrote."
    },
    "revision": {
      "$ref": "#/$defs/text",
      "description": "Optional (C-02): the registered revision identity."
    }
  },
  "allOf": [
    {
      "description": "Content is carried where the draft's content is what changed or was reviewed.",
      "anyOf": [
        {
          "properties": {
            "event": {
              "not": {
                "enum": [
                  "written",
                  "changed",
                  "review shown",
                  "registered"
                ]
              }
            }
          }
        },
        {
          "required": [
            "content"
          ]
        }
      ]
    },
    {
      "description": "'registered' ends in 'registered, unchanged since' with a registering disposition; the A15 record may come from the transition or from library_entry (C-02).",
      "anyOf": [
        {
          "properties": {
            "event": {
              "not": {
                "const": "registered"
              }
            }
          }
        },
        {
          "required": [
            "disposition"
          ],
          "properties": {
            "to": {
              "const": "registered, unchanged since"
            },
            "disposition": {
              "enum": [
                "new workflow",
                "new revision",
                "in place"
              ]
            }
          }
        }
      ]
    },
    {
      "description": "A refusal carries its disposition (K-6: 'refused: name taken' asks for a new name).",
      "anyOf": [
        {
          "properties": {
            "event": {
              "not": {
                "const": "registration refused"
              }
            }
          }
        },
        {
          "required": [
            "disposition"
          ],
          "properties": {
            "disposition": {
              "enum": [
                "refused: name taken",
                "refused: identical content",
                "refused: draft not valid",
                "refused: changed since review",
                "refused: slot moved on"
              ]
            }
          }
        }
      ]
    }
  ]
}
