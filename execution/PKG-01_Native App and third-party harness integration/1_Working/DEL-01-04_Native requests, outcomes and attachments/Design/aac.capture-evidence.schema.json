{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:app-v4:del-01-04:aac:capture-evidence:0.2",
  "title": "App act control capture evidence (PROPOSED, DEL-01-04/AAC-v0.2 §5.2)",
  "description": "PROPOSED by DEL-01-04/AAC-v0.2 (R17-1, R17-6). The capture-evidence object EXEC CAP-3 names: {act identity, actor, act kind, bound content identity with method designation, scope, purpose, time, capturing surface 'App interface', arrival reference}. Produced on the capture side only from the person's native confirmation of a presented offer (CAP-4; R17-5 PROPOSED); DEL-04-03's human_act or act_declined record cites it by 'captureId' (RS §6.1; RS §9). The actor is named from what the App observes, never verified (DECISION-K1 K1-4; EXEC CAP-8); 'codexAccount' is the reported email or 'ChatGPT account (no email reported)', and no plan type is recorded (R18-1 C-10). An A15 capture lists its entries (DECISION-L L-4), each with the workspace's descriptor, the revision, the reviewed draft (WR ID-3 string and content) and the prior revision (RS workflowTuple or null) (R17-11; R18-1 C-01), and, once DEL-02-02 reports it, that entry's registration outcome beside the act, never part of it (AAC AK-f). 'seal' is SEAL-2's optional provenance element (AAC §6.3).",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "captureId",
    "offerId",
    "offerDigest",
    "choice",
    "actKind",
    "actor",
    "boundSubject",
    "boundContent",
    "scope",
    "purpose",
    "capturedAt",
    "surface",
    "inputSource",
    "answers",
    "evidenceLimits"
  ],
  "additionalProperties": false,
  "$defs": {
    "contentIdentity": {
      "type": "object",
      "required": [
        "method",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workflowTuple": {
      "description": "RS $defs/workflowTuple (RS-v0.8; WD §6.1 identity tuple in RS's spelling), copied here so the schema stands alone; C-01 makes RS's the persisted form.",
      "type": "object",
      "required": [
        "kind",
        "origin",
        "sourceRoot",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "workflow"
        },
        "origin": {
          "enum": [
            "project",
            "user",
            "bundled",
            "host"
          ]
        },
        "sourceRoot": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "revisionMethod": {
          "type": "string",
          "minLength": 1
        },
        "derivedFrom": {
          "$ref": "#/$defs/workflowTuple"
        }
      }
    },
    "reviewedDraft": {
      "type": "object",
      "required": [
        "draft",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "draft": {
          "type": "string",
          "pattern": "^draft:(project|user):[^@]+@.+$",
          "description": "WR ID-3 string draft:<location>:<name>@<content identity> (C-01)."
        },
        "content": {
          "$ref": "#/$defs/contentIdentity"
        }
      }
    },
    "priorRevision": {
      "anyOf": [
        {
          "$ref": "#/$defs/workflowTuple"
        },
        {
          "type": "null"
        }
      ],
      "description": "The revision this one follows (K-6) as an RS workflowTuple, or null for a first revision (C-01)."
    }
  },
  "properties": {
    "format": {
      "const": "chirality.aac.capture-evidence"
    },
    "formatVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "captureId": {
      "type": "string",
      "pattern": "^cap:"
    },
    "offerId": {
      "type": "string",
      "pattern": "^offer:"
    },
    "offerDigest": {
      "$ref": "#/$defs/contentIdentity"
    },
    "choice": {
      "enum": [
        "act",
        "decline"
      ]
    },
    "actKind": {
      "enum": [
        "A4",
        "A6",
        "A7",
        "A15"
      ]
    },
    "actor": {
      "type": "object",
      "required": [
        "identityVerified"
      ],
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "osAccount": {
          "type": "string",
          "minLength": 1
        },
        "codexAccount": {
          "type": "string",
          "minLength": 1
        },
        "identityVerified": {
          "const": false
        }
      },
      "anyOf": [
        {
          "required": [
            "displayName"
          ]
        },
        {
          "required": [
            "osAccount"
          ]
        },
        {
          "required": [
            "codexAccount"
          ]
        }
      ]
    },
    "boundSubject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "boundContent": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/contentIdentity"
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "capturedAt": {
      "type": "string",
      "minLength": 1
    },
    "surface": {
      "const": "App interface"
    },
    "inputSource": {
      "const": "host-native-confirmation"
    },
    "answers": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "arrival",
            "runId"
          ],
          "additionalProperties": false,
          "properties": {
            "arrival": {
              "type": "object",
              "required": [
                "checkpoint",
                "arrivalOrdinal"
              ],
              "additionalProperties": false,
              "properties": {
                "checkpoint": {
                  "type": "string",
                  "minLength": 1
                },
                "arrivalOrdinal": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "runId": {
              "type": "string",
              "pattern": "^run:"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "standing"
          ],
          "additionalProperties": false,
          "properties": {
            "standing": {
              "const": "no arrival: a standing act (RC-6)"
            }
          }
        }
      ]
    },
    "requestRef": {
      "type": "string",
      "pattern": "^rec:"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "descriptorId",
          "revision",
          "reviewedDraft",
          "priorRevision"
        ],
        "additionalProperties": false,
        "properties": {
          "descriptorId": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "reviewedDraft": {
            "$ref": "#/$defs/reviewedDraft"
          },
          "priorRevision": {
            "$ref": "#/$defs/priorRevision"
          },
          "outcome": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "registration",
                  "revisionIdentity"
                ],
                "additionalProperties": false,
                "properties": {
                  "registration": {
                    "const": "completed"
                  },
                  "revisionIdentity": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "registration",
                  "reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "registration": {
                    "const": "not completed"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      }
    },
    "recordId": {
      "type": "string",
      "pattern": "^rec:"
    },
    "evidenceLimits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "seal": {
      "$ref": "#/$defs/contentIdentity"
    }
  },
  "allOf": [
    {
      "description": "A decline exists only where ACT §2.3 defines an act-declined event.",
      "anyOf": [
        {
          "properties": {
            "choice": {
              "const": "act"
            }
          }
        },
        {
          "properties": {
            "actKind": {
              "enum": [
                "A4",
                "A6",
                "A7"
              ]
            }
          }
        }
      ]
    },
    {
      "description": "A15 lists its entries (L-4; R17-11; C-01).",
      "anyOf": [
        {
          "properties": {
            "actKind": {
              "not": {
                "const": "A15"
              }
            }
          }
        },
        {
          "required": [
            "entries"
          ]
        }
      ]
    },
    {
      "description": "Entries belong to A15 only.",
      "anyOf": [
        {
          "properties": {
            "actKind": {
              "const": "A15"
            }
          }
        },
        {
          "not": {
            "required": [
              "entries"
            ]
          }
        }
      ]
    }
  ]
}
