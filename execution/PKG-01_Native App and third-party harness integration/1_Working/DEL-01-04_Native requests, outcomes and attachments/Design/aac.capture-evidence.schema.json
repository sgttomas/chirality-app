{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:app-v4:del-01-04:aac:capture-evidence:0.1",
  "title": "App act control capture evidence (PROPOSED, DEL-01-04/AAC-v0.1 §5.2)",
  "description": "PROPOSED by DEL-01-04/AAC-v0.1 (R17-1, R17-6). The capture-evidence object EXEC CAP-3 names: {act identity, actor, act kind, bound content identity with method designation, scope, purpose, time, capturing surface 'App interface', arrival reference}. It is produced on the capture side only from the person's native confirmation of a presented offer (CAP-4; R17-5 PROPOSED), and DEL-04-03's human_act or act_declined record cites it by 'captureId' (RS §6.1 'Capture evidence references'; RS §9). The actor is named from what the App observes, never verified (DECISION-K1 K1-4; EXEC CAP-8). For A15 the subject is named by the reviewed draft ('reviewedDraft') and, for a new revision, the prior revision ('priorRevision') (R17-11; 'derived-from' stays WD's parent-workflow relation); the capture carries DEL-02-02's descriptor identity, and the registration's outcome, which DEL-02-02 reports after the act is recorded, is carried beside it, never as part of the act (AAC §4.2; AK-f). 'seal' is the PROPOSED provenance element of AAC §6.3 (SEAL-2); it is optional at 0.1.",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "captureId",
    "offerId",
    "offerDigest",
    "choice",
    "actKind",
    "actor",
    "boundSubject",
    "boundContent",
    "scope",
    "purpose",
    "capturedAt",
    "surface",
    "inputSource",
    "answers",
    "evidenceLimits"
  ],
  "additionalProperties": false,
  "$defs": {
    "contentIdentity": {
      "type": "object",
      "required": [
        "method",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "properties": {
    "format": {
      "const": "chirality.aac.capture-evidence"
    },
    "formatVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "captureId": {
      "type": "string",
      "pattern": "^cap:"
    },
    "offerId": {
      "type": "string",
      "pattern": "^offer:"
    },
    "offerDigest": {
      "$ref": "#/$defs/contentIdentity"
    },
    "choice": {
      "enum": [
        "act",
        "decline"
      ]
    },
    "actKind": {
      "enum": [
        "A4",
        "A6",
        "A7",
        "A15"
      ]
    },
    "actor": {
      "type": "object",
      "required": [
        "identityVerified"
      ],
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "osAccount": {
          "type": "string",
          "minLength": 1
        },
        "codexAccount": {
          "type": "string",
          "minLength": 1
        },
        "identityVerified": {
          "const": false
        }
      },
      "anyOf": [
        {
          "required": [
            "displayName"
          ]
        },
        {
          "required": [
            "osAccount"
          ]
        },
        {
          "required": [
            "codexAccount"
          ]
        }
      ]
    },
    "boundSubject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "boundContent": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/contentIdentity"
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "capturedAt": {
      "type": "string",
      "minLength": 1
    },
    "surface": {
      "const": "App interface"
    },
    "inputSource": {
      "const": "host-native-confirmation"
    },
    "answers": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "arrival",
            "runId"
          ],
          "additionalProperties": false,
          "properties": {
            "arrival": {
              "type": "object",
              "required": [
                "checkpoint",
                "arrivalOrdinal"
              ],
              "additionalProperties": false,
              "properties": {
                "checkpoint": {
                  "type": "string",
                  "minLength": 1
                },
                "arrivalOrdinal": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "runId": {
              "type": "string",
              "pattern": "^run:"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "standing"
          ],
          "additionalProperties": false,
          "properties": {
            "standing": {
              "const": "no arrival: a standing act (RC-6)"
            }
          }
        }
      ]
    },
    "requestRef": {
      "type": "string",
      "pattern": "^rec:"
    },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "registration",
            "revisionIdentity"
          ],
          "additionalProperties": false,
          "properties": {
            "registration": {
              "const": "completed"
            },
            "revisionIdentity": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "registration",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "registration": {
              "const": "not completed"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "recordId": {
      "type": "string",
      "pattern": "^rec:",
      "description": "The RS record that cites this capture, once written."
    },
    "evidenceLimits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "seal": {
      "$ref": "#/$defs/contentIdentity"
    },
    "descriptorId": {
      "type": "string",
      "minLength": 1
    },
    "reviewedDraft": {
      "type": "object",
      "required": [
        "draft",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "draft": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "$ref": "#/$defs/contentIdentity"
        }
      }
    },
    "priorRevision": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "description": "A decline exists only where ACT §2.3 defines an act-declined event (A4, A6, A7, A12; A12 is not served in this increment).",
      "anyOf": [
        {
          "properties": {
            "choice": {
              "const": "act"
            }
          }
        },
        {
          "properties": {
            "actKind": {
              "enum": [
                "A4",
                "A6",
                "A7"
              ]
            }
          }
        }
      ]
    },
    {
      "description": "A15 names its subject by the reviewed draft and the prior revision (R17-11) and cites the workspace's descriptor.",
      "anyOf": [
        {
          "properties": {
            "actKind": {
              "not": {
                "const": "A15"
              }
            }
          }
        },
        {
          "required": [
            "descriptorId",
            "reviewedDraft",
            "priorRevision"
          ]
        }
      ]
    }
  ]
}
