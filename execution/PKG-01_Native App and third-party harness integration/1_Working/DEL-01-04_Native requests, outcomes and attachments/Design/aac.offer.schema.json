{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:app-v4:del-01-04:aac:offer:0.2",
  "title": "App act control offer (PROPOSED, DEL-01-04/AAC-v0.2 §5.1)",
  "description": "PROPOSED by DEL-01-04/AAC-v0.2 (R17-1, R17-6); the act control is PROPOSED until SCA-V4-003 carries SC2-01-04-1 as amended (SC3-01-04-1). One offer presents one act kind (EXEC CAP-2). For A4, A6, A7 it presents one subject whose content identity is fixed when the offer is composed. For A15 it presents one or more entries (DECISION-L L-4: several entries in one registration act), each composed from one of DEL-02-02's A15 descriptors (WR-v0.1 RB-4) and each with its own bound bytes (K-8); the person's confirmation is accepted only while every entry still has those bytes and every descriptor is current. Each A15 entry names its subject by the reviewed draft (WR ID-3 string and content identity) and the prior revision (RS workflowTuple or null), the persisted form R18-1 C-01 gives RS; 'derived-from' stays WD's parent-workflow relation and is not carried. The offer is composed on the capture side from authoritative sources, never from agent text (R17-5, PROPOSED). Wording follows ACT §9. Decline only where ACT §2.3 defines an act-declined event.",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "offerId",
    "actKind",
    "wording",
    "scope",
    "purpose",
    "actorRequirement",
    "declineAvailable",
    "answers",
    "composedAt",
    "offerDigest"
  ],
  "additionalProperties": false,
  "$defs": {
    "contentIdentity": {
      "type": "object",
      "required": [
        "method",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workflowTuple": {
      "description": "RS $defs/workflowTuple (RS-v0.8; WD §6.1 identity tuple in RS's spelling), copied here so the schema stands alone; C-01 makes RS's the persisted form.",
      "type": "object",
      "required": [
        "kind",
        "origin",
        "sourceRoot",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "workflow"
        },
        "origin": {
          "enum": [
            "project",
            "user",
            "bundled",
            "host"
          ]
        },
        "sourceRoot": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "revisionMethod": {
          "type": "string",
          "minLength": 1
        },
        "derivedFrom": {
          "$ref": "#/$defs/workflowTuple"
        }
      }
    },
    "reviewedDraft": {
      "type": "object",
      "required": [
        "draft",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "draft": {
          "type": "string",
          "pattern": "^draft:(project|user):[^@]+@.+$",
          "description": "WR ID-3 string draft:<location>:<name>@<content identity> (C-01)."
        },
        "content": {
          "$ref": "#/$defs/contentIdentity"
        }
      }
    },
    "priorRevision": {
      "anyOf": [
        {
          "$ref": "#/$defs/workflowTuple"
        },
        {
          "type": "null"
        }
      ],
      "description": "The revision this one follows (K-6) as an RS workflowTuple, or null for a first revision (C-01)."
    }
  },
  "properties": {
    "format": {
      "const": "chirality.aac.offer"
    },
    "formatVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "offerId": {
      "type": "string",
      "pattern": "^offer:"
    },
    "actKind": {
      "enum": [
        "A4",
        "A6",
        "A7",
        "A15"
      ]
    },
    "wording": {
      "enum": [
        "mark checked",
        "approve (engineering approval)",
        "rely (professional reliance)",
        "register workflow revision"
      ]
    },
    "subject": {
      "type": "object",
      "required": [
        "class",
        "ref",
        "contentIdentity"
      ],
      "additionalProperties": false,
      "properties": {
        "class": {
          "const": "App file"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "contentIdentity": {
          "$ref": "#/$defs/contentIdentity"
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "descriptorId",
          "subject",
          "reviewedDraft",
          "priorRevision"
        ],
        "additionalProperties": false,
        "properties": {
          "descriptorId": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "object",
            "required": [
              "ref",
              "contentIdentity"
            ],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "description": "The target revision the workspace's descriptor names."
              },
              "contentIdentity": {
                "$ref": "#/$defs/contentIdentity"
              }
            }
          },
          "reviewedDraft": {
            "$ref": "#/$defs/reviewedDraft"
          },
          "priorRevision": {
            "$ref": "#/$defs/priorRevision"
          }
        }
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "actorRequirement": {
      "type": "string",
      "minLength": 1
    },
    "declineAvailable": {
      "type": "boolean"
    },
    "answers": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "arrival",
            "runId"
          ],
          "additionalProperties": false,
          "properties": {
            "arrival": {
              "type": "object",
              "required": [
                "checkpoint",
                "arrivalOrdinal"
              ],
              "additionalProperties": false,
              "properties": {
                "checkpoint": {
                  "type": "string",
                  "minLength": 1
                },
                "arrivalOrdinal": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "runId": {
              "type": "string",
              "pattern": "^run:"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "standing"
          ],
          "additionalProperties": false,
          "properties": {
            "standing": {
              "const": "no arrival: a standing act (RC-6)"
            }
          }
        }
      ]
    },
    "requestRef": {
      "type": "string",
      "pattern": "^rec:"
    },
    "composedAt": {
      "type": "string",
      "minLength": 1
    },
    "offerDigest": {
      "$ref": "#/$defs/contentIdentity"
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "properties": {
            "actKind": {
              "not": {
                "const": "A4"
              }
            }
          }
        },
        {
          "required": [
            "subject"
          ],
          "properties": {
            "wording": {
              "const": "mark checked"
            },
            "declineAvailable": {
              "const": true
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "properties": {
            "actKind": {
              "not": {
                "const": "A6"
              }
            }
          }
        },
        {
          "required": [
            "subject"
          ],
          "properties": {
            "wording": {
              "const": "approve (engineering approval)"
            },
            "declineAvailable": {
              "const": true
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "properties": {
            "actKind": {
              "not": {
                "const": "A7"
              }
            }
          }
        },
        {
          "required": [
            "subject"
          ],
          "properties": {
            "wording": {
              "const": "rely (professional reliance)"
            },
            "declineAvailable": {
              "const": true
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "properties": {
            "actKind": {
              "not": {
                "const": "A15"
              }
            }
          }
        },
        {
          "required": [
            "entries"
          ],
          "not": {
            "required": [
              "subject"
            ]
          },
          "properties": {
            "wording": {
              "const": "register workflow revision"
            },
            "declineAvailable": {
              "const": false
            }
          }
        }
      ]
    },
    {
      "description": "Entries belong to A15 only.",
      "anyOf": [
        {
          "properties": {
            "actKind": {
              "const": "A15"
            }
          }
        },
        {
          "not": {
            "required": [
              "entries"
            ]
          }
        }
      ]
    }
  ]
}
