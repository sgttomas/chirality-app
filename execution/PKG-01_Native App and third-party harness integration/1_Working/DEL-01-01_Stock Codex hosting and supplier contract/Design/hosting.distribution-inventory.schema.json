{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:app-v4:del-01-01:distribution-inventory:1.0",
  "title": "CC-HOSTING-DISTRIBUTION-01 candidate inventory value; no qualification standing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "method",
    "algorithm",
    "manifest_sha256",
    "entries"
  ],
  "properties": {
    "method": {
      "const": "codex-vendor-tree-v1"
    },
    "algorithm": {
      "const": "sha-256"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "kind",
              "mode"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Exact relative UTF-8 path; semantic checks enforce components, uniqueness and parent directories. Root is dot, directory only."
              },
              "mode": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4095,
                "description": "POSIX st_mode & 07777; decimal representation."
              },
              "kind": {
                "const": "dir"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "kind",
              "mode",
              "size",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Exact relative UTF-8 path; semantic checks enforce components, uniqueness and parent directories. Root is dot, directory only."
              },
              "mode": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4095,
                "description": "POSIX st_mode & 07777; decimal representation."
              },
              "kind": {
                "const": "file"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        ]
      }
    }
  }
}
