+        if !supply_ref.starts_with("sup:") || supply_ref.len() <= 4 {
+            return Err(Refusal::Origin);
+        }
+        Ok(Self {
+            supply_ref: boxed(supply_ref)?,
+            role,
+            guidance: hash(&c.text),
+            common: hash(piece(0)?),
+            role_text: hash(piece(1)?),
+            definition: digest(&d)?,
