+fn source_matches(committed: &[u8], compiled: &[u8]) -> Result<(), String> {
+    if committed != compiled {
+        Err("compiled exporter/Host source differs from clean revision; rebuild harness".into())
+    } else {
+        Ok(())
+    }
+}
+fn marker_for(dirty: bool, diagnostic: bool) -> Result<&'static str, String> {
+    if dirty && !diagnostic {
+        return Err("dirty harness cannot issue completed exchange".into());
+    }
+    Ok(if dirty {
+        "exchange.diagnostic.json"
+    } else {
+        "exchange.json"
+    })
+}
+fn inputs() -> Result<(Value, Value, bool), String> {
+    let git = |args: &[&str]| -> Result<Vec<u8>, String> {
+        let o = std::process::Command::new("git")
+            .args(args)
+            .current_dir(env!("CARGO_MANIFEST_DIR"))
+            .output()
+            .map_err(err)?;
+        if !o.status.success() {
+            return Err("git identity unavailable".into());
+        }
+        Ok(o.stdout)
+    };
+    let revision = String::from_utf8(git(&["rev-parse", "HEAD"])?)
+        .map_err(err)?
+        .trim()
+        .to_owned();
+    let dirty = !git(&["status", "--porcelain", "--untracked-files=normal"])?.is_empty();
+    if !dirty {
+        for (path, compiled) in compiled_sources() {
+            let committed = git(&[
+                "show",
+                &format!("HEAD:projects/chirality-app-v4/app/src-tauri/src/{path}"),
+            ])?;
+            source_matches(&committed, compiled)?;
+            source_matches(
+                &fs::read(Path::new(env!("CARGO_MANIFEST_DIR")).join("src").join(path))
+                    .map_err(err)?,
+                compiled,
+            )?;
+        }
+    }
+    let mut features = vec![];
+    if cfg!(feature = "custom-protocol") {
+        features.push("custom-protocol");
+    }
+    if cfg!(feature = "distribution-successor") {
+        features.push("distribution-successor");
+    }
+    Ok((
+        json!({"sourceRevision":revision,"harnessExecutableSha256":tree::digest(&fs::read(std::env::current_exe().map_err(err)?).map_err(err)?),"command":std::env::args().collect::<Vec<_>>(),"features":features,"kind":"synthetic-host-test"}),
+        json!({"revision":"INVENTED-S4-APP-REVISION","buildIdentity":"INVENTED-S4-APP-BUILD","standing":"invented-consumer-fixture"}),
+        dirty,
+    ))
+}
