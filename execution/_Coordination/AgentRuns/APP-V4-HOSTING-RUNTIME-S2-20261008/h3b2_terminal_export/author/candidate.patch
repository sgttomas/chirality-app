+    );
+    assert!(export(
+        &h,
+        &c,
+        &data,
+        Some(&copy.path),
+        &f.root.join("refused"),
+        p,
+        a,
+        "exchange.json",
+        || {}
+    )
+    .is_err());
+    assert!(!f.root.join("refused").exists());
+    let output = parent.fresh("partial-write").unwrap();
+    output.write("b", b"already exists").unwrap();
+    assert!(output
+        .files(&Files::from([
+            ("a".into(), b"first written".to_vec()),
+            ("b".into(), b"never overwrites".to_vec())
+        ]))
+        .is_err());
+    assert_eq!(fs::read(output.path.join("a")).unwrap(), b"first written");
+    assert_eq!(fs::read(output.path.join("b")).unwrap(), b"already exists");
+    assert!(!output.path.join("exchange.json").exists());
+}
