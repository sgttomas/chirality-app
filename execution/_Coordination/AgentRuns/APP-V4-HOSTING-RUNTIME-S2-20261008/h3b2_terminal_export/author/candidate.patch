@@ -0,0 +1,1152 @@
+// cfg(test) only. A terminal exchange carries historical bytes, never native authority.
+use super::*;
+use crate::{
+    distribution_store::{S1Reference, Store},
+    hosting::AppRuntimeCustody,
+};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    ffi::CString,
+    fs::{self, File},
+    io::{Read, Write},
+    os::{
+        fd::{AsRawFd, FromRawFd},
+        unix::fs::{MetadataExt, PermissionsExt},
+    },
+    path::{Component, Path},
+};
+type Files = BTreeMap<String, Vec<u8>>;
+const FORMAT: &str = "group-b-s1-terminal-reader-exchange.v1";
+fn err(e: impl std::fmt::Display) -> String {
+    e.to_string()
+}
+fn hex(s: &str, n: usize) -> bool {
+    s.len() == n
+        && s.bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+fn closed(v: &Value, keys: &[&str]) -> Result<(), String> {
+    let o = v.as_object().ok_or("object required")?;
+    if o.len() != keys.len() || keys.iter().any(|k| !o.contains_key(*k)) {
+        return Err("closed fields differ".into());
+    }
+    Ok(())
+}
+fn safe(p: &str) -> Result<(), String> {
+    if p.is_empty()
+        || p.starts_with('/')
+        || p.contains('\\')
+        || p.split('/').any(|c| c.is_empty() || c == "." || c == "..")
+    {
+        Err("unsafe member path".into())
+    } else {
+        Ok(())
+    }
+}
+fn paths(files: &Files) -> Result<(), String> {
+    for p in files.keys() {
+        safe(p)?;
+        let mut parent = Path::new(p).parent();
+        while let Some(a) = parent {
+            if files.contains_key(a.to_str().ok_or("non UTF8 path")?) {
+                return Err("ancestor collision".into());
+            }
+            parent = a.parent();
+        }
+    }
+    Ok(())
+}
+fn members(files: &Files) -> Value {
+    json!(files
+        .iter()
+        .map(|(p, b)| json!({"path":p,"sha256":tree::digest(b),"size":b.len()}))
+        .collect::<Vec<_>>())
+}
+fn snapshot(root: &Path) -> Result<Files, String> {
+    let before = tree::scan(root)?;
+    let mut files = Files::new();
+    for e in &before.entries {
+        if e.kind == "file" {
+            safe(&e.path)?;
+            let b = fs::read(root.join(&e.path)).map_err(err)?;
+            if Some(tree::digest(&b)) != e.sha256 || Some(b.len() as u64) != e.size {
+                return Err("copy observation changed".into());
+            }
+            files.insert(e.path.clone(), b);
+        }
+    }
+    if tree::scan(root)? != before {
+        return Err("copy inventory changed".into());
+    }
+    paths(&files)?;
+    Ok(files)
+}
+fn exact(files: &Files, r: &Value) -> Result<(), String> {
+    closed(r, &["path", "sha256"])?;
+    let p = r["path"].as_str().ok_or("reference path absent")?;
+    safe(p)?;
+    let hash = r["sha256"].as_str().ok_or("reference digest absent")?;
+    if !hex(hash, 64) || files.get(p).is_none_or(|b| tree::digest(b) != hash) {
+        return Err("reference bytes differ".into());
+    }
+    Ok(())
+}
+fn publication(
+    read: &Value,
+    files: &Files,
+    source: Option<&Files>,
+    event: &Value,
+    row: &str,
+) -> Result<(), String> {
+    if read["state"] != "read"
+        || event["transitionId"] != row
+        || read["evidence"]["lifecycle"]["legacy_event"] != *event
+    {
+        return Err("actual successful row read required".into());
+    }
+    let e = &read["evidence"];
+    let g = &read["generation"];
+    crate::recovery::generation_ref(g)?;
+    for other in [
+        &e["reference"]["generation"],
+        &e["artifact"]["generation"],
+        &e["lifecycle"]["verification_generation"],
+        &event["generation"],
+    ] {
+        if other != g {
+            return Err("full H5 differs".into());
+        }
+    }
+    for (key, value) in [
+        ("observed", &e["artifact"]),
+        ("lifecycle", &e["lifecycle"]),
+        ("transport", &e["transport"]),
+    ] {
+        exact(files, &e["reference"][key])?;
+        let b = &files[e["reference"][key]["path"].as_str().unwrap()];
+        if serde_json::from_slice::<Value>(b).map_err(err)? != *value {
+            return Err("raw/readback differ".into());
+        }
+    }
+    let entries = e["transport"]["entries"]
+        .as_array()
+        .ok_or("transport members absent")?;
+    let mut declared = BTreeSet::new();
+    for r in entries {
+        exact(files, r)?;
+        if !declared.insert(r["path"].as_str().unwrap().to_string()) {
+            return Err("duplicate transport member".into());
+        }
+    }
+    let transport = e["reference"]["transport"]["path"].as_str().unwrap();
+    if !declared.insert(transport.into()) || declared != files.keys().cloned().collect() {
+        return Err("publication set differs".into());
+    }
+    let selected: Files = files
+        .iter()
+        .filter(|(p, _)| !p.starts_with(".chirality-s1/"))
+        .map(|(p, b)| (p.clone(), b.clone()))
+        .collect();
+    match source {
+        Some(s) if !e["transport"]["sourceAssociation"].is_null() && s == &selected => (),
+        None if e["transport"]["sourceAssociation"].is_null() && selected.is_empty() => (),
+        _ => return Err("source closure differs".into()),
+    }
+    Ok(())
+}
+fn validate(
+    packet: &Value,
+    prior: &Files,
+    terminal: &Files,
+    source: Option<&Files>,
+) -> Result<(), String> {
+    closed(
+        packet,
+        &[
+            "format",
+            "case",
+            "producer",
+            "applicationCandidate",
+            "predecessor",
+            "terminal",
+            "selectedSourceMembers",
+        ],
+    )?;
+    if packet["format"] != FORMAT
+        || packet["case"]
+            != if source.is_some() {
+                "selected"
+            } else {
+                "unselected"
+            }
+    {
+        return Err("unsupported exchange case/format".into());
+    }
+    closed(
+        &packet["producer"],
+        &[
+            "sourceRevision",
+            "harnessExecutableSha256",
+            "command",
+            "features",
+            "kind",
+        ],
+    )?;
+    let p = &packet["producer"];
+    if !hex(p["sourceRevision"].as_str().unwrap_or(""), 40)
+        || !hex(p["harnessExecutableSha256"].as_str().unwrap_or(""), 64)
+        || p["kind"] != "synthetic-host-test"
+        || p["command"]
+            .as_array()
+            .is_none_or(|a| a.is_empty() || a.iter().any(|v| !v.is_string()))
+    {
+        return Err("producer identity malformed".into());
+    }
+    let features = p["features"].as_array().ok_or("features absent")?;
+    if features.iter().any(|v| !v.is_string())
+        || features.windows(2).any(|w| w[0].as_str() >= w[1].as_str())
+    {
+        return Err("features not sorted unique".into());
+    }
+    if packet["applicationCandidate"]
+        != json!({"revision":"INVENTED-S4-APP-REVISION","buildIdentity":"INVENTED-S4-APP-BUILD","standing":"invented-consumer-fixture"})
+    {
+        return Err("explicit invented application identity required".into());
+    }
+    let a = &packet["predecessor"];
+    let b = &packet["terminal"];
+    closed(a, &["readback", "actualLt09", "members"])?;
+    closed(b, &["readback", "actualLt23", "members"])?;
+    paths(prior)?;
+    paths(terminal)?;
+    if a["members"] != members(prior)
+        || b["members"] != members(terminal)
+        || packet["selectedSourceMembers"] != source.map(members).unwrap_or(Value::Null)
+    {
+        return Err("member manifest differs".into());
+    }
+    publication(&a["readback"], prior, source, &a["actualLt09"], "LT-09")?;
+    publication(&b["readback"], terminal, source, &b["actualLt23"], "LT-23")?;
+    let x = &a["readback"]["evidence"];
+    let y = &b["readback"]["evidence"];
+    if a["readback"]["generation"] != b["readback"]["generation"]
+        || x["reference"]["publication"] == y["reference"]["publication"]
+        || x["reference"]["observed"] != y["reference"]["observed"]
+        || x["artifact"] != y["artifact"]
+        || x["transport"]["sourceAssociation"] != y["transport"]["sourceAssociation"]
+        || a["actualLt09"]["sequence"]
+            .as_u64()
+            .zip(b["actualLt23"]["sequence"].as_u64())
+            .is_none_or(|(a, b)| a >= b)
+    {
+        return Err("predecessor/terminal join differs".into());
+    }
+    let observed = x["reference"]["observed"]["path"].as_str().unwrap();
+    if prior[observed] != terminal[observed] {
+        return Err("observation bytes changed".into());
+    }
+    Ok(())
+}
+
+// Output descriptors stay bound from physical parent traversal through final marker.
+fn name(s: &str) -> Result<CString, String> {
+    CString::new(s).map_err(err)
+}
+fn open_at(dir: &File, p: &str, flags: i32) -> Result<File, String> {
+    let n = name(p)?;
+    let fd = unsafe {
+        libc::openat(
+            dir.as_raw_fd(),
+            n.as_ptr(),
+            flags | libc::O_NOFOLLOW | libc::O_CLOEXEC,
+            0o600,
+        )
+    };
+    if fd < 0 {
+        return Err(std::io::Error::last_os_error().to_string());
+    }
+    Ok(unsafe { File::from_raw_fd(fd) })
+}
+fn id(f: &File) -> Result<(u64, u64), String> {
+    let m = f.metadata().map_err(err)?;
+    Ok((m.dev(), m.ino()))
+}
+struct Dir {
+    fd: File,
+    path: PathBuf,
+    private: bool,
+}
+impl Dir {
+    fn physical(path: &Path) -> Result<Self, String> {
+        if !path.is_absolute() {
+            return Err("absolute physical path required".into());
+        }
+        let mut fd = File::open("/").map_err(err)?;
+        for c in path.components() {
+            match c {
+                Component::RootDir => (),
+                Component::Normal(n) => {
+                    fd = open_at(
+                        &fd,
+                        n.to_str().ok_or("non UTF8 path")?,
+                        libc::O_RDONLY | libc::O_DIRECTORY,
+                    )?
+                }
+                _ => return Err("nonphysical component".into()),
+            }
+        }
+        Ok(Self {
+            fd,
+            path: path.into(),
+            private: false,
+        })
+    }
+    fn guard(&self) -> Result<(), String> {
+        let now = Self::physical(&self.path)?;
+        let m = self.fd.metadata().map_err(err)?;
+        if self.private && (m.mode() & 0o777 != 0o700 || m.uid() != unsafe { libc::geteuid() }) {
+            return Err("output no longer private".into());
+        }
+        if id(&now.fd)? != id(&self.fd)? {
+            return Err("output directory replaced".into());
+        }
+        Ok(())
+    }
+    fn fresh(&self, part: &str) -> Result<Self, String> {
+        safe(part)?;
+        if part.contains('/') {
+            return Err("one directory component required".into());
+        }
+        self.guard()?;
+        let n = name(part)?;
+        if unsafe { libc::mkdirat(self.fd.as_raw_fd(), n.as_ptr(), 0o700) } != 0 {
+            return Err(std::io::Error::last_os_error().to_string());
+        }
+        let d = Self {
+            fd: open_at(&self.fd, part, libc::O_RDONLY | libc::O_DIRECTORY)?,
+            path: self.path.join(part),
+            private: true,
+        };
+        d.guard()?;
+        Ok(d)
+    }
+    fn write(&self, p: &str, b: &[u8]) -> Result<(), String> {
+        safe(p)?;
+        let mut fd = self.fd.try_clone().map_err(err)?;
+        let mut iter = p.split('/').peekable();
+        while let Some(c) = iter.next() {
+            if iter.peek().is_none() {
+                let mut f = open_at(&fd, c, libc::O_WRONLY | libc::O_CREAT | libc::O_EXCL)?;
+                f.write_all(b).map_err(err)?;
+                f.sync_all().map_err(err)?;
+            } else {
+                let n = name(c)?;
+                if unsafe { libc::mkdirat(fd.as_raw_fd(), n.as_ptr(), 0o700) } != 0
+                    && std::io::Error::last_os_error().raw_os_error() != Some(libc::EEXIST)
+                {
+                    return Err(std::io::Error::last_os_error().to_string());
+                }
+                fd = open_at(&fd, c, libc::O_RDONLY | libc::O_DIRECTORY)?;
+            }
+        }
+        Ok(())
+    }
+    fn files(&self, files: &Files) -> Result<(), String> {
+        paths(files)?;
+        for (p, b) in files {
+            self.guard()?;
+            self.write(p, b)?;
+        }
+        self.guard()
+    }
+    fn marker(&self, marker: &str, raw: &[u8]) -> Result<(), String> {
+        if !matches!(marker, "exchange.json" | "exchange.diagnostic.json") {
+            return Err("unsupported marker".into());
+        }
+        self.guard()?;
+        self.write(".exchange.pending", raw)?;
+        let from = name(".exchange.pending")?;
+        let to = name(marker)?;
+        self.guard()?;
+        if unsafe {
+            libc::linkat(
+                self.fd.as_raw_fd(),
+                from.as_ptr(),
+                self.fd.as_raw_fd(),
+                to.as_ptr(),
+                0,
+            )
+        } != 0
+        {
+            return Err(std::io::Error::last_os_error().to_string());
+        }
+        unsafe {
+            libc::unlinkat(self.fd.as_raw_fd(), from.as_ptr(), 0);
+        }
+        let result = (|| {
+            self.fd.sync_all().map_err(err)?;
+            self.guard()?;
+            let mut f = open_at(&self.fd, marker, libc::O_RDONLY)?;
+            let mut actual = Vec::new();
+            f.read_to_end(&mut actual).map_err(err)?;
+            if actual != raw {
+                return Err("marker changed".into());
+            }
+            Ok(())
+        })();
+        if result.is_err() {
+            unsafe {
+                libc::unlinkat(self.fd.as_raw_fd(), to.as_ptr(), 0);
+            }
+        }
+        result
+    }
+}
+fn copied(root: &Dir, files: &Files) -> Result<(), String> {
+    root.guard()?;
+    if snapshot(&root.path)? != *files {
+        return Err("copied byte set differs".into());
+    }
+    let mut names = BTreeMap::new();
+    names.insert(".".to_string(), false);
+    for p in files.keys() {
+        names.insert(p.clone(), true);
+        let mut parent = Path::new(p).parent();
+        while let Some(a) = parent {
+            if !a.as_os_str().is_empty() {
+                names.insert(a.to_str().ok_or("non UTF8 path")?.into(), false);
+            }
+            parent = a.parent();
+        }
+    }
+    let inventory = tree::scan(&root.path)?;
+    if inventory.entries.len() != names.len() {
+        return Err("output directory membership differs".into());
+    }
+    for e in inventory.entries {
+        match names.get(&e.path) {
+            Some(true) if e.kind == "file" && e.mode == 0o600 => (),
+            Some(false) if e.kind == "dir" && e.mode == 0o700 => (),
+            _ => return Err("output kind/mode differs".into()),
+        }
+    }
+    root.guard()
+}
+struct Capture {
+    generation: Value,
+    attempt: u64,
+    reference: S1Reference,
+    store: Arc<Store>,
+    read: Value,
+    event: Value,
+    files: Files,
+    source: Option<Files>,
+}
+impl Capture {
+    fn before_stop(host: &Host, data: &Path, source: Option<&Path>) -> Result<Self, String> {
+        let (g, attempt, reference) = {
+            let i = host.inner.0.lock().unwrap();
+            if i.state != "ready" || !i.successor_lt09_installed {
+                return Err("installed ready LT09 required".into());
+            }
+            (
+                i.generation.clone(),
+                i.start_attempt,
+                i.successor_reference.clone().ok_or("reference absent")?,
+            )
+        };
+        let store = host
+            .distribution_store_for_admission(true)?
+            .ok_or("Store absent")?;
+        let read = host.distribution_evidence(&g);
+        let event = host
+            .lifecycle_events()
+            .into_iter()
+            .find(|e| e["transitionId"] == "LT-09" && e["generation"] == g)
+            .ok_or("actual LT09 absent")?;
+        source_locator(&read, source)?;
+        let files = publication_files(data, &read)?;
+        let originals = source.map(snapshot).transpose()?;
+        publication(&read, &files, originals.as_ref(), &event, "LT-09")?;
+        if store.read_s1(&g, &reference)? != read["evidence"]
+            || host.distribution_evidence(&g) != read
+        {
+            return Err("predecessor changed".into());
+        }
+        Ok(Self {
+            generation: g,
+            attempt,
+            reference,
+            store,
+            read,
+            event,
+            files,
+            source: originals,
+        })
+    }
+    fn current(&self, host: &Host, event: &Value) -> Result<(), String> {
+        let i = host.inner.0.lock().unwrap();
+        if i.start_attempt != self.attempt
+            || i.generation != self.generation
+            || i.state != "stopped"
+            || i.successor_publication_sequence
+                != event["sequence"].as_u64().ok_or("event sequence absent")?
+            || !i.lifecycle.iter().any(|e| e == event)
+        {
+            return Err("native source/event changed".into());
+        }
+        Ok(())
+    }
+}
+fn source_locator(read: &Value, source: Option<&Path>) -> Result<(), String> {
+    match source {
+        Some(path)
+            if read["evidence"]["transport"]["sourceAssociation"]["originalSource"].as_str()
+                == path.to_str()
+                && path.canonicalize().map_err(err)? == path =>
+        {
+            Dir::physical(path)?;
+            Ok(())
+        }
+        None if read["evidence"]["transport"]["sourceAssociation"].is_null() => Ok(()),
+        _ => Err("original selected source locator differs".into()),
+    }
+}
+fn publication_files(data: &Path, read: &Value) -> Result<Files, String> {
+    if read["state"] != "read" {
+        return Err("native held read unavailable".into());
+    }
+    let p = read["evidence"]["reference"]["publication"]
+        .as_str()
+        .ok_or("publication absent")?;
+    safe(p)?;
+    if p.contains('/') {
+        return Err("invalid publication leaf".into());
+    }
+    snapshot(&data.join("runtime/distribution").join(p))
+}
+fn settled(host: &Host, g: &Value, limit: Duration) -> Result<Value, String> {
+    let deadline = std::time::Instant::now() + limit;
+    loop {
+        let read = host.distribution_evidence(g);
+        match read["state"].as_str() {
+            Some("read")
+                if read["evidence"]["lifecycle"]["legacy_event"]["transitionId"] == "LT-23" =>
+            {
+                return Ok(read)
+            }
+            Some("pending") => (),
+            _ => return Err("terminal native read unavailable".into()),
+        }
+        if std::time::Instant::now() >= deadline {
+            return Err("finite test wait expired; worker not joined or cancelled".into());
+        }
+        std::thread::sleep(Duration::from_millis(5));
+    }
+}
+fn export(
+    host: &Host,
+    c: &Capture,
+    data: &Path,
+    source: Option<&Path>,
+    out: &Path,
+    producer: Value,
+    candidate: Value,
+    marker: &str,
+    before_marker: impl FnOnce(),
+) -> Result<Value, String> {
+    let read = host.distribution_evidence(&c.generation);
+    let event = host
+        .lifecycle_events()
+        .into_iter()
+        .rev()
+        .find(|e| e["transitionId"] == "LT-23" && e["generation"] == c.generation)
+        .ok_or("actual LT23 absent")?;
+    c.current(host, &event)?;
+    source_locator(&read, source)?;
+    let files = publication_files(data, &read)?;
+    let originals = source.map(snapshot).transpose()?;
+    if originals != c.source || c.store.read_s1(&c.generation, &c.reference)? != c.read["evidence"]
+    {
+        return Err("predecessor/source changed".into());
+    }
+    let packet = json!({"format":FORMAT,"case":if source.is_some(){"selected"}else{"unselected"},"producer":producer,"applicationCandidate":candidate,"predecessor":{"readback":c.read,"actualLt09":c.event,"members":members(&c.files)},"terminal":{"readback":read,"actualLt23":event,"members":members(&files)},"selectedSourceMembers":originals.as_ref().map(members)});
+    validate(&packet, &c.files, &files, originals.as_ref())?;
+    let parent = out.parent().ok_or("output parent absent")?;
+    let physical = parent.canonicalize().map_err(err)?;
+    let temp = std::env::temp_dir().canonicalize().map_err(err)?;
+    if physical != parent || !(physical.starts_with("/private/tmp") || physical.starts_with(temp)) {
+        return Err("physical temporary output required".into());
+    }
+    let parent = Dir::physical(parent)?;
+    let root = parent.fresh(
+        out.file_name()
+            .and_then(|s| s.to_str())
+            .ok_or("output name absent")?,
+    )?;
+    let a = root.fresh("predecessor")?.fresh("publication")?;
+    a.files(&c.files)?;
+    let b = root.fresh("terminal")?.fresh("publication")?;
+    b.files(&files)?;
+    let src = if let Some(ref originals) = originals {
+        let d = root.fresh("selected-source")?;
+        d.files(originals)?;
+        Some(d)
+    } else {
+        None
+    };
+    before_marker();
+    if c.store.read_s1(&c.generation, &c.reference)? != c.read["evidence"]
+        || host.distribution_evidence(&c.generation) != read
+        || source.map(snapshot).transpose()? != originals
+    {
+        return Err("native read/source changed during export".into());
+    }
+    c.current(host, &event)?;
+    parent.guard()?;
+    root.guard()?;
+    a.guard()?;
+    b.guard()?;
+    if let Some(ref src) = src {
+        src.guard()?;
+    }
+    let mut expected = Files::new();
+    for (prefix, raw) in [
+        ("predecessor/publication", &c.files),
+        ("terminal/publication", &files),
+    ] {
+        for (p, b) in raw {
+            expected.insert(format!("{prefix}/{p}"), b.clone());
+        }
+    }
+    if let Some(ref originals) = originals {
+        for (p, b) in originals {
+            expected.insert(format!("selected-source/{p}"), b.clone());
+        }
+    }
+    copied(&root, &expected)?;
+    let raw = serde_json::to_vec_pretty(&packet).map_err(err)?;
+    root.marker(marker, &raw)?;
+    expected.insert(marker.into(), raw);
+    if let Err(e) = copied(&root, &expected) {
+        let n = name(marker)?;
+        unsafe {
+            libc::unlinkat(root.fd.as_raw_fd(), n.as_ptr(), 0);
+        }
+        return Err(e);
+    }
+    Ok(packet)
+}
+fn compiled_sources() -> [(&'static str, &'static [u8]); 6] {
