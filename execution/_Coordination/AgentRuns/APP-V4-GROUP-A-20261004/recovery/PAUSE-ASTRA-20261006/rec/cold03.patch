+        },
+        "candidate": {
+          "$ref": "#/$defs/nonempty"
+        }
+      }
+    },
+    "quit_requested": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "kind",
+        "session",
+        "at",
+        "actor",
+        "liveTurns",
+        "outstandingEntries",
+        "activeDescendants"
