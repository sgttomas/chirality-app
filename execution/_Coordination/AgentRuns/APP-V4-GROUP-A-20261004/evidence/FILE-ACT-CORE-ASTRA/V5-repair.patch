+fn file_act_fifo_worker() {
+    let Ok(mode) = std::env::var("CHIRALITY_FILE_ACT_FIFO_CASE") else {
+        return;
+    };
+    let mut f = Fixture::new();
+    match mode.as_str() {
+        "compose" => {
+            replace_with_fifo(&f.path);
+            assert!(f
