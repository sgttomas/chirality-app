{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "pkg-identity.s1"
    },
    "legacy_package": {
      "title": "Package identity record (DEL-01-06 PKG-v0.2 \u00a75; OUT-002; SCC-003 milestone M2; PROPOSED)",
      "description": "One record per package candidate: the App build, the stock Codex distribution as published and as placed in the bundle, every Mach-O file's signer, hardened-runtime flag, timestamp and entitlements, the other shipped content with its supplier, the signing option, and the notarisation and Gatekeeper results with their actors. Names are Chirality semantic labels. Rules a schema cannot express are PK-R1\u2026PK-R9 in prototype/check_pkg.py. Kept at DEL-01-06 Evidence/PKG/<candidate key>/package-identity.json (PKG \u00a75.3).",
      "type": "object",
      "required": [
        "record_kind",
        "format",
        "record_id",
        "app",
        "codex",
        "bundle_contents",
        "signing",
        "notarisation",
        "gatekeeper",
        "date",
        "limits",
        "complete",
        "configuration",
        "first_package_checks"
      ],
      "additionalProperties": false,
      "properties": {
        "record_kind": {
          "const": "package_identity"
        },
        "format": {
          "const": "PKG-v0.2"
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "app": {
          "type": "object",
          "required": [
            "revision",
            "build_identity",
            "version",
            "bundle_id",
            "target",
            "installer"
          ],
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "build_identity": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "bundle_id": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "const": "macOS arm64",
              "description": "V4-CST-02; no other platform."
            },
            "signature": {
              "$ref": "#/$defs/signature"
            },
            "cdhash": {
              "type": "string",
              "minLength": 1
            },
            "installer": {
              "type": "object",
              "required": [
                "kind",
                "file",
                "sha256_before_notarisation"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "dmg",
                    "app_zip"
                  ]
                },
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256_before_notarisation": {
                  "$ref": "#/$defs/sha256"
                },
                "sha256_after_staple": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          }
        },
        "codex": {
          "type": "object",
          "required": [
            "pin",
            "published",
            "packaged",
            "launcher",
            "executables"
          ],
          "additionalProperties": false,
          "properties": {
            "pin": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "published": {
              "description": "HOSTING \u00a77.1 distribution content identity of the tree as published (npm platform package), read at build time.",
              "$ref": "#/$defs/tree_identity"
            },
            "packaged": {
              "description": "The same identity read from the tree inside the bundle (PKG \u00a74 place P-1).",
              "$ref": "#/$defs/tree_identity"
            },
            "launcher": {
              "type": "object",
              "required": [
                "kind",
                "path_in_bundle"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "vendor_binary",
                    "npm_wrapper"
                  ],
                  "description": "HOSTING U-17. PKG \u00a74 proposes vendor_binary."
                },
                "path_in_bundle": {
                  "type": "string",
                  "minLength": 1
                },
                "environment_added": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "executables": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "sha256_published",
                  "sha256_packaged",
                  "signature"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256_published": {
                    "$ref": "#/$defs/sha256"
                  },
                  "sha256_packaged": {
                    "$ref": "#/$defs/sha256"
                  },
                  "signature": {
                    "$ref": "#/$defs/signature"
                  },
                  "supplier_entitlements": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Entitlements of the published file, read with codesign -d (option A must re-apply exactly these, PK-R2)."
                  }
                }
              },
              "description": "Every Mach-O file of the packaged tree (PK-R6: as many entries as packaged.macho_files)."
            }
          }
        },
        "bundle_contents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item",
              "supplier",
              "path_in_bundle",
              "state"
            ],
            "additionalProperties": false,
            "properties": {
              "item": {
                "enum": [
                  "bundled_workflows",
                  "shipped_revision_manifest",
                  "product_guidance",
                  "role_files",
                  "role_set",
                  "other"
                ]
              },
              "supplier": {
                "type": "string",
                "pattern": "^DEL-[0-9]{2}-[0-9]{2}$"
              },
              "path_in_bundle": {
                "type": "string",
                "minLength": 1
              },
              "identity": {
                "$ref": "#/$defs/sha256"
              },
              "state": {
                "enum": [
                  "present",
                  "missing"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "state": {
                      "const": "present"
                    }
                  }
                },
                "then": {
                  "required": [
                    "identity"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "state": {
                      "const": "missing"
                    }
                  }
                },
                "then": {
                  "not": {
                    "required": [
                      "identity"
                    ]
                  }
                }
              }
            ]
          }
        },
        "signing": {
          "type": "object",
          "required": [
            "option",
            "app_identity",
            "performed_by",
            "recorded_by"
          ],
          "additionalProperties": false,
          "properties": {
            "option": {
              "enum": [
                "B_supplier_signatures_kept",
                "A_app_re_signs_codex"
              ]
            },
            "app_identity": {
              "type": "string",
              "minLength": 1,
              "description": "The Developer ID identity and team the App was signed with; never a credential."
            },
            "performed_by": {
              "type": "string",
              "minLength": 1,
              "description": "The person whose Apple account signed (R23-13.2), or the build that used it under that person's direction, as evidenced."
            },
            "recorded_by": {
              "type": "string",
              "minLength": 1
            },
            "fallback_reason": {
              "type": "string",
              "minLength": 1,
              "description": "Required for option A: the observed FP check that failed under B (PKG \u00a77)."
            },
            "escalation_ref": {
              "type": "string",
              "minLength": 1,
              "description": "Option A only: the HELP_HUMAN ruling that adopted A after the HOSTING \u00a77 escalation (\u00a73 SIGN-2)."
            },
            "configuration_space_tried": {
              "type": "array",
              "items": {
                "enum": [
                  "CS-1",
                  "CS-2",
                  "CS-3",
                  "CS-4"
                ]
              },
              "description": "Option A only: the configuration space of PKG \u00a77.2 tried before the fallback; all four required (PK-R7)."
            }
          },
          "if": {
            "properties": {
              "option": {
                "const": "A_app_re_signs_codex"
              }
            }
          },
          "then": {
            "required": [
              "fallback_reason",
              "escalation_ref",
              "configuration_space_tried"
            ]
          }
        },
        "notarisation": {
          "type": "object",
          "required": [
            "state"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "not_submitted",
                "accepted",
                "rejected",
                "in_progress"
              ]
            },
            "submission_id": {
              "type": "string",
              "minLength": 1
            },
            "log_ref": {
              "type": "string",
              "minLength": 1
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "submitted_by": {
              "type": "string",
              "minLength": 1
            },
            "stapled": {
              "type": "boolean"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "enum": [
                      "accepted",
                      "rejected",
                      "in_progress"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "submission_id",
                  "submitted_by"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "state": {
                    "enum": [
                      "accepted",
                      "rejected"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "log_ref"
                ]
              }
            }
          ]
        },
        "gatekeeper": {
          "type": "object",
          "required": [
            "assessed"
          ],
          "additionalProperties": false,
          "properties": {
            "assessed": {
              "type": "boolean"
            },
            "verdict": {
              "type": "string",
              "minLength": 1,
              "description": "spctl's own words, e.g. 'Notarized Developer ID' or 'Unnotarized Developer ID'."
            },
            "deep_strict_verify": {
              "enum": [
                "valid",
                "invalid",
                "not_run"
              ]
            },
            "quarantine": {
              "type": "object",
              "required": [
                "installer_quarantined",
                "app_quarantined",
                "evidence"
              ],
              "additionalProperties": false,
              "description": "xattr -l of the installer and of the installed .app showing com.apple.quarantine (PKG \u00a78, G-7).",
              "properties": {
                "installer_quarantined": {
                  "type": "boolean"
                },
                "app_quarantined": {
                  "type": "boolean"
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "if": {
            "properties": {
              "assessed": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "verdict",
              "deep_strict_verify",
              "quarantine"
            ]
          }
        },
        "support_revision": {
          "type": "string",
          "pattern": "^EXP-v[0-9]+\\.[0-9]+$",
          "description": "SCC-003 M1: the DEL-09-01 revision the witness records use."
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "complete": {
          "type": "boolean",
          "description": "True only when every bundle-content item is present (PK-R8). An incomplete candidate is not handed over as a package (\u00a74.2 I-3)."
        },
        "configuration": {
          "type": "object",
          "required": [
            "ref",
            "sha256"
          ],
          "additionalProperties": false,
          "description": "The OUT-001 configuration the package was built from (PKG \u00a74.3), by reference and digest.",
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "first_package_checks": {
          "type": "object",
          "required": [
            "fp0",
            "fp1a",
            "fp1b",
            "fp3"
          ],
          "additionalProperties": false,
          "description": "FP-0, FP-1(a), FP-1(b) and FP-3 of PKG \u00a77, held in the identity record because they run before a package record exists (RV2 PKG-R6). FP-2, FP-4, FP-5 and the witness are EXP result records citing this record.",
          "properties": {
            "fp0": {
              "$ref": "#/$defs/check"
            },
            "fp1a": {
              "$ref": "#/$defs/check"
            },
            "fp1b": {
              "$ref": "#/$defs/check"
            },
            "fp3": {
              "$ref": "#/$defs/check"
            }
          }
        }
      }
    },
    "expected_reference": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "adoption_attestation": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "published_inventory": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "packaged_inventory": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "verification_artifact": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "mach_o_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "distribution_status": {
      "enum": [
        "reference-equal",
        "unverifiable",
        "mismatch"
      ]
    }
  },
  "required": [
    "format",
    "legacy_package",
    "expected_reference",
    "adoption_attestation",
    "published_inventory",
    "packaged_inventory",
    "verification_artifact",
    "mach_o_paths",
    "distribution_status"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:distribution-successor:pkg-identity.s1",
  "description": "S1 offline candidate only; schema validity is not supplier or App qualification.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "object",
      "required": [
        "team",
        "authority",
        "hardened_runtime",
        "timestamp",
        "entitlements"
      ],
      "additionalProperties": false,
      "properties": {
        "team": {
          "type": "string",
          "pattern": "^[A-Z0-9]{10}$"
        },
        "hardened_runtime": {
          "type": "boolean"
        },
        "timestamp": {
          "type": "boolean"
        },
        "entitlements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authority": {
          "type": "string",
          "minLength": 1,
          "description": "First Authority line of codesign -dvv."
        }
      }
    },
    "tree_identity": {
      "type": "object",
      "required": [
        "manifest_sha256",
        "files",
        "macho_files"
      ],
      "additionalProperties": false,
      "properties": {
        "manifest_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "PKG \u00a75.2: sha256 over \"<sha256>  <relative path>\\n\" for every regular file, ordered by path bytes (C collation), last newline included (prototype/read_tree.py --manifest)."
        },
        "files": {
          "type": "integer",
          "minimum": 1
        },
        "macho_files": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "outcome",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "blocked",
            "not-run",
            "inconclusive"
          ],
          "description": "EXP / HOSTING \u00a79.3 labels."
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "cause": {
          "type": "string",
          "minLength": 1,
          "description": "Recorded cause, required for fail or blocked (PKG \u00a77.3)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "fail",
                  "blocked"
                ]
              }
            }
          },
          "then": {
            "required": [
              "cause"
            ]
          }
        }
      ]
    }
  },
  "x-derivation": {
    "source": "projects/chirality-app-v4/execution/PKG-01_Native App and third-party harness integration/1_Working/DEL-01-06_macOS packaging and distribution evidence/Design/pkg.identity-record.schema.json",
    "sha256": "efb0de357efc3cfc0a193a8ffdcb9b08d93908b99d51ece614c4c2d6b94e008a",
    "operation": "unchanged schema object nested; $defs hoisted without modification; old $id/$schema metadata removed"
  }
}
