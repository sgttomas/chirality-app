{
  "command": [
    "node",
    "node_modules/@tauri-apps/cli/tauri.js",
    "build",
    "--debug",
    "--no-sign",
    "--bundles",
    "app",
    "--features",
    "custom-protocol",
    "--config",
    "packaging/unsigned/tauri.development.conf.json",
    "--config",
    "<scratch>/supplier.development.conf.json",
    "--",
    "--offline",
    "--locked"
  ],
  "environment": {
    "PATH": "/opt/homebrew/bin:<user-home>/.cargo/bin:/usr/bin:/bin:/usr/sbin:/sbin",
    "HOME": "<scratch>/home",
    "RUSTUP_HOME": "<user-home>/.rustup",
    "CARGO_HOME": "<scratch>/cargo-home",
    "CARGO_TARGET_DIR": "<scratch>/target",
    "CARGO_NET_OFFLINE": "true",
    "CHIRALITY_SKIP_CODEX": "1",
    "CI": "true",
    "TMPDIR": "/private/tmp",
    "LANG": "en_US.UTF-8"
  }
}
