{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chirality App v4 (development candidate)",
  "version": "0.0.0",
  "identifier": "dev.chirality.app-v4.skeleton",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chirality App v4 \u2014 walking skeleton",
        "width": 1100,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png"
    ],
    "targets": [
      "app"
    ],
    "resources": {
      "resources/instructions/": "instructions/"
    },
    "macOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
