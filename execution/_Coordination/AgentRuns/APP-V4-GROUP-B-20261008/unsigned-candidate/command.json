{
  "command": [
    "node",
    "node_modules/@tauri-apps/cli/tauri.js",
    "build",
    "--debug",
    "--no-sign",
    "--bundles",
    "app",
    "--config",
    "packaging/unsigned/tauri.development.conf.json",
    "--",
    "--offline",
    "--locked"
  ],
  "cwd": "scratch/app",
  "environment": {
    "CARGO_HOME": "/private/tmp/chirality-b2-unsigned-build/cargo-home",
    "CARGO_TARGET_DIR": "/private/tmp/chirality-b2-unsigned-build/target",
    "CARGO_NET_OFFLINE": "true",
    "CHIRALITY_SKIP_CODEX": "1",
    "CI": "true"
  }
}
