                    "planning": {
                      "enum": [
                        "met",
                        "not_met",
                        "not_evidenced"
                      ]
                    },
                    "execution": {
                      "enum": [
                        "met",
                        "not_met",
                        "not_evidenced"
                      ]
                    },
                    "workflow saving": {
                      "enum": [
                        "met",
                        "not_met",
                        "not_evidenced"
                      ]
                    },
                    "reuse": {
                      "enum": [
                        "met",
                        "not_met",
                        "not_evidenced"
                      ]
                    },
                    "approvals": {
                      "enum": [
                        "met",
                        "not_met",
                        "not_evidenced"
                      ]
                    },
                    "interruption": {
                      "enum": [
                        "met",
                        "not_met",
                        "not_evidenced"
                      ]
                    },
                    "restart": {
                      "enum": [
                        "met",
                        "not_met",
                        "not_evidenced"
                      ]
                    }
                  }
                },
                "obligation": {
                  "enum": [
                    "met",
                    "not_met",
                    "not_evidenced"
                  ]
                },
                "established": {
                  "type": "boolean"
                },
                "outside_scenarios": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              }
            },
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "Q-4": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fields",
            "statement",
            "sources"
          ],
          "properties": {
            "fields": {
              "type": "object",
