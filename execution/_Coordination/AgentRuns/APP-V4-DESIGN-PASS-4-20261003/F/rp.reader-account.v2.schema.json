{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:app-v4:eu-f1:reader-account:0.2",
  "title": "EU-F1 reader account (prototype)",
  "description": "An isolated reader's answers to READER_BRIEF.md Q-1...Q-12 about input set IS-FX-RP1-2. Compared field by field with the frozen answer key by compare_rp.py; statements and issues are read by the examiner.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "format",
    "reader",
    "input_set",
    "answers",
    "issues"
  ],
  "properties": {
    "record_kind": {
      "const": "eu_f1_reader_account"
    },
    "format": {
      "const": "EU-F1-v0.1"
    },
    "reader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "kind",
        "model_identity",
        "separation"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "agent",
            "person"
          ]
        },
        "model_identity": {
          "type": "string",
          "minLength": 1
        },
        "separation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "input_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_set_id",
        "sha256",
        "all_hashes_checked"
      ],
      "properties": {
        "input_set_id": {
          "const": "IS-FX-RP1-2"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "all_hashes_checked": {
          "type": "boolean"
        }
      }
    },
    "answers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Q-1",
        "Q-2",
        "Q-3",
        "Q-4",
        "Q-5",
        "Q-6",
        "Q-7",
        "Q-8",
        "Q-9",
        "Q-10",
        "Q-11",
        "Q-12"
      ],
      "properties": {
        "Q-1": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fields",
            "statement",
            "sources"
          ],
          "properties": {
            "fields": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "decider",
                "package_id",
                "act_kind"
              ],
              "properties": {
                "decider": {
                  "enum": [
                    "the_owner",
                    "the_coordinator",
                    "the_examiner",
                    "affected_consumers",
                    "not_stated"
                  ]
                },
                "package_id": {
                  "type": "string",
                  "minLength": 1
                },
                "act_kind": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "Q-2": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fields",
            "statement",
            "sources"
          ],
          "properties": {
            "fields": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subject_revision",
                "joined_journey_app_candidate",
                "reconciliation"
              ],
              "properties": {
                "subject_revision": {
                  "type": "string",
                  "minLength": 1
                },
                "joined_journey_app_candidate": {
                  "enum": [
                    "same_as_subject",
                    "different",
                    "not_supplied",
                    "not_mappable"
                  ]
                },
                "reconciliation": {
                  "enum": [
                    "reconciled",
                    "reconciled_by_applicability",
                    "differ",
                    "not_established"
                  ]
                }
              }
            },
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "Q-3": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fields",
            "statement",
            "sources"
          ],
          "properties": {
            "fields": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "elements",
                "obligation",
                "established",
                "outside_scenarios"
              ],
              "properties": {
                "elements": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "planning",
                    "execution",
                    "workflow saving",
