                  "required": [
                    "v3_0_1_remains_fallback",
                    "also_a_public_release_act",
                    "retires_anything"
                  ],
                  "properties": {
                    "v3_0_1_remains_fallback": {
                      "type": "boolean"
                    },
                    "also_a_public_release_act": {
                      "type": "boolean"
                    },
                    "retires_anything": {
                      "type": "boolean"
                    }
                  }
                },
                "ALT-DEFER": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "v3_0_1_remains_fallback",
                    "also_a_public_release_act",
                    "retires_anything"
                  ],
                  "properties": {
                    "v3_0_1_remains_fallback": {
                      "type": "boolean"
                    },
                    "also_a_public_release_act": {
                      "type": "boolean"
                    },
                    "retires_anything": {
                      "type": "boolean"
                    }
                  }
                },
                "ALT-DECLINE": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "v3_0_1_remains_fallback",
                    "also_a_public_release_act",
                    "retires_anything"
                  ],
                  "properties": {
                    "v3_0_1_remains_fallback": {
                      "type": "boolean"
                    },
                    "also_a_public_release_act": {
                      "type": "boolean"
                    },
                    "retires_anything": {
                      "type": "boolean"
                    }
                  }
                }
              }
            },
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "Q-8": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fields",
            "statement",
            "sources"
          ],
          "properties": {
            "fields": {
              "type": "object",
              "additionalProperties": false,
              "required": [
