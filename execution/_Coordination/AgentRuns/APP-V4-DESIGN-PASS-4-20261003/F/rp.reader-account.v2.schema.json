                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "gap_supplier_deliverables": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^DEL-[0-9]{2}-[0-9]{2}$"
                  },
                  "uniqueItems": true
                },
                "practitioner_validation_is_a_gap": {
                  "type": "boolean"
                }
              }
            },
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
