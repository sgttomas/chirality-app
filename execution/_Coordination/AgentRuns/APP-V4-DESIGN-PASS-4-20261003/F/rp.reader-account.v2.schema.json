                },
                "counts_as_completed_witness": {
                  "type": "boolean"
                },
                "acceptance_acts": {
                  "type": "integer",
                  "minimum": 0
                },
                "independent_review": {
                  "enum": [
                    "present",
                    "absent"
                  ]
                }
              }
            },
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
