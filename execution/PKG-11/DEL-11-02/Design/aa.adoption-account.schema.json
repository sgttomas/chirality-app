        "properties": {
          "act_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "human_act",
              "agent_act"
            ]
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "recorder": {
            "type": "string",
            "minLength": 1
          },
