            "type": "string",
            "minLength": 1
          },
          "custody": {
            "type": "string",
            "minLength": 1
          },
          "consumer_id": {
            "type": "string",
            "minLength": 1,
            "description": "For an adoption act: the consumer whose adoption it is. A row may cite it only for that consumer."
          },
          "act_class": {
            "enum": [
              "adoption",
              "change_approval",
              "other"
            ],
            "description": "What the act is. Only an 'adoption' act by the consumer's own loop can establish consumer_adopted; an approval of the change itself never does (F-R10)."
          },
          "recording_mode": {
            "enum": [
              "direct capture",
              "faithful recording"
            ],
            "description": "direct capture: the actor records its own act (an agent's ruling); faithful recording: someone else records it (ACT A9)."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "human_act"
                }
              }
            },
            "then": {
              "not": {
                "properties": {
                  "recorder": {
                    "const": "the owner"
                  }
                },
                "required": [
                  "recorder"
                ]
              },
              "properties": {
                "actor": {
                  "const": "the owner"
                }
              }
            }
          }
        ]
      }
