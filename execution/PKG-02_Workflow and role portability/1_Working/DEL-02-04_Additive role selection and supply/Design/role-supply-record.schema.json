{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:app-v4:del-02-04:role-supply-record:0.1",
  "title": "Role supply record (PROPOSED, ROLE-v0.1 §6.1)",
  "description": "One record per guidance-carrying client request the App sends (thread/start, thread/resume, thread/fork). It is the 'source identity supplied by the composing owner' of HOSTING-v0.8 §8.2 and the proposed body of RS R3 'supplied_guidance' (join J-11). Supplied is not adopted: adoption is always 'unknown'. PROPOSED; not accepted.",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "supplyId",
    "thread",
    "trigger",
    "request",
    "selection",
    "outcome",
    "adoption"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "chirality.role.supply"
    },
    "formatVersion": {
      "const": "0.1"
    },
    "supplyId": {
      "type": "string",
      "pattern": "^sup:"
    },
    "thread": {
      "type": "string",
      "minLength": 1,
      "description": "Codex thread identity as observed (App-observed pointer, R17-4); for a refused start, the App's conversation reference"
    },
    "previousSupply": {
      "type": "string",
      "pattern": "^sup:",
      "description": "The record this one follows for the same thread, if any"
    },
    "trigger": {
      "enum": [
        "thread-start",
        "idle-change",
        "resume-after-relaunch",
        "fork"
      ]
    },
    "changeCause": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "role-selected",
          "role-cleared",
          "guidance-edited",
          "guidance-restored",
          "release-default-applied",
          "workflow-run-started",
          "workflow-run-ended"
        ]
      },
      "description": "Required for trigger idle-change"
    },
    "request": {
      "type": "object",
      "required": [
        "method"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "thread/start",
            "thread/resume",
            "thread/fork"
          ]
        },
        "requestRef": {
          "type": "string",
          "minLength": 1,
          "description": "HOSTING §5 client-request identity; absent when refused before send"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "description": "HOSTING §4 child generation"
        }
      }
    },
    "selection": {
      "type": "object",
      "required": [
        "role",
        "preselected"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "HELP_HUMAN",
            "HELPS_HUMANS",
            "WORKING_ITEMS",
            "TASK",
            "none"
          ]
        },
        "preselected": {
          "type": "boolean",
          "description": "true when the role came from the role set's default and the person kept it (R17-9)"
        },
        "roleSet": {
          "$ref": "#/$defs/contentIdentity",
          "description": "Content identity of the bundled role set (roles.json) in force"
        }
      }
    },
    "carried": {
      "type": "object",
      "required": [
        "developerInstructions",
        "baseInstructions",
        "nativeChildRoles"
      ],
      "additionalProperties": false,
      "properties": {
        "compositionFormat": {
          "const": "chirality.role.compose/0.1"
        },
        "developerInstructions": {
          "type": "object",
          "required": [
            "content",
            "byteLength",
            "parts"
          ],
          "additionalProperties": false,
          "properties": {
            "content": {
              "$ref": "#/$defs/contentIdentity"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 1
            },
            "parts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/part"
              }
            }
          }
        },
        "baseInstructions": {
          "const": "not-set",
          "description": "R17-8: never set"
        },
        "nativeChildRoles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/childRole"
          }
        }
      }
    },
    "supplierReported": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instructionSources": {
          "description": "ThreadStartResponse/ThreadResumeResponse.instructionSources as reported (the harness's own discovered instruction files); 'not-reported' when no response was read",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "const": "not-reported"
            }
          ]
        },
        "agentRole": {
          "type": [
            "string",
            "null"
          ],
          "description": "Thread.agentRole as reported (sub-agent threads only)"
        }
      }
    },
    "outcome": {
      "enum": [
        "supplied",
        "refused-before-send",
        "request-failed",
        "unknown-no-response"
      ]
    },
    "refusal": {
      "enum": [
        "guidance-file-missing",
        "guidance-file-unreadable",
        "guidance-not-utf8",
        "role-set-invalid",
        "revision-not-verified",
        "workflow-not-registered",
        "forbidden-input-in-request"
      ]
    },
    "adoption": {
      "const": "unknown",
      "description": "Supplied is not adopted (CLM-004; HOSTING §8.2 P-15)"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "refused-before-send"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "refusal"
        ],
        "not": {
          "required": [
            "carried"
          ]
        }
      },
      "else": {
        "required": [
          "carried"
        ],
        "not": {
          "required": [
            "refusal"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "trigger": {
            "const": "idle-change"
          }
        },
        "required": [
          "trigger"
        ]
      },
      "then": {
        "required": [
          "changeCause",
          "previousSupply"
        ],
        "properties": {
          "request": {
            "properties": {
              "method": {
                "const": "thread/resume"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "trigger": {
            "const": "thread-start"
          }
        },
        "required": [
          "trigger"
        ]
      },
      "then": {
        "properties": {
          "request": {
            "properties": {
              "method": {
                "const": "thread/start"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "selection": {
            "properties": {
              "role": {
                "const": "none"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "carried": {
            "properties": {
              "developerInstructions": {
                "properties": {
                  "parts": {
                    "items": {
                      "not": {
                        "properties": {
                          "kind": {
                            "const": "role-guidance"
                          }
                        },
                        "required": [
                          "kind"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "contentIdentity": {
      "description": "Same shape as RS-v0.8 contentIdentity. Method designation required; the algorithm is open (HOSTING U-08).",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "method",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "notObtainable",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "notObtainable": {
              "const": true
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "guidanceSource": {
      "type": "object",
      "required": [
        "store",
        "path",
        "release",
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "store": {
          "enum": [
            "seeded-copy"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(AGENTS\\.md|agents/AGENT_(HELP_HUMAN|HELPS_HUMANS|WORKING_ITEMS|TASK)\\.md)$"
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "description": "App release whose default was seeded"
        },
        "state": {
          "enum": [
            "default",
            "modified"
          ]
        },
        "defaultContent": {
          "$ref": "#/$defs/contentIdentity",
          "description": "The shipped default's identity, for comparison"
        }
      }
    },
    "workflowSource": {
      "type": "object",
      "required": [
        "workflow",
        "file",
        "revisionVerified"
      ],
      "additionalProperties": false,
      "properties": {
        "workflow": {
          "type": "object",
          "description": "WD-v0.8 §6.1 identity tuple of a registered revision (K-7: only registered revisions run)",
          "required": [
            "kind",
            "origin",
            "sourceRoot",
            "name",
            "revision"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "workflow"
            },
            "origin": {
              "enum": [
                "project",
                "user",
                "bundled",
                "host"
              ]
            },
            "sourceRoot": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "revision": {
              "$ref": "#/$defs/contentIdentity"
            },
            "derivedFrom": {
              "type": "string"
            }
          }
        },
        "file": {
          "const": "WORKFLOW.md"
        },
        "revisionVerified": {
          "const": true,
          "description": "The package was re-read at composition and its revision equals the selected one (WD HL-3); otherwise the supply is refused"
        },
        "runRef": {
          "type": "string",
          "description": "The workflow run this supply serves (EXEC run identity)"
        }
      }
    },
    "part": {
      "type": "object",
      "required": [
        "kind",
        "source",
        "content",
        "offset",
        "length"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "product-guidance",
            "role-guidance",
            "workflow"
          ]
        },
        "role": {
          "enum": [
            "HELP_HUMAN",
            "HELPS_HUMANS",
            "WORKING_ITEMS",
            "TASK"
          ]
        },
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/guidanceSource"
            },
            {
              "$ref": "#/$defs/workflowSource"
            }
          ]
        },
        "content": {
          "$ref": "#/$defs/contentIdentity"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Byte offset of the part in the UTF-8 composed text"
        },
        "length": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "workflow"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "source": {
                "$ref": "#/$defs/workflowSource"
              }
            }
          },
          "else": {
            "properties": {
              "source": {
                "$ref": "#/$defs/guidanceSource"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "role-guidance"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "role"
            ]
          }
        }
      ]
    },
    "childRole": {
      "type": "object",
      "required": [
        "role",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "HELP_HUMAN",
            "HELPS_HUMANS",
            "WORKING_ITEMS",
            "TASK"
          ]
        },
        "status": {
          "enum": [
            "supplied",
            "not-supplied"
          ]
        },
        "configKeys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^agents\\.(HELP_HUMAN|HELPS_HUMANS|WORKING_ITEMS|TASK)\\.(description|config_file)$"
          }
        },
        "composed": {
          "$ref": "#/$defs/contentIdentity",
          "description": "Identity of the child's developer_instructions text (product guidance + role)"
        },
        "file": {
          "$ref": "#/$defs/contentIdentity",
          "description": "Identity of the role configuration file the key names"
        },
        "reason": {
          "enum": [
            "user-configuration-defines-role",
            "not-offered-by-role",
            "mechanism-not-supported-at-pin",
            "user-configuration-not-read"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "supplied"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "configKeys",
              "composed",
              "file"
            ],
            "not": {
              "required": [
                "reason"
              ]
            }
          },
          "else": {
            "required": [
              "reason"
            ],
            "not": {
              "required": [
                "configKeys"
              ]
            }
          }
        }
      ]
    }
  }
}
