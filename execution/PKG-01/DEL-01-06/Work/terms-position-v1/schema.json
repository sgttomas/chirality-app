{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:distribution-terms-position:v1",
  "title": "Versioned retained supplier position and owner applicability account",
  "description": "Evidence/value representation only. Does not authenticate actors, interpret legal scope, authorize release or replace legacy PKG-v0.2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "record_id",
    "supplier",
    "state",
    "scope",
    "position",
    "owner_disposition",
    "distribution_decision",
    "recorded_by",
    "recorded_at",
    "limits"
  ],
  "properties": {
    "format": {
      "const": "chirality.distribution-terms-position/v1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "supplier": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "unresolved",
        "applicable_position_retained"
      ]
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "position": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/position"
        }
      ]
    },
    "owner_disposition": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/owner"
        }
      ]
    },
    "distribution_decision": {
      "oneOf": [
        {
          "const": "not_made"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actor",
            "evidence"
          ],
          "properties": {
            "actor": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "$ref": "#/$defs/artifact"
            }
          }
        }
      ]
    },
    "recorded_by": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|[+-]\\d\\d:\\d\\d)$"
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offering",
        "platform",
        "sign_in_flow",
        "implementation_revision",
        "includes_first_public_distribution"
      ],
      "properties": {
        "offering": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "sign_in_flow": {
          "type": "string",
          "minLength": 1
        },
        "implementation_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "includes_first_public_distribution": {
          "type": "boolean"
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "supplier",
        "source_url",
        "publication_or_response_date",
        "retrieved_or_received_at",
        "captured_by",
        "content",
        "full_content_sha256",
        "conditions",
        "exclusions",
        "custody"
      ],
      "properties": {
        "kind": {
          "enum": [
            "official_publication",
            "direct_response"
          ]
        },
        "supplier": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "publication_or_response_date": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
            }
          ]
        },
        "retrieved_or_received_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|[+-]\\d\\d:\\d\\d)$"
        },
        "captured_by": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "$ref": "#/$defs/artifact"
        },
        "full_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "custody": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "act",
        "approval"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "act": {
          "const": "received_adopted_retained_evidence"
        },
        "approval": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "purpose",
        "actor",
        "actor_role",
        "act",
        "decided_at",
        "source_kind",
        "supplier",
        "content",
        "full_content_sha256",
        "scope",
        "conditions",
        "exclusions",
        "approved_proposal",
        "owner_answer",
        "answer",
        "applicability",
        "release_authorized"
      ],
      "properties": {
        "format": {
          "const": "chirality.terms-applicability-disposition/v1"
        },
        "purpose": {
          "const": "terms_applicability_only"
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "actor_role": {
          "const": "owner"
        },
        "act": {
          "const": "received_adopted_retained_evidence"
        },
        "decided_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|[+-]\\d\\d:\\d\\d)$"
        },
        "source_kind": {
          "enum": [
            "official_publication",
            "direct_response"
          ]
        },
        "supplier": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "$ref": "#/$defs/artifact"
        },
        "full_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "approved_proposal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision",
            "artifact"
          ],
          "properties": {
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "artifact": {
              "$ref": "#/$defs/artifact"
            }
          }
        },
        "owner_answer": {
          "$ref": "#/$defs/artifact"
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "const": "accepted"
        },
        "release_authorized": {
          "const": false
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "purpose",
        "actor",
        "actor_role",
        "decided_at",
        "scope",
        "decision",
        "owner_answer",
        "answer"
      ],
      "properties": {
        "format": {
          "const": "chirality.public-distribution-decision/v1"
        },
        "purpose": {
          "const": "public_distribution_decision"
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "actor_role": {
          "const": "owner"
        },
        "decided_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|[+-]\\d\\d:\\d\\d)$"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "decision": {
          "enum": [
            "approved",
            "declined"
          ]
        },
        "owner_answer": {
          "$ref": "#/$defs/artifact"
        },
        "answer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "publication_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_url",
        "resolved_url",
        "retrieved_at",
        "http_status",
        "content_type",
        "last_modified",
        "bytes",
        "sha256",
        "supplier",
        "publication_date",
        "publication_date_note",
        "capture_actor",
        "capture_method",
        "full_response_custody",
        "excerpts",
        "standing"
      ],
      "properties": {
        "requested_url": {
          "type": "string",
          "minLength": 1
        },
        "resolved_url": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|[+-]\\d\\d:\\d\\d)$"
        },
        "http_status": {
          "const": 200
        },
        "content_type": {
          "type": "string",
          "minLength": 1
        },
        "last_modified": {
          "type": [
            "string",
            "null"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "supplier": {
          "type": "string",
          "minLength": 1
        },
        "publication_date": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
            }
          ]
        },
        "publication_date_note": {
          "type": "string",
          "minLength": 1
        },
        "capture_actor": {
          "type": "string",
          "minLength": 1
        },
        "capture_method": {
          "type": "string",
          "minLength": 1
        },
        "full_response_custody": {
          "type": "string",
          "minLength": 1
        },
        "excerpts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section",
              "html",
              "text",
              "html_sha256"
            ],
            "properties": {
              "section": {
                "type": "string",
                "minLength": 1
              },
              "html": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "html_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "standing": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "response_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "supplier",
        "source_url",
        "received_at",
        "response_date",
        "captured_by",
        "response_text",
        "sha256"
      ],
      "properties": {
        "format": {
          "const": "chirality.supplier-response-capture/v1"
        },
        "supplier": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "received_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|[+-]\\d\\d:\\d\\d)$"
        },
        "response_date": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
            }
          ]
        },
        "captured_by": {
          "type": "string",
          "minLength": 1
        },
        "response_text": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "owner_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "thread",
        "message_id",
        "created_by",
        "recorded_timestamp",
        "content"
      ],
      "properties": {
        "format": {
          "const": "chirality.terms-owner-answer/v1"
        },
        "thread": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "created_by": {
          "const": "user"
        },
        "recorded_timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?(?:Z|[+-]\\d\\d:\\d\\d)$"
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "standing": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "applicable_position_retained"
          }
        }
      },
      "then": {
        "properties": {
          "position": {
            "$ref": "#/$defs/position"
          },
          "owner_disposition": {
            "$ref": "#/$defs/owner"
          }
        }
      },
      "else": {
        "properties": {
          "owner_disposition": {
            "type": "null"
          }
        }
      }
    }
  ]
}
