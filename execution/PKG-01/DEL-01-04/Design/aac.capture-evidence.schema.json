{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:app-v4:del-01-04:aac:capture-evidence:0.3",
  "title": "App act control capture evidence (PROPOSED, DEL-01-04/AAC-v0.2 §5.2; schema 0.3 at RV21)",
  "description": "PROPOSED by DEL-01-04/AAC-v0.2 (R17-1, R17-6). The capture-evidence object EXEC CAP-3 names: {act identity, actor, act kind, bound content identity with method designation, scope, purpose, time, capturing surface 'App interface', arrival reference}. Produced on the capture side only from the person's native confirmation of a presented offer (CAP-4; R17-5 PROPOSED); DEL-04-03's human_act or act_declined record cites it by 'captureId' (RS §6.1; RS §9). The actor is named from what the App observes, never verified (DECISION-K1 K1-4; EXEC CAP-8); 'codexAccount' takes exactly RS's two forms, the reported email or 'ChatGPT account (no email reported)', and no plan type is recorded (R18-1 C-10; RS $defs/person; V21-B m-11). An A15 capture names the one DEL-02-02 descriptor it was composed from (R21-3) and lists its entries (DECISION-L L-4), each with the revision, the reviewed content (WR ID-3 string, 'draft:' or 'entry:', and content) and the prior revision (RS workflowTuple or null) (R17-11; R18-1 C-01), and, once DEL-02-02 reports it, that entry's registration outcome beside the act, never part of it (AAC AK-f). 'seal' is SEAL-2's optional provenance element (AAC §6.3). Schema 0.3 (RV21; R21-3, V21-B m-11). AAC-v0.3 rows (pass 4, R23-18; run APP-V4-DESIGN-PASS-4-20261003, owner O-A): A16 'decide' with the alternative chosen (alternativeChosen) and its request; additive, taken in place in schema 0.3 as the RV21 changes were.",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "captureId",
    "offerId",
    "offerDigest",
    "choice",
    "actKind",
    "actor",
    "boundSubject",
    "boundContent",
    "scope",
    "purpose",
    "capturedAt",
    "surface",
    "inputSource",
    "answers",
    "evidenceLimits"
  ],
  "additionalProperties": false,
  "$defs": {
    "contentIdentity": {
      "type": "object",
      "required": [
        "method",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workflowTuple": {
      "description": "RS $defs/workflowTuple (RS-v0.9; WD §6.1 identity tuple in RS's spelling), copied here so the schema stands alone; C-01 makes RS's the persisted form.",
      "type": "object",
      "required": [
        "kind",
        "origin",
        "sourceRoot",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "workflow"
        },
        "origin": {
          "enum": [
            "project",
            "user",
            "bundled",
            "host"
          ]
        },
        "sourceRoot": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "revisionMethod": {
          "type": "string",
          "minLength": 1
        },
        "derivedFrom": {
          "$ref": "#/$defs/workflowTuple"
        }
      }
    },
    "reviewedDraft": {
      "type": "object",
      "required": [
        "draft",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "draft": {
          "type": "string",
          "pattern": "^(draft|entry):(project|user):[^@]+@.+$",
          "description": "WR ID-3 string (C-01): 'draft:<location>:<name>@<content identity>' for a reviewed draft (WR `a15_descriptor`), or 'entry:<location>:<name>@<content identity>' for a library entry reviewed in place (WR `a15_multi_descriptor`, §4.7; L-4); RS-v0.9's pattern (R21-3)."
        },
        "content": {
          "$ref": "#/$defs/contentIdentity"
        }
      }
    },
    "priorRevision": {
      "anyOf": [
        {
          "$ref": "#/$defs/workflowTuple"
        },
        {
          "type": "null"
        }
      ],
      "description": "The revision this one follows (K-6) as an RS workflowTuple, or null for a first revision (C-01)."
    }
  },
  "properties": {
    "format": {
      "const": "chirality.aac.capture-evidence"
    },
    "formatVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "captureId": {
      "type": "string",
      "pattern": "^cap:"
    },
    "offerId": {
      "type": "string",
      "pattern": "^offer:"
    },
    "offerDigest": {
      "$ref": "#/$defs/contentIdentity"
    },
    "choice": {
      "enum": [
        "act",
        "decline"
      ]
    },
    "actKind": {
      "enum": [
        "A4",
        "A6",
        "A7",
        "A15",
        "A16"
      ]
    },
    "actor": {
      "type": "object",
      "required": [
        "identityVerified"
      ],
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "osAccount": {
          "type": "string",
          "minLength": 1
        },
        "codexAccount": {
          "description": "RS $defs/person.codexAccount (RS-v0.9; ACCESS-v0.2 I-6): the reported email of the ChatGPT account of the Codex home that runs the conversation, or 'ChatGPT account (no email reported)'; no plan type (R18-1 C-10).",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[^@\\s]+@[^@\\s]+$"
            },
            {
              "const": "ChatGPT account (no email reported)"
            }
          ]
        },
        "identityVerified": {
          "const": false
        }
      },
      "anyOf": [
        {
          "required": [
            "displayName"
          ]
        },
        {
          "required": [
            "osAccount"
          ]
        },
        {
          "required": [
            "codexAccount"
          ]
        }
      ]
    },
    "boundSubject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "boundContent": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/contentIdentity"
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "description": "A16 CC-A / CI-4 (owner-selected explicit absence label): nonempty package scope copied unchanged; absent or empty package scope represented exactly as \"not named by the package\", never inferred. Offer/native confirmation/capture/RS copy the same wording. Non-string package scope is invalid, not absent. Other act kinds retain their own authoritative scope rules."
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "capturedAt": {
      "type": "string",
      "minLength": 1
    },
    "surface": {
      "const": "App interface"
    },
    "inputSource": {
      "const": "host-native-confirmation"
    },
    "answers": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "arrival",
            "runId"
          ],
          "additionalProperties": false,
          "properties": {
            "arrival": {
              "type": "object",
              "required": [
                "checkpoint",
                "arrivalOrdinal"
              ],
              "additionalProperties": false,
              "properties": {
                "checkpoint": {
                  "type": "string",
                  "minLength": 1
                },
                "arrivalOrdinal": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "runId": {
              "type": "string",
              "pattern": "^run:"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "standing"
          ],
          "additionalProperties": false,
          "properties": {
            "standing": {
              "const": "no arrival: a standing act (RC-6)"
            }
          }
        }
      ]
    },
    "requestRef": {
      "type": "string",
      "pattern": "^rec:"
    },
    "descriptorId": {
      "type": "string",
      "minLength": 1,
      "description": "The identity of the one DEL-02-02 descriptor this A15 act is composed from (R21-3; WR `descriptor_id`)."
    },
    "descriptorKind": {
      "enum": [
        "a15_descriptor",
        "a15_multi_descriptor"
      ],
      "description": "The kind of DEL-02-02's descriptor the A15 act is composed from: one descriptor per act (R21-3). 'a15_descriptor' (WR RB-4): one reviewed draft, one entry. 'a15_multi_descriptor' (WR §4.7 ME-3): two or more library entries registered in place, in one act."
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "revision",
          "reviewedDraft",
          "priorRevision"
        ],
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "reviewedDraft": {
            "$ref": "#/$defs/reviewedDraft"
          },
          "priorRevision": {
            "$ref": "#/$defs/priorRevision"
          },
          "outcome": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "registration",
                  "revisionIdentity"
                ],
                "additionalProperties": false,
                "properties": {
                  "registration": {
                    "const": "completed"
                  },
                  "revisionIdentity": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "registration",
                  "reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "registration": {
                    "const": "not completed"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "registration",
                  "revisionIdentity"
                ],
                "additionalProperties": false,
                "properties": {
                  "registration": {
                    "const": "re-confirmed"
                  },
                  "revisionIdentity": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      }
    },
    "recordId": {
      "type": "string",
      "pattern": "^rec:",
      "description": "CC-A / AAC-v0.4 candidate §5.2a: absent at initial durable capture; added once only after a verified successful RS append, using atomic host replacement preserving act facts. Equal is idempotent; a different backlink is a conflict. Recovery joins by the RS capture-evidence reference before deciding to append. Schema shape remains 0.3; runtime rules are not expressible by this field schema."
    },
    "evidenceLimits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "seal": {
      "$ref": "#/$defs/contentIdentity"
    },
    "alternativeChosen": {
      "description": "A16 (R23-8): the identity of the alternative the person chose.",
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "description": "A decline exists only where ACT §2.3 defines an act-declined event.",
      "anyOf": [
        {
          "properties": {
            "choice": {
              "const": "act"
            }
          }
        },
        {
          "properties": {
            "actKind": {
              "enum": [
                "A4",
                "A6",
                "A7"
              ]
            }
          }
        }
      ]
    },
    {
      "description": "A15 names its one descriptor and lists its entries (R21-3; L-4; R17-11; C-01).",
      "anyOf": [
        {
          "properties": {
            "actKind": {
              "not": {
                "const": "A15"
              }
            }
          }
        },
        {
          "required": [
            "descriptorId",
            "descriptorKind",
            "entries"
          ]
        }
      ]
    },
    {
      "description": "Entries and the descriptor belong to A15 only.",
      "anyOf": [
        {
          "properties": {
            "actKind": {
              "const": "A15"
            }
          }
        },
        {
          "allOf": [
            {
              "not": {
                "required": [
                  "entries"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "descriptorId"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "descriptorKind"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "description": "An a15_descriptor (WR RB-4): exactly one entry, a reviewed draft ('draft:' form).",
      "anyOf": [
        {
          "not": {
            "required": [
              "descriptorKind"
            ],
            "properties": {
              "descriptorKind": {
                "const": "a15_descriptor"
              }
            }
          }
        },
        {
          "properties": {
            "entries": {
              "not": {
                "type": "array",
                "minItems": 2
              },
              "items": {
                "properties": {
                  "reviewedDraft": {
                    "properties": {
                      "draft": {
                        "pattern": "^draft:"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "description": "An a15_multi_descriptor (WR §4.7 ME-3; L-4): two or more library entries reviewed in place ('entry:' form), none with a prior revision.",
      "anyOf": [
        {
          "not": {
            "required": [
              "descriptorKind"
            ],
            "properties": {
              "descriptorKind": {
                "const": "a15_multi_descriptor"
              }
            }
          }
        },
        {
          "properties": {
            "entries": {
              "minItems": 2,
              "items": {
                "properties": {
                  "reviewedDraft": {
                    "properties": {
                      "draft": {
                        "pattern": "^entry:"
                      }
                    }
                  },
                  "priorRevision": {
                    "type": "null"
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "description": "A16 (R23-8) names its request and the alternative chosen; alternativeChosen is A16's only.",
      "allOf": [
        {
          "anyOf": [
            {
              "properties": {
                "actKind": {
                  "not": {
                    "const": "A16"
                  }
                }
              }
            },
            {
              "required": [
                "requestRef",
                "alternativeChosen"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "properties": {
                "actKind": {
                  "const": "A16"
                }
              }
            },
            {
              "not": {
                "required": [
                  "alternativeChosen"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
