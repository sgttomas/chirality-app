{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:app-v4:del-01-02:app-ledger-entry:0.3",
  "title": "DEL-01-02 App ledger entry — what the App keeps across relaunch (PROPOSED)",
  "description": "EXECUTION_AND_RECOVERY.md §7. Append-only, one entry per line (as RS S-A); location and technology unselected (TBD-002). Pointers and App-observed facts only: no message, item, plan, command text, tool output or request payload is kept; those are read back from Codex (ARCHITECTURE §3; R17-4).",
  "oneOf": [
    {
      "$ref": "#/$defs/session_started"
    },
    {
      "$ref": "#/$defs/quit_requested"
    },
    {
      "$ref": "#/$defs/quit_answered"
    },
    {
      "$ref": "#/$defs/session_ended"
    },
    {
      "$ref": "#/$defs/conversation_index"
    },
    {
      "$ref": "#/$defs/register_entry_summary"
    },
    {
      "$ref": "#/$defs/stop_request"
    },
    {
      "$ref": "#/$defs/lifecycle_ref"
    },
    {
      "$ref": "#/$defs/codex_stop"
    }
  ],
  "$defs": {
    "session_started": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "session",
        "at",
        "previousSessionEnd",
        "candidate"
      ],
      "properties": {
        "kind": {
          "const": "session_started"
        },
        "session": {
          "$ref": "#/$defs/nonempty"
        },
        "at": {
          "$ref": "#/$defs/nonempty"
        },
        "previousSession": {
          "$ref": "#/$defs/nonempty"
        },
        "previousSessionEnd": {
          "enum": [
            "none",
            "clean",
            "quit-with-live-work",
            "ended-without-record",
            "system-terminated"
          ]
        },
        "candidate": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "quit_requested": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "session",
        "at",
        "actor",
        "liveTurns",
        "outstandingEntries",
        "activeDescendants"
      ],
      "properties": {
        "kind": {
          "const": "quit_requested"
        },
        "session": {
          "$ref": "#/$defs/nonempty"
        },
        "at": {
          "$ref": "#/$defs/nonempty"
        },
        "actor": {
          "$ref": "#/$defs/person"
        },
        "liveTurns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/turnRef"
          }
        },
        "outstandingEntries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entryRef"
          }
        },
        "activeDescendants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/descendant"
          }
        }
      }
    },
    "quit_answered": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "session",
        "at",
        "answer",
        "actor"
      ],
      "properties": {
        "kind": {
          "const": "quit_answered"
        },
        "session": {
          "$ref": "#/$defs/nonempty"
        },
        "at": {
          "$ref": "#/$defs/nonempty"
        },
        "answer": {
          "enum": [
            "confirmed",
            "cancelled"
          ]
        },
        "actor": {
          "$ref": "#/$defs/person"
        }
      }
    },
    "session_ended": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "session",
        "at",
        "how",
        "stopRequests"
      ],
      "properties": {
        "kind": {
          "const": "session_ended"
        },
        "session": {
          "$ref": "#/$defs/nonempty"
        },
        "at": {
          "$ref": "#/$defs/nonempty"
        },
        "how": {
          "enum": [
            "quit",
            "system-terminated"
          ]
        },
        "stopRequests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "stopRequestId",
              "state"
            ],
            "additionalProperties": false,
            "properties": {
              "stopRequestId": {
                "type": "string",
                "pattern": "^stop:.+"
              },
              "state": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "conversation_index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "session",
        "at",
        "threadId",
        "home",
        "project",
        "tags",
        "lastObservedExecution"
      ],
      "properties": {
        "kind": {
          "const": "conversation_index"
        },
        "session": {
          "$ref": "#/$defs/nonempty"
        },
        "at": {
          "$ref": "#/$defs/nonempty"
        },
        "threadId": {
          "$ref": "#/$defs/nonempty"
        },
        "home": {
          "$ref": "#/$defs/home"
        },
        "forkedFrom": {
          "description": "The source thread when this conversation was made by thread/fork (OBS-3 W-6: the fork's history is referenced from the source's rollout).",
          "$ref": "#/$defs/nonempty"
        },
        "project": {
          "description": "Opaque known App project reference, including an explicitly configured/opened directory reference. CC-REC-ATTACHMENT-PROJECT-CONTEXT: no row for unestablished project; never null/fake unknown/cwd fallback. Historical association is not renamed by a new submission context.",
          "$ref": "#/$defs/nonempty"
        },
        "tags": {
          "description": "Opaque tags handed at run time by receivers (for example a run reference). Several per owner, in order (seq), so that runs follow one another in one conversation (R19-2). Stored and returned, never interpreted (R17-10). CC-REC-ATTACHMENT-PROJECT-CONTEXT adds owner DEL-01-04 compact [submissionRef, projectRef-or-null] string; null is only within that opaque value, not the project field.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "owner",
              "value",
              "seq"
            ],
            "additionalProperties": false,
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "seq": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "lastObservedExecution": {
          "description": "Shown only as 'last observed by the App at ‹at›', never as Codex's state.",
          "type": "object",
          "required": [
            "state",
            "at"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "indexed",
                "recovery-pending",
                "recovering",
                "unavailable",
                "loaded-idle",
                "turn-live",
                "interrupt-pending",
                "system-error",
                "observation-lost"
              ]
            },
            "at": {
              "type": "string",
              "minLength": 1
            },
            "liveTurn": {
              "type": "string",
              "minLength": 1
            },
            "lostCause": {
              "$ref": "#/$defs/lossContext"
            },
            "abortNoteExpected": {
              "description": "G-5: the live turn was ended by a graceful stop, after which Codex 0.158.0 writes its abort note into history (OBS-2 §5.2).",
              "type": "boolean"
            },
            "openItems": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "itemId",
                  "itemType"
                ],
                "additionalProperties": false,
                "properties": {
                  "itemId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "itemType": {
                    "type": "string",
                    "minLength": 1
                  },
                  "turnId": {
                    "description": "CC-REC-ITEM-TURN-CUSTODY: actual observed opaque native turn reference. Absent means unknown; never infer from liveTurn. Scope is enclosing thread/home/lastLoadedGeneration.",
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "lastLoadedGeneration": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "register_entry_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "session",
        "at",
        "generation",
        "requestIdentity",
        "method",
        "state",
        "transition"
      ],
      "properties": {
        "kind": {
          "const": "register_entry_summary"
        },
        "session": {
          "$ref": "#/$defs/nonempty"
        },
        "at": {
          "$ref": "#/$defs/nonempty"
        },
        "generation": {
          "$ref": "#/$defs/nonempty"
        },
        "requestIdentity": {
          "$ref": "#/$defs/nonempty"
        },
        "method": {
          "$ref": "#/$defs/nonempty"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "state": {
          "enum": [
            "listed",
            "closed"
          ]
        },
        "transition": {
          "type": "string",
          "pattern": "^RQ-[0-9][0-9]$"
        },
        "endedAs": {
          "enum": [
            "answered",
            "declined",
            "errored",
            "resolved-by-supplier",
            "settle-write-failed",
            "ended-unanswered(process-exit)"
          ]
        },
        "origin": {
          "type": "string",
          "pattern": "^(person-via-interaction|app-explicit-error|supplier-internal|app-rule:.+)$"
        },
        "replyWrite": {
          "enum": [
            "written",
            "write-failed",
            "not-attempted"
          ]
        },
        "acknowledgment": {
          "enum": [
            "observed",
            "not-observed",
            "not-observable-at-pin"
          ]
        },
        "context": {
          "$ref": "#/$defs/lossContext"
        },
        "sameItemAs": {
          "description": "RQ-07: an earlier entry with the same subject item reference (observed equality of the reference, not the same request).",
          "$ref": "#/$defs/nonempty"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "closed"
              }
            }
          },
          "then": {
            "required": [
              "endedAs"
            ]
          }
        }
      ]
    },
    "stop_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "session",
        "at",
        "record"
      ],
      "properties": {
        "kind": {
          "const": "stop_request"
        },
        "session": {
          "$ref": "#/$defs/nonempty"
        },
        "at": {
          "$ref": "#/$defs/nonempty"
        },
        "record": {
          "description": "A recovery.stop-request record (validated against that schema).",
          "type": "object"
        }
      }
    },
    "lifecycle_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "session",
        "at",
        "home",
        "generation",
        "transition",
        "state"
      ],
      "properties": {
        "kind": {
          "const": "lifecycle_ref"
        },
        "session": {
          "$ref": "#/$defs/nonempty"
        },
        "at": {
          "$ref": "#/$defs/nonempty"
        },
        "home": {
          "$ref": "#/$defs/home"
        },
        "generation": {
          "$ref": "#/$defs/nonempty"
        },
        "transition": {
          "type": "string",
          "pattern": "^LT-[0-9][0-9]$"
        },
        "state": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "codex_stop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "session",
        "at",
        "actor",
        "homes",
        "restart",
        "liveTurns",
        "outstandingEntries"
      ],
      "properties": {
        "kind": {
          "const": "codex_stop"
        },
        "session": {
          "$ref": "#/$defs/nonempty"
        },
        "at": {
          "$ref": "#/$defs/nonempty"
        },
        "actor": {
          "$ref": "#/$defs/person"
        },
        "homes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/home"
          }
        },
        "restart": {
          "type": "boolean"
        },
        "liveTurns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/turnRef"
          }
        },
        "outstandingEntries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entryRef"
          }
        }
      }
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "person": {
      "description": "DECISION-K1 K1-4: the person as the App observes them, never verified.",
      "type": "object",
      "required": [
        "kind",
        "identity",
        "identityStatus"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "person"
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "identityStatus": {
          "const": "identity not verified"
        }
      }
    },
    "turnRef": {
      "type": "object",
      "required": [
        "threadId",
        "turnId"
      ],
      "additionalProperties": false,
      "properties": {
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "turnId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "subject": {
      "description": "Supplier references carried as data (HOSTING §6.1 subject references); never payload content.",
      "type": "object",
      "required": [
        "threadId"
      ],
      "additionalProperties": false,
      "properties": {
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "turnId": {
          "type": "string",
          "minLength": 1
        },
        "itemId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entryRef": {
      "description": "A register entry by reference: generation, identity, method and subject only. Native parameters are never carried (R17-4).",
      "type": "object",
      "required": [
        "generation",
        "requestIdentity",
        "method"
      ],
      "additionalProperties": false,
      "properties": {
        "generation": {
          "type": "string",
          "minLength": 1
        },
        "requestIdentity": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "$ref": "#/$defs/subject"
        }
      }
    },
    "descendant": {
      "type": "object",
      "required": [
        "kind",
        "ref",
        "observedStatus"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "child-thread",
            "background-terminal",
            "process"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "observedStatus": {
          "enum": [
            "active",
            "ended",
            "unknown"
          ]
        }
      }
    },
    "lossContext": {
      "enum": [
        "supplier-exit",
        "supplier-stop",
        "app-quit",
        "system-termination",
        "app-ended-without-record"
      ]
    },
    "home": {
      "description": "The App-owned Codex home (DECISION-L L-1): H-acct, or H-key for API-key conversations.",
      "type": "string",
      "pattern": "^H-[a-z]+$"
    }
  }
}
