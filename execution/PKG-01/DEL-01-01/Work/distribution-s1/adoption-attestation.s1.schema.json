          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "decision": {
          "const": "adopt-for-supplier-reference"
        },
        "evidence": {
          "type": "object",
