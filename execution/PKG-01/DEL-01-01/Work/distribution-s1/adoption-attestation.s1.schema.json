        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "independent_reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_revision": {
      "type": "string",
      "minLength": 1
    },
    "review_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "through_help_human": {
          "type": "object",
