                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Exact relative UTF-8 path; semantic checks enforce components, uniqueness and parent directories. Root is dot, directory only."
                      },
                      "mode": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4095,
                        "description": "POSIX st_mode & 07777; decimal representation."
                      },
                      "kind": {
                        "const": "dir"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "kind",
                      "mode",
                      "size",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Exact relative UTF-8 path; semantic checks enforce components, uniqueness and parent directories. Root is dot, directory only."
                      },
                      "mode": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4095,
                        "description": "POSIX st_mode & 07777; decimal representation."
                      },
                      "kind": {
                        "const": "file"
                      },
                      "size": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$",
                        "minLength": 64,
                        "maxLength": 64
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "type": "null"
        }
