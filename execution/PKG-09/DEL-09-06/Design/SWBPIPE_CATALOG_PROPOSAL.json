  "source": {
    "chiralityRevision": "1560bbf7f7add4637a20572a2b0d404ef121af63",
    "appRevision": "5e61fbd88ff8a4fe221b25cbd9e967d2a6fdce09",
    "integrationProposalSha256": "7d6dd0a0c3b11bb8ec14394ae890de0cf3c6a239aed9b55d01ef03c38b9117ab",
    "steeringSha256": "0a33bbba6a898ed22a801db48267fbb85b2a0b2638f298a01f2f1db401b06e90"
  },
  "schemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "descriptorConvention": "MCP 2026-07-28 stateless; expand catalog-local schema references before publishing descriptors; not a complete MCP wire server",
  "projection": {
    "supplier": "0.160.0",
    "declarationFields": [
      "type",
      "name",
      "description",
      "inputSchema"
    ],
    "type": "function",
    "responseFields": [
      "contentItems",
      "success"
    ],
    "textItemType": "inputText",
    "successRule": "false only for execution_error; rejection, stale_basis, unavailable and unknown are domain outcomes, not affirmative execution claims",
    "internalResultFields": [
      "content",
      "structuredContent",
      "isError"
    ]
  },
  "limits": {
    "argumentBytes": 16384,
    "resultBytes": 65536,
    "pageRows": 50,
    "pendingCalls": 16,
    "proposalOperations": 16
  },
  "hostPolicy": {
    "liveModelOwner": "webview workspaceSession.ts",
    "completionRoute": "new command_ingress-admitted command, not implemented here",
    "binding": [
      "requestRef",
      "rpcId",
      "threadId",
      "turnId",
      "callId",
      "tool",
      "workspaceHandle",
      "applicationGeneration",
      "modelRevision"
    ],
    "bootstrap": "Host binds the conversation to an admitted session; read_model_summary takes no arguments and returns its handle and basis. Handles do not establish identity or authority.",
    "handles": "Host-issued opaque workspace/proposal/run/page handles; scoped to admitted generation and workspace; never filesystem paths. Restart invalidates handles; unavailable/unknown, never redispatch. Cursor binds tool, basis, run and next offset.",
    "attribution": "Host stamps author_type=agent and original conversation/turn/call; never accepts user attribution from tool arguments.",
    "proposal": "Require claimedModelHash == basis.modelHash == current session hash before queue registration. Pass operations in native EditorOperationIntent shape to a host-created OperationBatch; no alternate field-edit language. Current discriminator is native operation_kind=modify, target.object_type=Node, change.change_kind=set_field with position.x/y/z. Extend those native discriminators and subschemas, not tool names. Rust applier remains semantic validator. Treat validation/source/id fields as untrusted; host stamps conversation attribution and queues immutable submission via existing preview/human apply route.",
    "completion": "Resolve host-issued requestRef against pending call; webview cannot choose RPC destination. Check binding and current session generation/revision before completing; serialize queue/apply/interrupt transitions.",
    "interruption": "Withdraw pending review only; application already admitted yields actual outcome or unknown. Turn interruption is not solve cancellation or rollback.",
    "limits": "Apply the smaller of catalog caps and existing admission budgets before parsing/allocating argument or result payloads; bounded producers, no whole-model serialization followed by truncation.",
    "results": "Use existing permitted view/value-record semantics and redaction floors. No raw private row bypass. Preserve exact decimal where required; withheld/unavailable has no numeric value. A run handle binds its evaluated model hash, never relabel historical results as current.",
    "autonomy": "No apply/accept/release/grant tools. Any later autonomy needs separately authorized host policy and implementation.",
    "solve": "Require claimedModelHash == basis.modelHash == current session hash before handleRun; retain evaluated hash even if run id changes. Return session solverMode, health and run handle; progress only to existing supported notifications/panel."
  },
