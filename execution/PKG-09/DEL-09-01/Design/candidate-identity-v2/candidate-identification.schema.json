{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:app-v4:del-09-01:candidate-identification:2",
  "title": "Development App candidate identification (candidate-identity-v2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "candidate_key",
    "app_candidate",
    "route",
    "source",
    "build",
    "bundle",
    "app_data",
    "supplier",
    "identified_by",
    "identified_at",
    "limits"
  ],
  "properties": {
    "format": {
      "const": "chirality.app-v4.candidate-identification/v2"
    },
    "candidate_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{10}-[0-9a-f]{12}$"
    },
    "app_candidate": {
      "description": "Exactly the EXP candidate_subject.app_candidate values for this build.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "build_identity",
        "packaged"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "build_identity": {
          "type": "string",
          "pattern": "^chirality\\.app\\.bundle-tree\\.sha256/v2:[0-9a-f]{64}$"
        },
        "packaged": {
          "const": false
        }
      }
    },
    "route": {
      "const": "native_development"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "commit_tree",
        "exported_prefix",
        "tree",
        "tracked_files_verified"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "commit_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "exported_prefix": {
          "type": "string",
          "minLength": 1
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tracked_files_verified": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "procedure",
        "profile",
        "signing",
        "features",
        "command",
        "config_overlays",
        "toolchain",
        "lockfiles",
        "offline",
        "environment",
        "started_at",
        "finished_at"
      ],
      "properties": {
        "procedure": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "enum": [
            "debug",
            "release"
          ]
        },
        "signing": {
          "type": "string",
          "minLength": 1
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "config_overlays": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "content": {
                "type": "object"
              }
            }
          }
        },
        "toolchain": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "lockfiles": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "offline": {
          "const": true
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "phases": {
          "description": "Optional timing account of the build steps between started_at and finished_at.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "identifier",
        "version",
        "executable",
        "info_plist_sha256",
        "file_manifest_sha256",
        "counts",
        "metadata_state",
        "inventory"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\.app$"
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "executable": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "info_plist_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "file_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dir",
            "file",
            "symlink"
          ],
          "properties": {
            "dir": {
              "type": "integer",
              "minimum": 0
            },
            "file": {
              "type": "integer",
              "minimum": 0
            },
            "symlink": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "metadata_state": {
          "description": "Observed metadata of the root and every entry: refused states are zero by construction; represented extended attributes and owners are listed.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entries_including_root",
            "acl_entries",
            "nonzero_flags",
            "set_id_bits",
            "extended_attributes",
            "xattr_allowlist",
            "owners",
            "symlinks"
          ],
          "properties": {
            "entries_including_root": {
              "type": "integer",
              "minimum": 1
            },
            "acl_entries": {
              "const": 0
            },
            "nonzero_flags": {
              "const": 0
            },
            "set_id_bits": {
              "const": 0
            },
            "extended_attributes": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            },
            "xattr_allowlist": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "owners": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "uid",
                  "gid"
                ],
                "properties": {
                  "uid": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "gid": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "symlinks": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "const": "bundle-inventory.json"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "app_data": {
      "description": "Per-user places the bundle identifier selects; every one must be absent (no entry of any kind, including a dangling link) so the candidate starts fresh.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "checked",
        "present_at_identification"
      ],
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "checked": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "present_at_identification": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "supplier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundled",
        "binding"
      ],
      "properties": {
        "bundled": {
          "const": false
        },
        "binding": {
          "type": "string"
        }
      }
    },
    "identified_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "tool_sha256",
        "method"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "tool_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "method": {
          "const": "chirality.app.bundle-tree.sha256/v2"
        }
      }
    },
    "identified_at": {
      "type": "string",
      "format": "date-time"
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
