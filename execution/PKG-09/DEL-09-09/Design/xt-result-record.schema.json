{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:app-v4:proposed:xt-result-record",
  "title": "XT result record per case (DEL-09-09 XT-v0.6 §3.4; PROPOSED, node B7; R12-1, R12-2)",
  "description": "One record per executed or not-run V4-EXM-25 case (XC-00…XC-12) or V4-EXM-24 trace case (TR-01…TR-10). Property names are Chirality semantic labels; no host or supplier wire field is selected. Host receipts and act records are linked, never copied (V4-HI-71). A rehearsal on a test double (SH-1, C-v0.8 §10.8) never completes a joined case (XT §0, §3.3).",
  "type": "object",
  "required": ["record_kind", "format", "case", "witness", "phase_reading", "run_kind", "evidence_label", "subject_of_run", "configuration", "date", "suite_position", "outcome", "parts", "evidence_limits", "missing_inputs", "completion"],
  "additionalProperties": false,
  "properties": {
    "record_kind": {"const": "xt_result"},
    "format": {"const": "proposed-0.1"},
    "record_id": {"type": "string", "minLength": 1},
    "case": {"type": "string", "pattern": "^(XC-(0[0-9]|1[0-2])|TR-(0[1-9]|10))$"},
    "witness": {"enum": ["V4-EXM-25", "V4-EXM-24"]},
    "phase_reading": {"enum": ["current", "governance"]},
    "run_kind": {"enum": ["joined_witness", "rehearsal", "definition_check"]},
    "evidence_label": {"enum": ["illustrative", "test_double", "actual_host", "not_observed", "limited"]},
    "case_state_at_run": {"enum": ["DESIGNED", "AWAITING INPUT", "HELD"]},
    "rehearsal_of": {"type": "array", "items": {"type": "string", "pattern": "^XF-[0-9]{2}"}},
    "subject_of_run": {
      "oneOf": [
        {"$ref": "#/$defs/candidates"},
        {"$ref": "#/$defs/double"},
        {"$ref": "#/$defs/definition"}
      ]
    },
    "configuration": {"$ref": "#/$defs/configuration"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"},
    "suite_position": {
      "description": "XT §3.5: segment, order in the suite and the saved state the case starts from.",
      "type": "object",
      "required": ["segment", "order", "starts_from", "reset_after"],
      "additionalProperties": false,
      "properties": {
        "segment": {"enum": ["M", "B-T9", "B-T10", "B-T11", "B-E1", "none"]},
        "order": {"type": "integer", "minimum": 1},
        "starts_from": {"type": "string", "minLength": 1},
        "reset_after": {"type": "string", "minLength": 1}
      }
    },
    "outcome": {
      "description": "EXAMINATION §1 values; aggregation over parts as W14 (CA §8.4): failed > blocked > passed (all parts) > not_run (no part ran) > inconclusive.",
      "enum": ["passed", "failed", "blocked", "not_run", "inconclusive"]
    },
    "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/part"}},
    "comparisons": {
      "description": "TR cases only (XT §4.3): one result per comparison category across H, E and X.",
      "type": "array",
      "items": {"$ref": "#/$defs/comparison"}
    },
    "act_records_cited": {"type": "array", "items": {"$ref": "#/$defs/act_citation"}},
    "evidence_limits": {"description": "RS R11 evidence-limit labels in RS's own spelling (RS-v0.8 RS_RECORD.schema.json); an act record's own limits go on the act citation (record_limits). The suite prototype maps the ADAPTER mapper's tokens once and checks every label against RS's list (V18-4 m-2; RP-4).", "type": "array", "items": {"type": "string", "minLength": 1}},
    "missing_inputs": {"type": "array", "items": {"$ref": "#/$defs/missing_input"}},
    "blocked_by": {"type": "string", "minLength": 1},
    "completion": {
      "type": "object",
      "required": ["counts_toward_witness", "reason"],
      "additionalProperties": false,
      "properties": {
        "counts_toward_witness": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "description": "X-R1: only an actual-host joined observation can count toward the witness (§3.3; §4.5).",
      "if": {
        "anyOf": [
          {"not": {"properties": {"evidence_label": {"const": "actual_host"}}}},
          {"not": {"properties": {"run_kind": {"const": "joined_witness"}}}},
          {"properties": {"outcome": {"const": "not_run"}}}
        ]
      },
      "then": {"properties": {"completion": {"properties": {"counts_toward_witness": {"const": false}}}}}
    },
    {
      "if": {"properties": {"run_kind": {"const": "joined_witness"}}},
      "then": {"properties": {"subject_of_run": {"$ref": "#/$defs/candidates"}}}
    },
    {
      "if": {"properties": {"run_kind": {"const": "rehearsal"}}},
      "then": {"properties": {"subject_of_run": {"$ref": "#/$defs/double"}, "evidence_label": {"enum": ["test_double", "limited", "not_observed"]}}}
    },
    {
      "description": "X-R2: not run or blocked says what was missing or what blocked it (§3.5 rule SR-4).",
      "if": {"properties": {"outcome": {"enum": ["not_run", "blocked"]}}},
      "then": {"anyOf": [{"properties": {"missing_inputs": {"minItems": 1}}}, {"required": ["blocked_by"]}]}
    },
    {
      "description": "X-R3: witness follows the case family.",
      "if": {"properties": {"case": {"pattern": "^TR-"}}},
      "then": {"properties": {"witness": {"const": "V4-EXM-24"}}},
      "else": {"properties": {"witness": {"const": "V4-EXM-25"}}, "not": {"required": ["comparisons"]}}
    },
    {
      "description": "X-R4: no hold value or hold claim in the current phase.",
      "if": {"properties": {"phase_reading": {"const": "current"}}},
      "then": {"properties": {"parts": {"items": {"not": {"anyOf": [{"required": ["hold_support"]}, {"required": ["hold_claim"]}]}}}}}
    }
  ],
  "$defs": {
    "candidates": {
      "type": "object",
      "required": ["app_candidate", "host_candidate", "identification_record"],
      "additionalProperties": false,
      "properties": {
        "app_candidate": {"type": "string", "minLength": 1},
        "host_candidate": {"type": "string", "minLength": 1},
        "identification_record": {"type": "string", "minLength": 1, "description": "The XC-00 result record."},
        "invented_material": {"type": "string", "minLength": 1}
      }
    },
    "double": {
      "type": "object",
      "required": ["double_identity", "specified_in", "files"],
      "additionalProperties": false,
      "properties": {
        "double_identity": {"type": "string", "minLength": 1},
        "specified_in": {"type": "string", "minLength": 1},
        "files": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["path", "sha256"], "additionalProperties": false,
          "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
        "invented_material": {"type": "string", "minLength": 1}
      }
    },
    "definition": {
      "type": "object", "required": ["definition_label"], "additionalProperties": false,
      "properties": {"definition_label": {"type": "string", "minLength": 1}}
    },
    "configuration": {
      "type": "object",
      "required": ["realization_family", "native_path"],
      "additionalProperties": false,
      "properties": {
        "realization_family": {"description": "The family actually used (DEL-03-03 TBD-007 selects nothing here).", "enum": ["mcp_server", "cli", "both_on_double", "not_selected"]},
        "native_path": {"enum": ["N-MCP", "N-CLI", "both", "not_applicable"]},
        "endpoint": {"type": "string", "minLength": 1},
        "host_profile": {"type": "string", "minLength": 1},
        "model_destination": {
          "oneOf": [
            {"type": "object", "required": ["requested", "effective"], "additionalProperties": false,
             "properties": {"requested": {"type": "string"}, "effective": {"type": "string"}}},
            {"type": "object", "required": ["not_observed"], "additionalProperties": false,
             "properties": {"not_observed": {"type": "string", "minLength": 1}}}
          ]
        }
      }
    },
    "part": {
      "type": "object",
      "required": ["part", "expectation", "outcome"],
      "additionalProperties": false,
      "properties": {
        "part": {"type": "string", "minLength": 1},
        "expectation": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["passed", "failed", "blocked", "not_run", "inconclusive"]},
        "chain_elements": {"type": "array", "items": {"type": "string", "pattern": "^J-[1-8]$"}},
        "built_on": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
        "not_run_because": {"type": "string", "minLength": 1},
        "hold_support": {"type": "string"},
        "hold_claim": {"type": "string"}
      },
      "if": {"properties": {"outcome": {"const": "not_run"}}},
      "then": {"required": ["not_run_because"]}
    },
    "observation": {
      "type": "object",
      "required": ["what", "reference"],
      "additionalProperties": false,
      "properties": {
        "what": {"type": "string", "minLength": 1},
        "reference": {
          "type": "object", "required": ["kind", "ref"], "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["host_document", "host_receipt", "dispatch_record", "channel_status", "act_record", "rs_entry", "change_record", "run_output", "compatibility_report"]},
            "ref": {"type": "string", "minLength": 1}
          }
        },
        "linked_not_copied": {"const": true}
      }
    },
    "comparison": {
      "type": "object",
      "required": ["category", "result", "surfaces_observed"],
      "additionalProperties": false,
      "properties": {
        "category": {"type": "string", "pattern": "^CMP-(0[1-9]|1[0-5])$"},
        "result": {"enum": ["same_meaning", "differs", "differs_by_authority_only", "not_exposed", "not_comparable", "not_observed"]},
        "surfaces_observed": {"type": "array", "items": {"enum": ["H", "E", "X"]}, "uniqueItems": true},
        "detail": {"type": "string", "minLength": 1}
      },
      "if": {"properties": {"result": {"enum": ["differs", "not_comparable"]}}},
      "then": {"required": ["detail"]}
    },
    "act_citation": {
      "type": "object",
      "required": ["record_id", "act_kind", "actor", "recorder", "capture_evidence"],
      "additionalProperties": false,
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "act_kind": {"description": "The human-act kinds of RS-v0.8 §6.1 (V18-4 m-3; RP-4): never A1/A2 (operation entries), A3, A8, A9 or A14.", "enum": ["A4", "A5", "A6", "A7", "A10", "A11", "A12", "A13", "A15"]},
        "actor": {"type": "string", "minLength": 1},
        "recorder": {"type": "string", "minLength": 1},
        "record_limits": {"description": "Evidence limits of the act record itself (RS-v0.8 §6.1), e.g. 'identity not verified' for an App-captured act (EXEC CAP-8); not RS R11 labels (RP-4).", "type": "array", "items": {"type": "string", "minLength": 1}},
        "capture_evidence": {
          "oneOf": [
            {"type": "object", "required": ["reference"], "additionalProperties": false, "properties": {"reference": {"type": "string", "minLength": 1}}},
            {"type": "object", "required": ["absent"], "additionalProperties": false, "properties": {"absent": {"type": "string", "minLength": 1}}}
          ]
        }
      }
    },
    "missing_input": {
      "type": "object",
      "required": ["input", "supplier"],
      "additionalProperties": false,
      "properties": {
        "input": {"type": "string", "minLength": 1},
        "supplier": {"type": "string", "minLength": 1},
        "relay_question": {"type": "string", "pattern": "^SQ-[0-9]{2}"}
      }
    }
  }
}
