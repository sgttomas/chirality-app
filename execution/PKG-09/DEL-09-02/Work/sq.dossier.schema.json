{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chirality:app-v4:del-09-02:standalone-dossier:0.2",
  "title": "Standalone qualification dossier (DEL-09-02 SQ-v0.2 §5; OUT-002; PROPOSED)",
  "description": "One dossier per identified App candidate. It indexes the three named scenarios (V4-EXM-10, V4-EXM-11 inside the same run, V4-EXM-12) step by step; each step points to DEL-09-01 EXP result records, to the supplier feature cases it joins and to the stimuli declared before the run (R23-27), never copying them. Step states follow EXP §6.1; outcomes are EXP's (HOSTING §9.3 labels). Kept at DEL-09-02 Evidence/EXP/<candidate key>/SQ-dossier.json (EXP §8.4). Rules beyond the schema: SQ-R1…SQ-R10 in prototype/check_sq.py.",
  "type": "object",
  "required": ["record_kind", "format", "record_id", "support_revision", "case_definition", "candidate", "integration_owner", "examiner", "scenarios", "handoff", "currency", "date"],
  "additionalProperties": false,
  "properties": {
    "record_kind": { "const": "sq_dossier" },
    "format": { "const": "SQ-v0.2" },
    "record_id": { "type": "string", "minLength": 1 },
    "support_revision": { "type": "string", "pattern": "^EXP-v[0-9]+\\.[0-9]+$" },
    "case_definition": {
      "type": "object",
      "required": ["ref", "sha256", "declared_on"],
      "additionalProperties": false,
      "description": "The case definition as bound to its fixtures before the run: steps, stimuli ST-1…ST-5, preconditions (R23-19, R23-27).",
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "declared_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" }
      }
    },
    "examination_opened": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}",
      "description": "When the integration owner opened the examination of this named candidate: from then on every step is planned and gets an EXP record (R23-20)."
    },
    "candidate": {
      "type": "object",
      "required": ["revision", "build_identity", "codex_pin"],
      "additionalProperties": false,
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "build_identity": { "type": "string", "minLength": 1 },
        "codex_pin": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "package_record": { "type": "string", "minLength": 1, "description": "DEL-01-06 package identity record, when the native steps ran on a package." }
      }
    },
    "integration_owner": { "type": "string", "minLength": 1, "description": "App workflow-experience integration owner (CLM-004)." },
    "examiner": {
      "type": "object",
      "required": ["identity", "separation"],
      "additionalProperties": false,
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "separation": { "enum": ["separate_person", "separate_session_no_authoring", "not_separate"] },
        "review_record": { "type": "string", "minLength": 1, "description": "EXP review record (VER-007)." }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    },
    "handoff": {
      "type": "object",
      "required": ["to", "supplies", "not_claimed", "handed_over", "reported_as_independent"],
      "additionalProperties": false,
      "properties": {
        "to": { "const": "DEL-11-03" },
        "supplies": {
          "type": "array",
          "items": { "enum": ["scenario_outcomes", "evidence_limits", "input_gaps", "v3_comparison_inputs", "core_loop_mapping", "affected_rechecks"] }
        },
        "not_claimed": {
          "type": "array",
          "items": { "enum": ["joined_host_witness", "replacement", "public_release", "retirement", "professional_reliance", "practitioner_validation"] },
          "description": "SQ-R5: all six must be listed."
        },
        "handed_over": { "type": "boolean", "description": "Handed to DEL-11-03 as qualification evidence (SQ-R8)." },
        "reported_as_independent": { "type": "boolean", "description": "Reported as independently examined (SQ-R8; EXP §7 RV-2)." }
      }
    },
    "currency": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": { "enum": ["current", "historical", "reopened"] },
        "change_ref": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "state": { "enum": ["historical", "reopened"] } } },
      "then": { "required": ["change_ref"] }
    },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" }
  },
  "$defs": {
    "outcome": { "enum": ["pass", "fail", "blocked", "not-run", "inconclusive"] },
    "scenario": {
      "type": "object",
      "required": ["scenario", "run_ref", "steps"],
      "additionalProperties": false,
      "properties": {
        "scenario": { "enum": ["V4-EXM-10", "V4-EXM-11", "V4-EXM-12"] },
        "run_ref": { "type": "string", "minLength": 1, "description": "The joined run. V4-EXM-11's must equal V4-EXM-10's (SQ-R2)." },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
        "access_modes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "home", "conversation_ref"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["chatgpt_account", "api_key", "local_provider"] },
              "home": { "enum": ["H-acct", "H-key"] },
              "conversation_ref": { "type": "string", "minLength": 1 }
            }
          }
        },
        "outcome": { "$ref": "#/$defs/outcome", "description": "Only once every counted step is recorded (SQ-R4)." }
      },
      "if": { "properties": { "scenario": { "const": "V4-EXM-12" } } },
      "then": { "required": ["access_modes"] }
    },
    "step": {
      "type": "object",
      "required": ["step", "state", "counts", "supplier_cases"],
      "additionalProperties": false,
      "properties": {
        "step": { "type": "string", "pattern": "^(J-[1-9]R?|S11-[1-6]|M12-[1-6])$" },
        "state": {
          "enum": ["designed", "planned", "awaiting_input", "held", "run", "recorded", "reopened"],
          "description": "EXP §6.1 case states. 'held' only for an input held by an unresolved owner matter, never for a held DAG arc."
        },
        "counts": { "type": "boolean", "description": "False for a step added beyond the scenario's own words (SQ §3.1 J-8R, J-9R); it is recorded and never aggregated." },
        "added_reason": { "type": "string", "minLength": 1 },
        "result_record": { "type": "string", "minLength": 1, "description": "EXP result record id." },
        "outcome": { "$ref": "#/$defs/outcome" },
        "missing_input": { "type": "string", "minLength": 1 },
        "stimuli": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "produced"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^ST-[1-9]$" },
              "produced": { "enum": ["native", "replay", "not_produced"] },
              "evidence": { "type": "string", "minLength": 1 },
              "cause": { "type": "string", "minLength": 1 }
            },
            "allOf": [
              { "if": { "properties": { "produced": { "enum": ["native", "replay"] } } }, "then": { "required": ["evidence"] } },
              { "if": { "properties": { "produced": { "const": "not_produced" } } }, "then": { "required": ["cause"] } }
            ]
          }
        },
        "supplier_cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["deliverable", "file", "case_id"],
            "additionalProperties": false,
            "properties": {
              "deliverable": { "type": "string", "pattern": "^DEL-[0-9]{2}-[0-9]{2}$" },
              "file": { "type": "string", "minLength": 1, "description": "The supplier's Design file name: case ids are file-qualified." },
              "case_id": { "type": "string", "minLength": 1 },
              "result_ref": { "type": "string", "minLength": 1 }
            }
          }
        },
        "core_loop_element": { "type": "string", "minLength": 1, "description": "DEL-11-03 REQ-001 element this step bears on." },
        "v3_reference": { "type": "string", "minLength": 1, "description": "App v3 JOURNEY_RESULTS reference for DEL-11-03's comparison; evidence only." }
      },
      "allOf": [
        { "if": { "properties": { "state": { "const": "recorded" } } }, "then": { "required": ["result_record", "outcome"] } },
        { "if": { "properties": { "state": { "not": { "const": "recorded" } } } }, "then": { "not": { "anyOf": [ { "required": ["outcome"] }, { "required": ["result_record"] } ] } } },
        { "if": { "properties": { "state": { "enum": ["awaiting_input", "held"] } } }, "then": { "required": ["missing_input"] } },
        { "if": { "properties": { "counts": { "const": false } } }, "then": { "required": ["added_reason"] } }
      ]
    }
  }
}
