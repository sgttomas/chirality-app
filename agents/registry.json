{
  "schema_version": 1,
  "workflow_catalog": {
    "schema": "chirality-method-index/v1",
    "catalog": "workflows/catalog.yaml",
    "index": "workflows/index.json"
  },
  "roles": {
    "HELP_HUMAN": {
      "description": "Align with the human, preserve continuity, coordinate managers, and return decisions.",
      "instruction": "agents/AGENT_HELP_HUMAN.md",
      "type": 0,
      "direct_entry": true,
      "default_for_new_chat": true,
      "delegates_to": [
        "HELPS_HUMANS",
        "WORKING_ITEMS",
        "TASK"
      ],
      "allow_generalist_agent2": true,
      "tools": [
        "read",
        "delegate_agent",
        "send_agent_update"
      ],
      "write_scope": "none"
    },
    "HELPS_HUMANS": {
      "description": "Design and maintain workflows, tools, agents, and runtime interfaces.",
      "instruction": "agents/AGENT_HELPS_HUMANS.md",
      "type": 1,
      "direct_entry": true,
      "default_for_new_chat": false,
      "delegates_to": [
        "TASK"
      ],
      "allow_generalist_agent2": true,
      "tools": [
        "read",
        "write",
        "bash",
        "delegate_agent",
        "report_coordination_notice",
        "send_agent_update",
        "ack_agent_update"
      ],
      "write_scope": "explicit brief targets within authorized working root"
    },
    "WORKING_ITEMS": {
      "description": "Organize implementation, delegate bounded work, and integrate results.",
      "instruction": "agents/AGENT_WORKING_ITEMS.md",
      "type": 1,
      "direct_entry": true,
      "default_for_new_chat": false,
      "delegates_to": [
        "TASK"
      ],
      "allow_generalist_agent2": true,
      "tools": [
        "read",
        "write",
        "bash",
        "delegate_agent",
        "report_coordination_notice",
        "send_agent_update",
        "ack_agent_update"
      ],
      "write_scope": "explicit brief targets within authorized working root"
    },
    "TASK": {
      "description": "Execute one bounded assignment using a selected method when applicable.",
      "instruction": "agents/AGENT_TASK.md",
      "type": 2,
      "direct_entry": false,
      "default_for_new_chat": false,
      "delegates_to": [],
      "allow_generalist_agent2": false,
      "tools": [
        "read",
        "write",
        "bash",
        "report_coordination_notice",
        "ack_agent_update"
      ],
      "write_scope": "explicit brief targets within authorized working root"
    }
  }
}
