# Environment/local secrets
.env
.env.*
!.env.example
.venv/
venv/
env/

# Domain corpora are maintained in the separate private chirality-domains repo.
/domains/

# Rebuildable local work areas in selected external working repositories.
**/*_pdf2md_work/
**/*_drawing_extract_work/
**/*_drawing_extract_work_run*/
**/*_symbol_instance_diag_work/
**/_LocalIndexes/
**/_Aggregation/_pdf_work/
tools/retrieval/_index/

# Zip archives and office temp files
*.zip
~$*.xlsx
~$*.xls
~$*.xlsm

# Local public export staging outputs
exports/*/staging/
exports/*/staging-*/
exports/*/latest/

# Practitioner harness generated views (rebuildable; D-GOV-01)
_harness_generated/

# SQLite transient WAL sidecars (rebuilt at runtime; not canonical)
*.db-shm
*.db-wal

# taskmgmt scan/federation outputs — derived, rebuildable candidate views (D-GOV-01)
execution/_Coordination/_TaskManagement/.candidates/
projects/*/execution/_Coordination/_TaskManagement/.candidates/
_DomainEngines/*/_TaskManagement/.candidates/
