.DS_Store
**/.DS_Store

# Local/runtime agent state
.claude/
**/.claude/
.chirality/
**/.chirality/
.checkpoints/
**/.checkpoints/

# Archives are historical/local, not canonical repo content
archive/
Archive/
.archive/
.Archive/
**/archive/
**/Archive/
**/.archive/
**/.Archive/
**/_archive/
**/_Archive/

# Python/cache/build artifacts
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/

# JavaScript/frontend dependency and build artifacts
node_modules/
**/node_modules/
.next/
**/.next/
dist/
**/dist/
dist-electron/
**/dist-electron/
build/
**/build/
target/
**/target/
out/
**/out/
*.tsbuildinfo
frontend/artifacts/
**/frontend/artifacts/

# Environment/local secrets
.env
.env.*
!.env.example
.venv/
venv/
env/

# Source corpora: keep costly text/metadata derivatives, ignore raw/recreatable binaries.
domains/*/_Sources/**
!domains/*/_Sources/
!domains/*/_Sources/**/
!domains/*/_Sources/.gitkeep
!domains/*/_Sources/README.md
!domains/*/_Sources/**/*.md
!domains/*/_Sources/**/*.csv
!domains/*/_Sources/**/*.xlsx
!domains/*/_Sources/**/*.json
!domains/*/_Sources/**/*.jsonl
!domains/*/_Sources/**/*.html
!domains/*/_Sources/**/*.txt
domains/*/_Sources/**/*.pdf
domains/*/_Sources/**/*.PDF
domains/*/_Sources/**/*.zip
domains/*/_Sources/**/*.png
domains/*/_Sources/**/*.jpg
domains/*/_Sources/**/*.jpeg
domains/*/_Sources/**/*.tif
domains/*/_Sources/**/*.tiff
domains/*/_Sources/**/*.mht
domains/*/_Sources/**/*.bak
domains/*/_Sources/**/archive/**
domains/*/_Sources/**/Archive/**
domains/*/_Sources/**/.archive/**
domains/*/_Sources/**/.Archive/**
domains/*/_Sources/**/_archive/**
domains/*/_Sources/**/_Archive/**
domains/*/_LocalIndexes/**
!domains/*/_LocalIndexes/
!domains/*/_LocalIndexes/.gitkeep
!domains/*/_LocalIndexes/README.md
**/*_pdf2md_work/
!domains/*/_Sources/**/*_pdf2md_work/
!domains/*/_Sources/**/*_pdf2md_work/**/
**/*_drawing_extract_work/
**/*_drawing_extract_work_run*/
**/*_symbol_instance_diag_work/
**/_LocalIndexes/
!domains/*/_LocalIndexes/
!domains/*/_LocalIndexes/.gitkeep
!domains/*/_LocalIndexes/README.md
**/_Aggregation/_pdf_work/
tools/retrieval/_index/

# Zip archives and office temp files
*.zip
~$*.xlsx
~$*.xls
~$*.xlsm

# Local public export staging outputs
exports/*/staging/
exports/*/staging-*/
exports/*/latest/

# Practitioner harness generated views (rebuildable; D-GOV-01)
_harness_generated/

# SQLite transient WAL sidecars (rebuilt at runtime; not canonical)
*.db-shm
*.db-wal
